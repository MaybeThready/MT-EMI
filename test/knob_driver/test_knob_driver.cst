IO_LOC "status_led[3]" M25;
IO_PORT "status_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[4]" N21;
IO_PORT "status_led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[5]" N23;
