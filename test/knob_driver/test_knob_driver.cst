// Tang Mega 138K Pro, GW5AST-LV138FPG676AC1/I0, version C.
IO_LOC "clk_core" P16;
IO_PORT "clk_core" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "rst_n" K16;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// J23.5 <- encoder PCB J1.7 (Q7), J23.1 -> J1.3 (/PL), J23.3 -> J1.5 (CLK).
IO_LOC "serial_data" W21;
IO_PORT "serial_data" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "load_n" U16;
IO_PORT "load_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "shift_clk" U15;
IO_PORT "shift_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[0]" J14;
IO_PORT "status_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[1]" R26;
IO_PORT "status_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
