/**
 * 单硬核ADC联合回归：24路压力仍刷新，ADCT弯音轮可改变同一按键的音高。
 * 模拟模型只提供电压码和ADC协议，不模拟真实模拟噪声；结束用$stop观察波形。
 */
`timescale 1ns/1ps
module test_pitch_bend_tb;
    reg clk_sys = 1'b0;
    reg rst_n = 1'b0;
    reg [23:0] physical_keys = 24'd0;
    reg [15:0] shift_a = 16'd0, shift_b = 16'd0;
    reg [13:0] pressure_code [0:23];
    reg [13:0] bend_code = 14'd1024;
    wire load_n, key_clk, mux_en_a_n, mux_en_b_n;
    wire [3:0] mux_addr;
    wire i2s_bclk, i2s_lrck, i2s_dout, sd_mode_n;
    wire [5:0] status_led;
    reg regression_passed = 1'b0;
    integer active_channel, i;
    integer pressure_requests = 0, bend_requests = 0;
    integer audio_frames = 0;
    reg [31:0] center_freq;

    test_pitch_bend_core #(
        .MAX_POLYPHONY(1), .ADC_STARTUP_TICKS(128),
        .MUX_SETTLE_TICKS(16), .SHARED_SETTLE_TICKS(16),
        .BEND_SETTLE_TICKS(16), .BEND_DEBOUNCE_TICKS(0),
        .BEND_FILTER_SHIFT(0)
    ) dut_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .data_a(shift_a[15]), .data_b(shift_b[15]),
        .load_n(load_n), .key_clk(key_clk), .mux_addr(mux_addr),
        .mux_en_a_n(mux_en_a_n), .mux_en_b_n(mux_en_b_n),
        .i2s_bclk(i2s_bclk), .i2s_lrck(i2s_lrck), .i2s_dout(i2s_dout),
        .sd_mode_n(sd_mode_n), .status_led(status_led)
    );
    GSR GSR (.GSRI(rst_n));
    always #(1.0e9 / (2.0 * 98304000.0)) clk_sys = ~clk_sys;

    always @(negedge load_n or posedge key_clk)
    begin
        if (!load_n)
        begin
            shift_a = {4'h0, physical_keys[11:0]};
            shift_b = {4'h0, physical_keys[23:12]};
        end
        else
        begin
            shift_a = {shift_a[14:0], 1'b0};
            shift_b = {shift_b[14:0], 1'b0};
        end
    end

    always @(negedge clk_sys)
    begin
        if (!mux_en_a_n && !mux_en_b_n)
            $fatal(1, "Both pressure MUX chips enabled");
        active_channel = !mux_en_a_n ? mux_addr : (!mux_en_b_n ? 16 + mux_addr : -1);
        dut_u.shared_adc_manager_u.keyboard_adc_u.adc_u.channel_id = active_channel;
        dut_u.shared_adc_manager_u.keyboard_adc_u.adc_u.voltage_code =
            (active_channel >= 0 && active_channel < 24) ? pressure_code[active_channel] : 14'd0;
        dut_u.shared_adc_manager_u.keyboard_adc_u.adc_u.bend_voltage_code = bend_code;
        if (rst_n && (dut_u.adc_error || dut_u.bend_error ||
                      dut_u.test_velocity_core_u.fault_r))
            $fatal(1, "Shared ADC or audio pipeline fault");
        if (dut_u.test_velocity_core_u.audio_monitor_valid)
            audio_frames = audio_frames + 1;
    end

    always @(posedge dut_u.shared_adc_manager_u.keyboard_adc_u.adc_u.ADCREQI)
    begin
        if (rst_n)
        begin
            if (dut_u.shared_adc_manager_u.keyboard_adc_u.adc_u.VSENCTL == 3'd0)
                pressure_requests = pressure_requests + 1;
            else if (dut_u.shared_adc_manager_u.keyboard_adc_u.adc_u.VSENCTL == 3'd1)
                bend_requests = bend_requests + 1;
            else
                $fatal(1, "Invalid ADC channel");
        end
    end

    task automatic wait_bend;
        input [15:0] low_limit, high_limit;
        integer n;
        reg matched;
        begin
            matched = 1'b0;
            for (n = 0; n < 2_000_000 && !matched; n = n + 1)
            begin
                @(negedge clk_sys);
                matched = dut_u.bend_value[0] >= low_limit &&
                          dut_u.bend_value[0] <= high_limit && dut_u.bend_valid;
            end
            if (!matched)
                $fatal(1, "Bend did not reach %h..%h, got %h", low_limit,
                       high_limit, dut_u.bend_value[0]);
        end
    endtask

    task automatic wait_frequency;
        input [31:0] low_limit, high_limit;
        integer n;
        reg matched;
        begin
            matched = 1'b0;
            for (n = 0; n < 2_000_000 && !matched; n = n + 1)
            begin
                @(negedge clk_sys);
                matched = dut_u.test_velocity_core_u.note_freq[0] >= low_limit &&
                          dut_u.test_velocity_core_u.note_freq[0] <= high_limit &&
                          dut_u.test_velocity_core_u.note_freq[0] != 0;
            end
            if (!matched)
                $fatal(1, "Frequency did not reach %0d..%0d, got %0d",
                       low_limit, high_limit, dut_u.test_velocity_core_u.note_freq[0]);
        end
    endtask

    task automatic wait_pressure;
        integer n;
        reg matched;
        begin
            matched = 1'b0;
            for (n = 0; n < 2_000_000 && !matched; n = n + 1)
            begin
                @(negedge clk_sys);
                matched = dut_u.test_velocity_core_u.key_velocity[0] > 16'hC000;
            end
            if (!matched)
                $fatal(1, "Pressure key0=%h pressure_req=%0d bend_req=%0d scanner=%0d channel=%0d manager=%0d",
                       dut_u.test_velocity_core_u.key_velocity[0], pressure_requests,
                       bend_requests,
                       dut_u.test_velocity_core_u.keyboard_driver_u.g_pressure.keyboard_pressure_scanner_u.stc,
                       dut_u.test_velocity_core_u.keyboard_driver_u.g_pressure.keyboard_pressure_scanner_u.channel_index_r,
                       dut_u.shared_adc_manager_u.state_r);
        end
    endtask

    initial
    begin
        for (i = 0; i < 24; i = i + 1) pressure_code[i] = 14'd0;
        pressure_code[0] = 14'd1690;
        repeat (16) @(negedge clk_sys);
        rst_n = 1'b1;
        physical_keys[0] = 1'b1;
        $display("PITCH_PROGRESS key pressed t=%0t", $time);
        wait_frequency(32'd1, 32'h7FFFFFFF);
        $display("PITCH_PROGRESS note active t=%0t", $time);
        center_freq = dut_u.test_velocity_core_u.note_freq[0];
        wait_pressure();
        $display("PITCH_PROGRESS pressure active t=%0t", $time);
        if (pressure_requests < 24 || bend_requests < 1)
            $fatal(1, "Both ADC clients must have sampled: pressure=%0d bend=%0d",
                   pressure_requests, bend_requests);
        @(negedge clk_sys); bend_code = 14'd0;
        wait_bend(16'h0000, 16'h0000);
        wait_frequency(center_freq * 87 / 100, center_freq * 92 / 100);
        @(negedge clk_sys); bend_code = 14'd2048;
        wait_bend(16'hFFFF, 16'hFFFF);
        wait_frequency(center_freq * 110 / 100, center_freq * 114 / 100);
        @(negedge clk_sys); bend_code = 14'd1024;
        wait_bend(16'h8000, 16'h8000);
        wait_frequency(center_freq - 8, center_freq + 8);
        if (audio_frames < 20 || pressure_requests < 48 || bend_requests < 6)
            $fatal(1, "Insufficient joint activity");
        regression_passed = 1'b1;
        $display("TEST_PITCH_BEND_PASS pressure=%0d bend=%0d audio=%0d center=%0d",
                 pressure_requests, bend_requests, audio_frames, center_freq);
        $stop;
    end
endmodule
