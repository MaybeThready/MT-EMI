/**
 * UI 联合仿真：真实键盘/旋钮串行扫描、四按键消抖、UI 菜单与音频握手。
 * 保留 12 kHz 扫描间隔；仅缩短仿真的消抖与 Flash 启动等待。
 */
`timescale 1ns/1ps
module test_ui_tb;
    GSR GSR (.GSRI(1'b1));
    reg clk_core = 1'b0;
    always #10 clk_core = ~clk_core;
    reg rst_n = 1'b0;
    reg [3:0] ui_button = 4'd0;
    reg [23:0] keys = 24'd0;
    reg [15:0] board_a = 16'd0, board_b = 16'd0;
    wire load_n, key_clk;
    reg [7:0] knob_a = 8'hff, knob_b = 8'hff;
    reg [7:0] knob_pressed = 8'd0;
    reg [23:0] knob_shift_r = 24'hffffff;
    wire knob_serial_data = knob_shift_r[23];
    wire knob_load_n, knob_shift_clk;
    wire i2s_bclk, i2s_lrck, i2s_dout, sd_mode_n;
    wire [5:0] status_led;
    wire flash_cs_n, flash_clk, flash_mosi, flash_wp_n, flash_hold_n;
    tri1 flash_miso;
    wire lcd_clk, lcd_en, lcd_bl, lcd_hs_n, lcd_vs_n;
    wire [5:0] lcd_r, lcd_g, lcd_b;
    integer combined_count = 0, knob_step_count = 0, audio_count = 0;
    integer display_count = 0;
    integer nonzero_pcm_count = 0;
    reg note_on_seen = 1'b0;
    reg regression_passed = 1'b0;

    test_ui #(
        .KEY_DEBOUNCE_TICKS(0), .BUTTON_DEBOUNCE_CYCLES(8),
        .KNOB_DEBOUNCE_TICKS(8), .FLASH_POWER_UP_CYCLES(10)
    ) dut (
        .clk_core(clk_core), .rst_n(rst_n), .ui_button(ui_button),
        .data_a(board_a[15]), .data_b(board_b[15]),
        .load_n(load_n), .key_clk(key_clk),
        .knob_serial_data(knob_serial_data), .knob_load_n(knob_load_n),
        .knob_shift_clk(knob_shift_clk),
        .i2s_bclk(i2s_bclk), .i2s_lrck(i2s_lrck), .i2s_dout(i2s_dout),
        .sd_mode_n(sd_mode_n), .status_led(status_led),
        .flash_cs_n(flash_cs_n), .flash_clk(flash_clk), .flash_mosi(flash_mosi),
        .flash_miso(flash_miso), .flash_wp_n(flash_wp_n), .flash_hold_n(flash_hold_n),
        .lcd_clk(lcd_clk), .lcd_en(lcd_en), .lcd_r(lcd_r), .lcd_g(lcd_g),
        .lcd_b(lcd_b), .lcd_bl(lcd_bl), .lcd_hs_n(lcd_hs_n), .lcd_vs_n(lcd_vs_n)
    );
    initial force dut.sys_clocker_u.gowin_pll_u.u_pll_init.waitcnt = '1;

    always @(negedge load_n)
    begin
        board_a = {4'd0, keys[11:0]};
        board_b = {4'd0, keys[23:12]};
    end
    always @(posedge key_clk)
    begin
        board_a = {board_a[14:0], 1'b0};
        board_b = {board_b[14:0], 1'b0};
    end
    always @(negedge knob_load_n)
        knob_shift_r = {knob_a, knob_b, ~knob_pressed};
    always @(posedge knob_shift_clk)
        knob_shift_r = {knob_shift_r[22:0], 1'b1};

    always @(posedge dut.clk_sys)
    begin
        if (dut.rst_sys_n)
        begin
            if (dut.combined_fire)
            begin
                combined_count = combined_count + 1;
                if (dut.knob_steps_r[1]) knob_step_count = knob_step_count + 1;
            end
            if (dut.sample_fire) audio_count = audio_count + 1;
            if (dut.ui_display_valid && dut.ui_display_ready)
                display_count = display_count + 1;
            if (dut.ui_out_valid && dut.ui_audio_ready && (|dut.note_on))
                note_on_seen = 1'b1;
            if (dut.played_pcm_valid && dut.played_pcm_ready && dut.played_pcm != 16'sd0)
                nonzero_pcm_count = nonzero_pcm_count + 1;
            if (dut.configuration_error || dut.sample_overrun || dut.knob_overflow ||
                dut.knob_scan_error || dut.lcd_protocol_error || dut.lcd_configuration_error)
                $fatal(1, "test_ui fault ui=%b overrun=%b knob_overflow=%b scan=%b lcd_protocol=%b lcd_config=%b parts=%b%b%b word=%b/%d/%h valid=%b",
                    dut.configuration_error, dut.sample_overrun, dut.knob_overflow,
                    dut.knob_scan_error, dut.lcd_protocol_error, dut.lcd_configuration_error,
                    dut.lcd_display_u.ui_error, dut.lcd_display_u.draw_error,
                    dut.lcd_display_u.address_error,
                    dut.lcd_display_u.word_kind, dut.lcd_display_u.word_addr,
                    dut.lcd_display_u.word_data, dut.lcd_display_u.lcd_driver_u.lcd_scene_u.valid_word);
        end
    end

    task wait_scan;
        input integer count;
        integer n;
        begin
            for (n = 0; n < count; n = n + 1)
                @(negedge dut.scan_tick_up);
        end
    endtask
    task set_k2_ab;
        input [1:0] ab;
        begin
            knob_a[1] = ab[1];
            knob_b[1] = ab[0];
            wait_scan(3);
        end
    endtask

    initial
    begin
        repeat (6) @(negedge clk_core);
        rst_n = 1'b1;
        wait (dut.rst_sys_n);
        wait (combined_count >= 4);
        if (dut.menu_page !== 3'd0 || display_count == 0)
            $fatal(1, "UI did not start in PLAY");

        keys[9] = 1'b1;
        wait_scan(8);
        if (audio_count == 0 || !note_on_seen || nonzero_pcm_count == 0)
            $fatal(1, "Keyboard note/audio path incomplete");

        ui_button[0] = 1'b1; // B1: open main menu
        wait (dut.menu_page == 3'd1);
        ui_button[0] = 1'b0;
        wait_scan(3);
        if (dut.menu_page != 3'd1) $fatal(1, "B1 menu did not hold");
        ui_button[2] = 1'b1; // B3: next menu item
        wait (dut.menu_selection == 2'd1);
        ui_button[2] = 1'b0;
        wait_scan(3);
        ui_button[1] = 1'b1; // B2: previous menu item
        wait (dut.menu_selection == 2'd0);
        ui_button[1] = 1'b0;
        wait_scan(3);
        ui_button[3] = 1'b1; // B4: return to PLAY
        wait (dut.menu_page == 3'd0);
        ui_button[3] = 1'b0;
        wait_scan(3);

        // K2 正向一步：11 -> 10 -> 00 -> 01 -> 11，插值应由默认 0 增加。
        set_k2_ab(2'b10);
        set_k2_ab(2'b00);
        set_k2_ab(2'b01);
        set_k2_ab(2'b11);
        wait (knob_step_count >= 1);
        wait_scan(3);
        if (dut.wavetable_interp[0] !== 16'd1638)
            $fatal(1, "K2 interpolation expected 5 percent, got %0d", dut.wavetable_interp[0]);
        if (combined_count < 10 || audio_count < 10)
            $fatal(1, "Incomplete combined/audio handshakes");
        regression_passed = 1'b1;
        $display("TEST_UI_PASS frames=%0d knob_steps=%0d audio=%0d pcm=%0d interp=%0d",
                 combined_count, knob_step_count, audio_count, nonzero_pcm_count,
                 dut.wavetable_interp[0]);
        $stop;
    end

    initial
    begin
        #15_000_000;
        $fatal(1, "test_ui timeout frames=%0d menu=%0d steps=%0d audio=%0d",
               combined_count, dut.menu_page, knob_step_count, audio_count);
    end
endmodule
