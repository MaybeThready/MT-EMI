/**
 * 联合测试24键/24路FSR映射、32声部分配、按住调压不重触发、5%下限和松开事件。
 * 使用真实UI/机架，除法器默认采用与厂商网表逐拍核对的IP行为模型，可切换网表。
 * 核对I2S实际串行数据，全部正确应打印PASS。
 * ADC协议模型不模拟模拟精度；只缩短ADC启动/4067稳定等待，不修改正式顶层默认参数。
 */
`timescale 1ns/1ps
module test_velocity_tb();
    reg clk_sys = 1'b0;
    reg rst_n = 1'b0;
    reg [23:0] physical_keys = 24'd0;
    reg [15:0] shift_a = 16'd0, shift_b = 16'd0;
    reg [13:0] codes [0:23];
    wire load_n, key_clk, mux_en_a_n, mux_en_b_n;
    wire [3:0] mux_addr;
    wire i2s_bclk, i2s_lrck, i2s_dout, sd_mode_n;
    wire [5:0] status_led;
    reg regression_passed = 1'b0;
    integer phase = 0;
    integer sample_count = 0, keyboard_frames = 0, nonzero_samples = 0;
    integer on_count [0:23], off_count [0:23], channel_requests [0:23];
    integer voice_owner [0:31];
    reg [15:0] release_velocity [0:31];
    reg [31:0] expected_frequency [0:23];
    integer i, v, key_id, active_channel, total_on, total_off;
    real hz;

    test_velocity_core #(
        .MUX_SETTLE_TICKS(16), .ADC_STARTUP_TICKS(128)
    ) dut_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .data_a(shift_a[15]), .data_b(shift_b[15]),
        .load_n(load_n), .key_clk(key_clk), .mux_addr(mux_addr),
        .mux_en_a_n(mux_en_a_n), .mux_en_b_n(mux_en_b_n),
        .i2s_bclk(i2s_bclk), .i2s_lrck(i2s_lrck), .i2s_dout(i2s_dout),
        .sd_mode_n(sd_mode_n), .status_led(status_led)
    );
    // 厂商原语通过固定的GSR实例名查找全局复位。
    GSR GSR (.GSRI(rst_n));
    always #(1.0e9 / (2.0 * 98304000.0)) clk_sys = ~clk_sys;

    // 每块16位链的前4位无效，随后为K12..K1；触摸高有效。
    always @(negedge load_n or posedge key_clk)
    begin
        if (!load_n)
        begin
            shift_a = {4'hA, physical_keys[11:0]};
            shift_b = {4'h5, physical_keys[23:12]};
        end
        else
        begin
            shift_a = {shift_a[14:0], 1'b0};
            shift_b = {shift_b[14:0], 1'b0};
        end
    end

    // 只驱动外部模拟模型，不强制被测RTL内部信号。
    always @(negedge clk_sys)
    begin
        if (!mux_en_a_n && !mux_en_b_n)
            $fatal(1, "Both 4067 chips enabled");
        active_channel = -1;
        if (!mux_en_a_n)
            active_channel = mux_addr;
        else if (!mux_en_b_n)
        begin
            if (mux_addr >= 8) $fatal(1, "Second 4067 used an unconnected channel");
            active_channel = 16 + mux_addr;
        end
        dut_u.keyboard_driver_u.g_pressure.keyboard_pressure_scanner_u.keyboard_adc_u.adc_u.channel_id = active_channel;
        dut_u.keyboard_driver_u.g_pressure.keyboard_pressure_scanner_u.keyboard_adc_u.adc_u.voltage_code =
            (active_channel >= 0) ? codes[active_channel] : 14'd0;
    end
    always @(posedge dut_u.keyboard_driver_u.g_pressure.keyboard_pressure_scanner_u.keyboard_adc_u.adc_u.ADCREQI)
    begin
        if (rst_n)
        begin
            if (active_channel < 0) $fatal(1, "ADC requested while both multiplexers were disabled");
            channel_requests[active_channel] = channel_requests[active_channel] + 1;
        end
    end

    function [15:0] pressure_reference;
        input integer code;
        begin
            if (code <= 8) pressure_reference = 16'd0;
            else if (code >= 1690) pressure_reference = 16'hFFFF;
            else pressure_reference = ((code - 8) * 65535 + 841) / 1682;
        end
    endfunction
    function integer frequency_key;
        input [31:0] frequency;
        integer k;
        begin
            frequency_key = -1;
            for (k = 0; k < 24; k = k + 1)
                if (frequency >= expected_frequency[k] - 4 && frequency <= expected_frequency[k] + 4)
                    frequency_key = k;
        end
    endfunction
    task automatic wait_velocity;
        input integer key;
        input integer target;
        integer start_sample, lane, distance;
        reg matched;
        begin
            start_sample = sample_count;
            matched = 1'b0;
            while (!matched)
            begin
                @(negedge clk_sys);
                for (lane = 0; lane < 32; lane = lane + 1)
                begin
                    distance = $signed({1'b0, dut_u.note_velocity[lane]}) - target;
                    if (voice_owner[lane] == key && distance >= -2 && distance <= 2)
                        matched = 1'b1;
                end
                if (sample_count - start_sample > 1000)
                    $fatal(1, "Pressure did not reach voice: key=%0d target=%0d phase=%0d", key, target, phase);
            end
        end
    endtask
    task automatic wait_events;
        input integer expected_on;
        input integer expected_off;
        integer start_sample, k;
        begin
            start_sample = sample_count;
            total_on = -1;
            total_off = -1;
            while (total_on != expected_on || total_off != expected_off)
            begin
                @(negedge clk_sys);
                total_on = 0;
                total_off = 0;
                for (k = 0; k < 24; k = k + 1)
                begin
                    total_on = total_on + on_count[k];
                    total_off = total_off + off_count[k];
                end
                if (sample_count - start_sample > 1000)
                    $fatal(1, "Touch event count mismatch on=%0d off=%0d phase=%0d", total_on, total_off, phase);
            end
        end
    endtask

    always @(posedge clk_sys)
    begin
        if (rst_n)
        begin
            if (dut_u.smp_tick_up) sample_count = sample_count + 1;
            if (dut_u.keyboard_valid && dut_u.ui_in_ready) keyboard_frames = keyboard_frames + 1;
            if (dut_u.fault_r)
                $fatal(1, "Integration fault adc=%b fifo=%b ui=%b overrun=%b underrun=%b", dut_u.adc_error,
                    dut_u.event_overflow, dut_u.configuration_error, dut_u.sample_overrun, dut_u.underrun_r);
            if (dut_u.ui_out_valid && dut_u.rack_in_ready)
            begin
                for (v = 0; v < 32; v = v + 1)
                begin
                    if (dut_u.note_on[v])
                    begin
                        key_id = frequency_key(dut_u.note_freq[v]);
                        if (key_id < 0) $fatal(1, "Key produced an incorrect note frequency");
                        voice_owner[v] = key_id;
                        on_count[key_id] = on_count[key_id] + 1;
                        if (on_count[key_id] > 1) $fatal(1, "Held key retriggered on pressure update");
                    end
                    if (dut_u.note_off[v])
                    begin
                        if (voice_owner[v] < 0) $fatal(1, "Release without a voice owner");
                        off_count[voice_owner[v]] = off_count[voice_owner[v]] + 1;
                    end
                end
            end
        end
    end

    // 独立按BCLK上升沿接收，LRCK延迟一位决定当前位所属声道。
    reg previous_lrck = 1'b1;
    reg [15:0] left_word = 16'd0, right_word = 16'd0, expected_pcm = 16'd0;
    integer left_bits = 0, right_bits = 0, decoded_left = 0, decoded_right = 0;
    always @(negedge clk_sys)
    begin
        if (rst_n && dut_u.audio_monitor_valid)
        begin
            expected_pcm = dut_u.audio_monitor;
            if (phase == 0 && expected_pcm !== 16'd0)
                $fatal(1, "FSR pressure triggered sound without touch");
            if (expected_pcm != 16'd0) nonzero_samples = nonzero_samples + 1;
        end
    end
    always @(posedge i2s_bclk or negedge rst_n)
    begin
        if (!rst_n)
        begin
            previous_lrck = 1'b1;
            left_bits = 0;
            right_bits = 0;
            left_word = 16'd0;
            right_word = 16'd0;
        end
        else
        begin
            if (!previous_lrck)
            begin
                left_word = {left_word[14:0], i2s_dout};
                left_bits = left_bits + 1;
                if (left_bits == 16)
                begin
                    if (left_word !== expected_pcm) $fatal(1, "I2S left word differs from actual PCM");
                    decoded_left = decoded_left + 1;
                    left_bits = 0;
                end
            end
            else
            begin
                right_word = {right_word[14:0], i2s_dout};
                right_bits = right_bits + 1;
                if (right_bits == 16)
                begin
                    if (right_word !== 16'd0) $fatal(1, "I2S right channel is not silent");
                    decoded_right = decoded_right + 1;
                    right_bits = 0;
                end
            end
            previous_lrck = i2s_lrck;
        end
    end

    initial
    begin
        for (i = 0; i < 24; i = i + 1)
        begin
            codes[i] = 136 + i * 60;
            on_count[i] = 0;
            off_count[i] = 0;
            channel_requests[i] = 0;
            hz = 440.0 * (2.0 ** ((i - 9) / 12.0));
            expected_frequency[i] = $rtoi(hz * 65536.0 + 0.5);
        end
        for (i = 0; i < 32; i = i + 1) voice_owner[i] = -1;
        repeat (16) @(negedge clk_sys);
        rst_n = 1'b1;
        $display("INFO: velocity regression started with real 32-voice audio RTL");
        wait (dut_u.keyboard_driver_u.pressure_frame_complete_r);
        repeat (8) @(negedge clk_sys);
        for (i = 0; i < 24; i = i + 1)
        begin
            if (channel_requests[i] < 2) $fatal(1, "An FSR channel was skipped");
            if (dut_u.keyboard_driver_u.latest_velocity_r[i] !== pressure_reference(codes[i]))
                $fatal(1, "FSR-to-key mapping differs at key %0d", i);
        end
        wait_events(0, 0);
        $display("PASS: all 24 FSR channels mapped; pressure alone is silent");

        phase = 1;
        physical_keys = 24'hFFFFFF;
        wait_events(24, 0);
        for (i = 0; i < 24; i = i + 1)
            wait_velocity(i, pressure_reference(codes[i]));
        $display("PASS: all 24 touch keys produce their own note and pressure volume");

        phase = 2;
        codes[15] = 14'd1690;
        codes[16] = 14'd428;
        wait_velocity(15, 65535);
        wait_velocity(16, pressure_reference(428));
        for (i = 0; i < 24; i = i + 1)
            wait_velocity(i, pressure_reference(codes[i]));
        wait_events(24, 0);
        phase = 3;
        codes[16] = 14'd0;
        wait_velocity(16, 3277);
        wait_velocity(15, 65535);
        $display("PASS: key15/16 boundary (FSR16/17), held-note changes and UI 5%% floor");

        phase = 4;
        for (i = 0; i < 32; i = i + 1) release_velocity[i] = dut_u.note_velocity[i];
        physical_keys = 24'd0;
        wait_events(24, 24);
        repeat (50000) @(negedge clk_sys);
        if (dut_u.key_states !== 24'd0 || dut_u.note_busy == 0)
            $fatal(1, "Touch release did not retain the normal ADSR tail");
        for (i = 0; i < 32; i = i + 1)
            if (voice_owner[i] >= 0 && dut_u.note_velocity[i] !== release_velocity[i])
                $fatal(1, "Release did not freeze the last pressure volume");
        if (nonzero_samples == 0 || decoded_left < 100 || decoded_right < 100)
            $fatal(1, "Real audio/I2S chain did not produce enough output");
        rst_n = 1'b0;
        repeat (16) @(negedge clk_sys);
        if (status_led[5:1] !== 5'b11111) $fatal(1, "Reset did not clear diagnostics");
        regression_passed = 1'b1;
        $display("PASS: test_velocity_tb %0d keyboard frames, %0d PCM frames, %0d/%0d I2S words",
            keyboard_frames, sample_count, decoded_left, decoded_right);
        $stop;
    end
    initial
    begin
        #100_000_000;
        $fatal(1, "test_velocity_tb watchdog phase=%0d", phase);
    end
    initial
    begin
        forever
        begin
            #1_000_000;
            $display("INFO: time=%0t phase=%0d PCM=%0d keyboard=%0d", $time, phase, sample_count, keyboard_frames);
        end
    end
endmodule
