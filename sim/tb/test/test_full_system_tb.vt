/**
 * 整机联合自检：真实24键/8旋钮串行输入、按钮、4067/共享ADC、32声部、mixer、I2S与LCD。
 * 应得到24路压力一一对应、连续弯音不重触发、旋钮/菜单/音效与Flash存取正常、LCD波形和FFT有效。
 * 保留2048周期音频tick、真实ADC协议；仅缩短去抖/模拟等待和LCD扫描视口，800x480绘图资源不变。
 * 不强制DUT业务寄存器；模拟电压码送入ADC协议模型，Flash通过引脚级模型连接。
 */
`timescale 1ns/1ps
module test_full_system_tb;
    parameter VOICE_COUNT=32;
    GSR GSR(.GSRI(1'b1));
    reg clk_sys=0, rst_n=0;
    always #(1.0e9/(2.0*98304000.0)) clk_sys=~clk_sys;
    reg [3:0] ui_button=0;
    reg [23:0] keys=0;
    reg [15:0] board_a=0,board_b=0;
    reg [7:0] knob_a=8'hff,knob_b=8'hff,knob_pressed=0;
    reg [23:0] knob_shift=24'hffffff;
    wire knob_load_n,knob_shift_clk;
    wire load_n,key_clk,i2s_bclk,i2s_lrck,i2s_dout,sd_mode_n;
    wire [3:0] mux_addr;
    wire mux_en_a_n,mux_en_b_n;
    wire flash_cs_n,flash_clk,flash_mosi,flash_wp_n,flash_hold_n;
    tri1 flash_miso;
    wire [5:0] status_led;
    wire lcd_clk,lcd_en,lcd_bl,lcd_hs_n,lcd_vs_n;
    wire [5:0] lcd_r,lcd_g,lcd_b;
    reg test_passed=0;
    integer updates=0,commits=0,pcm_count=0,nonzero_pcm=0,backpressured_cycles=0,pcm_while_waiting=0;
    integer last_on=0,last_off=0,paired_events=0,visible_pixels=0,cycle_count=0,last_tick=0;
    integer on_count=0,off_count=0,pressure_requests=0,bend_requests=0,pressure_frames=0;
    integer i,t,channel,reference_velocity,expected_freq;
    integer pressure_mask=0;
    reg [544:0] last_display=0,last_render=0;
    reg [31:0] front_config;
    reg [13:0] pressure_code[0:23];
    reg [13:0] bend_code=1024;
    reg [31:0] saved_frequency;
    reg [15:0] saved_velocity,neighbor_velocity;
    integer previous_on,previous_off;
    test_full_system_core #(
        .MAX_POLYPHONY(VOICE_COUNT),
        .KEY_DEBOUNCE_TICKS(0),.BUTTON_DEBOUNCE_CYCLES(8),.KNOB_DEBOUNCE_TICKS(8),
        .FLASH_HALF_PERIOD_CYCLES(4),.FLASH_POWER_UP_CYCLES(10),
        .ADC_STARTUP_TICKS(128),.MUX_SETTLE_TICKS(16),.SHARED_SETTLE_TICKS(16),
        .BEND_SETTLE_TICKS(16),.BEND_FILTER_SHIFT(0)
    ) dut (
        .clk_sys(clk_sys),.rst_n(rst_n),.ui_button(ui_button),
        .data_a(board_a[15]),.data_b(board_b[15]),.load_n(load_n),.key_clk(key_clk),
        .mux_addr(mux_addr),.mux_en_a_n(mux_en_a_n),.mux_en_b_n(mux_en_b_n),
        .knob_serial_data(knob_shift[23]),.knob_load_n(knob_load_n),.knob_shift_clk(knob_shift_clk),
        .i2s_bclk(i2s_bclk),.i2s_lrck(i2s_lrck),.i2s_dout(i2s_dout),.sd_mode_n(sd_mode_n),
        .status_led(status_led),.flash_cs_n(flash_cs_n),.flash_clk(flash_clk),.flash_mosi(flash_mosi),
        .flash_miso(flash_miso),.flash_wp_n(flash_wp_n),.flash_hold_n(flash_hold_n),
        .lcd_clk(lcd_clk),.lcd_en(lcd_en),.lcd_r(lcd_r),.lcd_g(lcd_g),.lcd_b(lcd_b),
        .lcd_bl(lcd_bl),.lcd_hs_n(lcd_hs_n),.lcd_vs_n(lcd_vs_n)
    );
    spi_nor_model flash_u(.clk_sys(clk_sys),.cs_n(flash_cs_n),.sck(flash_clk),.mosi(flash_mosi),.miso(flash_miso));
    defparam dut.lcd_display_u.lcd_driver_u.H_ACTIVE=65;
    defparam dut.lcd_display_u.lcd_driver_u.V_ACTIVE=33;
    defparam dut.lcd_display_u.lcd_driver_u.H_BACK=3;
    defparam dut.lcd_display_u.lcd_driver_u.H_FRONT=5;
    defparam dut.lcd_display_u.lcd_driver_u.V_BACK=2;
    defparam dut.lcd_display_u.lcd_driver_u.V_FRONT=3;
    defparam dut.lcd_display_u.lcd_driver_u.lcd_scene_u.H_ACTIVE=800;
    defparam dut.lcd_display_u.lcd_driver_u.lcd_scene_u.V_ACTIVE=480;
    always @(negedge load_n) begin board_a={4'ha,keys[11:0]};board_b={4'h5,keys[23:12]};end
    always @(posedge key_clk) begin board_a={board_a[14:0],1'b0};board_b={board_b[14:0],1'b0};end
    always @(negedge knob_load_n) knob_shift={knob_a,knob_b,~knob_pressed};
    always @(posedge knob_shift_clk) knob_shift={knob_shift[22:0],1'b1};
    always @(negedge clk_sys)
    begin
        if(rst_n && !mux_en_a_n && !mux_en_b_n) $fatal(1,"two MUX chips active");
        channel=!mux_en_a_n ? mux_addr : (!mux_en_b_n ? 16+mux_addr : -1);
        dut.shared_adc_manager_u.keyboard_adc_u.adc_u.channel_id=channel;
        dut.shared_adc_manager_u.keyboard_adc_u.adc_u.voltage_code=
            (channel>=0 && channel<24)?pressure_code[channel]:14'd0;
        dut.shared_adc_manager_u.keyboard_adc_u.adc_u.bend_voltage_code=bend_code;
    end
    always @(posedge clk_sys)
    begin
        if(rst_n)
        begin
            if(dut.pressure_req_valid && dut.pressure_req_ready)
            begin
                pressure_requests=pressure_requests+1;
                if(channel<0 || channel>23) $fatal(1,"invalid pressure channel");
                pressure_mask=pressure_mask | (1<<channel);
            end
            if(dut.bend_req_valid && dut.bend_req_ready) bend_requests=bend_requests+1;
            if(dut.keyboard_driver_u.pressure_frame_done) pressure_frames=pressure_frames+1;
            if(dut.ui_out_valid && dut.ui_audio_ready)
            begin
                on_count=on_count+$countones(dut.note_on);
                off_count=off_count+$countones(dut.note_off);
            end
        end
    end
    always @(posedge lcd_clk)
    begin
        if(rst_n && lcd_en && {lcd_r,lcd_g,lcd_b}!=0) visible_pixels=visible_pixels+1;
    end
    always @(posedge clk_sys)
    begin
        if(rst_n)
        begin
            cycle_count=cycle_count+1;
            if(dut.smp_tick_up)
            begin
                if(last_tick && cycle_count-last_tick!=2048) $fatal(1,"real sample tick period changed");
                last_tick=cycle_count;
            end
            if(dut.configuration_error || dut.sample_overrun || dut.underrun_r || dut.lcd_protocol_error || dut.lcd_configuration_error || dut.shared_adc_error || dut.bend_error || dut.keyboard_adc_error || dut.keyboard_overflow || dut.knob_overflow || dut.knob_scan_error)
                $fatal(1,"system fault UI=%b overrun=%b underrun=%b LCD=%b/%b parts=%b%b%b ADC=%b bend=%b key=%b/%b knob=%b/%b",
                    dut.configuration_error,dut.sample_overrun,dut.underrun_r,dut.lcd_protocol_error,dut.lcd_configuration_error,
                    dut.lcd_display_u.ui_error,dut.lcd_display_u.draw_error,dut.lcd_display_u.address_error,
                    dut.shared_adc_error,dut.bend_error,dut.keyboard_adc_error,dut.keyboard_overflow,dut.knob_overflow,dut.knob_scan_error);
            if(dut.preset_storage_driver_u.fault_r)
                $fatal(1,"Flash startup fault status=%0d",dut.preset_storage_driver_u.fault_status_r);
            if(!dut.played_pcm_ready) $fatal(1,"LCD backpressured I2S played PCM");
            if(dut.ui_display_valid && dut.ui_display_ready)
            begin
                updates=updates+1;last_display=dut.ui_display_state;
            end
            if(dut.ui_out_valid && dut.ui_audio_ready)
            begin
                if(|dut.note_on) last_on=$countones(dut.note_on);
                if(|dut.note_off) last_off=$countones(dut.note_off);
                if((dut.note_on & dut.note_off)!=0) $fatal(1,"same voice has on and off");
                if($countones(dut.note_on)==3 && $countones(dut.note_off)==3) paired_events=paired_events+1;
            end
            if(dut.lcd_display_u.present_valid && !dut.lcd_display_u.present_ready)
                backpressured_cycles=backpressured_cycles+1;
            if(dut.played_pcm_valid && dut.played_pcm_ready)
            begin
                pcm_count=pcm_count+1;
                if((pcm_count%256)==0) $display("FULL_PROGRESS PCM=%0d FlashCatalog=%0d",pcm_count,dut.storage_catalog_valid);
                if(dut.played_pcm!=0) nonzero_pcm=nonzero_pcm+1;
                if(dut.lcd_display_u.present_valid && !dut.lcd_display_u.present_ready) pcm_while_waiting=pcm_while_waiting+1;
            end
            if(dut.lcd_display_u.render_done)
            begin
                commits=commits+1;last_render=dut.lcd_display_u.scene_state;
                front_config=dut.lcd_display_u.lcd_driver_u.lcd_scene_u.front_bank_r ?
                    dut.lcd_display_u.lcd_driver_u.lcd_scene_u.config_r[1] : dut.lcd_display_u.lcd_driver_u.lcd_scene_u.config_r[0];
                if(front_config[2:0]!==last_render[422:420] || front_config[24]!==last_render[510])
                    $fatal(1,"committed LCD identity differs from frozen snapshot");
                if(front_config[24] && front_config[5:4]!=={1'b0,last_render[511]})
                    $fatal(1,"committed candidate mismatch");
            end
        end
        else last_tick=0;
    end

    // Independent mixer-accept queue -> tick-selected PCM -> LCD mirror -> I2S pins.
    reg [15:0] accepted[0:32767],played[0:32767],expected_played[0:32767];
    integer accepted_count=0,consumed_count=0,frame_count=0,mirror_count=0;
    integer decoded_left=0,decoded_right=0,decoder_bits=0;
    reg decoder_started=0,decoder_channel=1;
    reg [15:0] decoded_word=0;
    always @(posedge clk_sys)
    begin
        if(!rst_n)
        begin accepted_count=0;consumed_count=0;frame_count=0;mirror_count=0;end
        else
        begin
            if(dut.mixer_out_valid && dut.i2s_ready)
            begin accepted[accepted_count]=dut.mixer_audio;accepted_count=accepted_count+1;end
            if(dut.smp_tick_up)
            begin
                if(consumed_count<accepted_count)
                begin expected_played[frame_count]=accepted[consumed_count];consumed_count=consumed_count+1;end
                else expected_played[frame_count]=0;
                frame_count=frame_count+1;
            end
            if(dut.played_pcm_valid && dut.played_pcm_ready)
            begin
                if(mirror_count>=frame_count || dut.played_pcm!==expected_played[mirror_count])
                    $fatal(1,"played PCM differs from mixer queue");
                played[mirror_count]=dut.played_pcm;mirror_count=mirror_count+1;
            end
        end
    end
    always @(negedge rst_n)
    begin decoder_started=0;decoder_channel=1;decoder_bits=0;decoded_word=0;decoded_left=0;decoded_right=0;end
    always @(posedge i2s_bclk)
    begin
        if(rst_n)
        begin
            if(!decoder_started)
            begin
                if(!i2s_lrck) begin decoder_started=1;decoder_channel=0;decoder_bits=0;decoded_word=0;end
            end
            else
            begin
                decoded_word={decoded_word[14:0],i2s_dout};
                if(decoder_bits==15)
                begin
                    if(i2s_lrck===decoder_channel) $fatal(1,"I2S LRCK phase");
                    if(!decoder_channel)
                    begin
                        if(decoded_left>=mirror_count || decoded_word!==played[decoded_left]) $fatal(1,"I2S pin PCM mismatch");
                        decoded_left=decoded_left+1;
                    end
                    else
                    begin if(decoded_word!=0) $fatal(1,"I2S right channel not silent");decoded_right=decoded_right+1;end
                    decoder_channel=i2s_lrck;decoder_bits=0;decoded_word=0;
                end
                else
                begin
                    if(i2s_lrck!==decoder_channel) $fatal(1,"early I2S LRCK");
                    decoder_bits=decoder_bits+1;
                end
            end
        end
    end

    task settle;
        begin repeat(20000) @(negedge clk_sys);end
    endtask
    task scans;
        input integer count;
        begin repeat(count) @(negedge dut.scan_tick_up);end
    endtask
    task press;
        input integer n;
        begin ui_button=4'b1<<n;scans(4);ui_button=0;scans(4);end
    endtask
    task knob_ab;
        input integer n;
        input [1:0] ab;
        begin knob_a[n]=ab[1];knob_b[n]=ab[0];scans(3);end
    endtask
    task turn;
        input integer n;
        input increase;
        begin
            knob_ab(n,increase?2'b10:2'b01);knob_ab(n,2'b00);
            knob_ab(n,increase?2'b01:2'b10);knob_ab(n,2'b11);scans(2);
        end
    endtask
    task push_knob;
        input integer n;
        begin knob_pressed[n]=1;scans(4);knob_pressed[n]=0;scans(4);end
    endtask
    task check_state;
        input [2:0] page;
        input active,mode;
        input integer candidate;
        begin
            t=0;
            while((last_display[422:420]!==page || last_display[510]!==active || last_display[509]!==mode ||
                   last_render[422:420]!==page || last_render[510]!==active || last_render[509]!==mode ||
                   (candidate>=0 && (last_display[511]!==candidate[0] || last_render[511]!==candidate[0]))) && t<150000)
            begin @(negedge clk_sys);t=t+1;end
            if(t==150000) $fatal(1,"LCD state page=%0d submenu=%0d mode=%0d",page,active,mode);
        end
    endtask
    task wait_bend;
        input [15:0] position;
        begin
            t=0;
            while(dut.bend_frame[0]!==position && t<1500000) begin @(negedge clk_sys);t=t+1;end
            if(t==1500000) $fatal(1,"bend timeout wanted=%h got=%h",position,dut.bend_frame[0]);
            settle;
        end
    endtask
    task operation;
        begin
            press(0); // slot -> confirm
            if(dut.menu_page!=3) $fatal(1,"missing confirm page got=%0d selection=%0d",dut.menu_page,dut.menu_selection);
            press(0); // execute
            t=0;
            while(dut.menu_page!=5 && t<1500000) begin @(negedge clk_sys);t=t+1;end
            if(t==1500000 || dut.menu_result_status!=0)
                $fatal(1,"preset operation failed page=%0d result=%h",dut.menu_page,dut.menu_result_status);
        end
    endtask
    initial
    begin
        for(i=0;i<24;i=i+1) pressure_code[i]=200+50*i;
        repeat(16) @(negedge clk_sys);rst_n=1;settle;
        check_state(0,0,0,-1);
        wait(pressure_frames>=2);
        keys=24'hffffff;
        scans(12);
        if(on_count!=24) $fatal(1,"24 keys must trigger exactly once got=%0d",on_count);
        for(i=0;i<24;i=i+1)
        begin
            reference_velocity=((pressure_code[i]-8)*65535+841)/1682;
            if(dut.key_velocity[i]<reference_velocity-3 || dut.key_velocity[i]>reference_velocity+3)
                $fatal(1,"FSR key%0d mismatch got=%0d want=%0d",i+1,dut.key_velocity[i],reference_velocity);
            if(dut.note_velocity[i]<reference_velocity-3 || dut.note_velocity[i]>reference_velocity+3)
                $fatal(1,"key/voice velocity mapping failed key%0d",i+1);
            expected_freq=$rtoi(440.0*(2.0**((i-9)/12.0))*65536.0+0.5);
            if(dut.note_freq[i]!=expected_freq) $fatal(1,"normal frequency key%0d",i+1);
        end
        $display("FULL_PRESSURE_24_PASS requests=%0d frames=%0d",pressure_requests,pressure_frames);
        saved_velocity=dut.note_velocity[1];neighbor_velocity=dut.note_velocity[0];
        previous_on=on_count;previous_off=off_count;
        pressure_code[1]=1690;
        t=0;
        while(dut.note_velocity[1]<65000 && t<2500000) begin @(negedge clk_sys);t=t+1;end
        if(t==2500000 || dut.note_velocity[0]!=neighbor_velocity) $fatal(1,"FSR2 response or FSR1 isolation");
        pressure_code[1]=0;
        t=0;
        while(dut.note_velocity[1]!=3277 && t<2500000) begin @(negedge clk_sys);t=t+1;end
        if(t==2500000 || on_count!=previous_on || off_count!=previous_off)
            $fatal(1,"pressure minimum or repeated key edge");
        saved_frequency=dut.note_freq[9];
        bend_code=0;wait_bend(16'h0000);
        if(dut.note_freq[9]<25685000 || dut.note_freq[9]>25696000) $fatal(1,"A4 downward bend");
        bend_code=2048;wait_bend(16'hffff);
        if(dut.note_freq[9]<32361000 || dut.note_freq[9]>32373000) $fatal(1,"A4 upward bend");
        bend_code=1024;wait_bend(16'h8000);
        if(dut.note_freq[9]!=saved_frequency || on_count!=previous_on || off_count!=previous_off)
            $fatal(1,"bend center or repeated note trigger");
        keys=24'h000200;scans(8); // leave A4 only
        if(off_count-previous_off!=23) $fatal(1,"independent releases");
        $display("FULL_PRESSURE_BEND_PASS on=%0d off=%0d",on_count,off_count);
        // All eight physical encoders: ordinary ADSR/wave/gain edit and press-to-default.
        repeat(4) turn(0,1);
        if(dut.wavetable_0[0]!=1) $fatal(1,"K1 wave");
        turn(1,1);if(dut.wavetable_interp[0]!=1638) $fatal(1,"K2 interp");
        turn(2,1);if(dut.ui_master_volume!=34406) $fatal(1,"K3 gain");
        turn(3,1);if(dut.ui_balance_volume!=34406) $fatal(1,"K4 gain");
        turn(4,1);if(dut.attack_ticks[0]!=720) $fatal(1,"K5 attack");
        turn(5,1);if(dut.decay_ticks[0]!=7680) $fatal(1,"K6 decay");
        turn(6,1);if(dut.sustain_level[0]!=49152) $fatal(1,"K7 sustain");
        turn(7,1);if(dut.release_ticks[0]!=12000) $fatal(1,"K8 release");
        ui_button[3]=1;scans(4);turn(2,0);ui_button[3]=0;scans(4);
        if(dut.ui_master_volume!=34078) $fatal(1,"B4 fine edit");
        for(i=0;i<8;i=i+1) push_knob(i);
        if(dut.ui_master_volume!=32768 || dut.wavetable_0[0]!=0 || dut.release_ticks[0]!=9600)
            $fatal(1,"knob reset defaults");
        // Work mode1 enables all four real effect paths, without replacing any mixer.
        press(1);
        for(i=4;i<8;i=i+1) turn(i,1);
        if(dut.ui_reverb_mix!=3277 || dut.ui_delay_mix!=3277 ||
           dut.ui_distortion_mix!=3277 || dut.ui_chorus_mix!=3277) $fatal(1,"four wet controls");
        if(dut.mix_reverb_mix!=3277 || dut.mix_delay_mix!=3277 ||
           dut.mix_distortion_mix!=3277 || dut.mix_chorus_mix!=3277) $fatal(1,"mixer command parameter binding");
        press(1);
        // Advanced page: select each effect, edit both parameters, restore defaults.
        press(0);repeat(3) press(2);press(0);
        for(i=0;i<4;i=i+1)
        begin
            press(0);if(dut.menu_page!=7) $fatal(1,"advanced page");
            turn(0,1);turn(1,1);
            case(i)
                0: if(dut.ui_reverb_feedback!=46080 || dut.ui_reverb_damping!=11264) $fatal(1,"reverb advanced");
                1: if(dut.ui_delay_time!=12480 || dut.ui_delay_feedback!=37888) $fatal(1,"delay advanced");
                2: if(dut.ui_distortion_gain!=4352 || dut.ui_distortion_tone!=33792) $fatal(1,"distortion advanced");
                3: if(dut.ui_chorus_rate!=17408 || dut.ui_chorus_depth!=25) $fatal(1,"chorus advanced");
            endcase
            press(2);press(0); // restore selected effect, also clears its wet amount
            press(3);if(i<3) press(2);
        end
        press(3);press(3);check_state(0,0,0,-1);
        $display("FULL_CONTROLS_EFFECTS_PASS pcm=%0d",pcm_count);
        // Chord candidate/confirm/cancel and an already held normal note.
        press(0); // opening the main menu selects its first item
        repeat(3) press(1);press(0);check_state(1,1,0,0);
        press(2);check_state(1,1,0,1);
        previous_on=on_count;keys=24'h800200;press(0);check_state(0,0,1,1);
        // keys may reach UI before the confirm; press next key after confirmation to test unambiguously.
        keys=24'h800201;last_on=0;settle;
        if(last_on!=3) $fatal(1,"chord must have three notes");
        last_off=0;keys=24'h800001;settle;if(last_off!=1) $fatal(1,"old held normal note must stay one note");
        press(0);press(0);press(1);press(3);press(3);check_state(0,0,1,0);
        // Return to normal before save/load. Current implementation preserves held sound during load.
        press(0);press(0);press(1);press(0);check_state(0,0,0,0);
        keys=24'h000200;settle;
        wait(dut.storage_catalog_valid);
        turn(1,1); // save 5% interpolation
        press(0);repeat(2) press(2);press(0);operation();
        if(!dut.storage_slot_present[0] || flash_u.program_commands==0) $fatal(1,"Flash save absent");
        press(3);press(3);press(3);
        turn(1,1);if(dut.wavetable_interp[0]!=3277) $fatal(1,"post-save edit");
        press(0);press(2);press(0);operation();
        settle;if(dut.wavetable_interp[0]!=1638) $fatal(1,"Flash reload did not restore interpolation");
        press(3);press(3);press(3);check_state(0,0,0,-1);
        $display("FULL_FLASH_CHORD_PASS programs=%0d PCM=%0d",flash_u.program_commands,pcm_count);
        t=0;
        while(!dut.lcd_display_u.wave_valid && t<2600000) begin @(negedge clk_sys);t=t+1;end
        if(!dut.lcd_display_u.wave_valid) $fatal(1,"waveform window");
        press(2);
        t=0;
        while(!dut.lcd_display_u.spectrum_valid && t<2600000) begin @(negedge clk_sys);t=t+1;end
        if(!dut.lcd_display_u.spectrum_valid) $fatal(1,"FFT window");
        if(pressure_mask!=24'hffffff || pressure_frames<4 || bend_requests<10 || decoded_left<1024 ||
           commits<15 || visible_pixels==0 || pcm_while_waiting==0 || nonzero_pcm<500 || !status_led[5])
            $fatal(1,"incomplete full-system coverage");
        $display("FULL_DATA pressure=%0d/%0d bend=%0d on/off=%0d/%0d PCM=%0d nonzero=%0d I2S=%0d/%0d LCD=%0d pixels=%0d",
            pressure_requests,pressure_frames,bend_requests,on_count,off_count,pcm_count,nonzero_pcm,decoded_left,decoded_right,commits,visible_pixels);
        rst_n=0;keys=0;ui_button=0;#2;
        if(lcd_bl || lcd_en || i2s_bclk) $fatal(1,"asynchronous reset");
        repeat(16) @(negedge clk_sys);rst_n=1;settle;check_state(0,0,0,0);
        test_passed=1;
        $display("TEST_FULL_SYSTEM_PASS keyboard24 FSR24 sharedADC bend knobs8 buttons4 UI32 effects4 Flash chord I2S LCD_RGB waveform FFT reset");
        if ($test$plusargs("BATCH_FINISH")) $finish;
        else $stop;
    end
    initial begin #300000000;$fatal(1,"full-system watchdog");end
endmodule
