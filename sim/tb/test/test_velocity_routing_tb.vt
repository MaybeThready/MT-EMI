/**
 * 逐个测试24个键各自分配到第0声部：初始力度正确、邻键压力隔离、持续调压不重起音。
 * 使用真实32声部UI及valid/ready反馈，全部检查通过打印VELOCITY_ROUTING_PASS。
 */
`timescale 1ns/1ps
module test_velocity_routing_tb;
    reg clk_sys = 1'b0;
    reg rst_n = 1'b0;
    reg smp_tick_up = 1'b0;
    reg [23:0] key_states = 24'd0;
    reg [15:0] key_velocity [23:0];
    reg in_valid = 1'b0;
    wire in_ready, out_valid;
    wire [31:0] note_on, note_off;
    wire [31:0] note_freq [31:0];
    wire [15:0] note_velocity [31:0];
    reg [31:0] note_busy = 32'd0;
    reg note_busy_valid = 1'b0;
    wire note_busy_ready, configuration_error, sample_overrun;
    wire [15:0] bend_value [0:0];
    reg regression_passed = 1'b0;
    integer key, lane, samples = 0, cycles, tick_timer = 0;
    integer on_events = 0;
    reg [31:0] expected_frequency;
    real frequency;

    always #5 clk_sys = ~clk_sys;
    always @(negedge clk_sys)
    begin
        if (!rst_n)
        begin
            tick_timer = 0;
            smp_tick_up = 1'b0;
        end
        else
        begin
            smp_tick_up = (tick_timer == 2047);
            tick_timer = (tick_timer == 2047) ? 0 : tick_timer + 1;
        end
    end
    assign bend_value[0] = 16'h8000;
    user_interface #(.KEY_NUM(24), .MAX_POLYPHONY(32), .CHANNEL_NUM(1), .WAVE_SELECT_STEPS(4)) dut_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .scan_tick_up(1'b0), .smp_tick_up(smp_tick_up),
        .key_states(key_states), .key_velocity(key_velocity),
        .knob_states(8'd0), .knob_dirs(8'd0), .knob_pressed(8'd0),
        .button_states(4'd0), .bend_value(bend_value),
        .note_busy(note_busy), .note_busy_valid(note_busy_valid), .note_busy_ready(note_busy_ready),
        .in_valid(in_valid), .in_ready(in_ready), .out_valid(out_valid), .out_ready(1'b1),
        .note_on(note_on), .note_off(note_off), .note_freq(note_freq), .note_velocity(note_velocity),
        .wavetable_0(), .wavetable_1(), .wavetable_interp(), .init_phase(),
        .attack_ticks(), .decay_ticks(), .sustain_level(), .release_ticks(),
        .master_volume(), .balance_volume(), .reverb_mix(), .delay_mix(), .distortion_mix(), .chorus_mix(),
        .reverb_feedback(), .reverb_damping(), .delay_time(), .delay_feedback(),
        .distortion_gain(), .distortion_tone(), .chorus_rate(), .chorus_depth(),
        .configuration_error(configuration_error), .sample_overrun(sample_overrun),
        .storage_out_valid(), .storage_out_write(), .storage_out_slot(), .storage_out_data(),
        .storage_in_ready(), .menu_page(), .menu_selection(), .menu_slot(), .menu_save(),
        .menu_effect(), .menu_effect_reset(), .menu_advanced_parameters(), .menu_result_status(),
        .menu_slot_known(), .menu_slot_present(),
        .storage_out_ready(1'b0), .storage_in_valid(1'b0), .storage_in_status(3'd0),
        .storage_in_data(512'd0), .storage_catalog_valid(1'b1), .storage_slot_present(16'd0)
    );

    // 独立音频反馈模型：命令消费后才产生对应busy快照，不用UI的in_ready门控反馈。
    always @(posedge clk_sys or negedge rst_n)
    begin
        if (!rst_n)
        begin
            note_busy <= 32'd0;
            note_busy_valid <= 1'b0;
            on_events <= 0;
        end
        else if (out_valid)
        begin
            note_busy <= (note_busy | note_on) & ~note_off;
            note_busy_valid <= 1'b1;
            if (note_on != 32'd0) on_events <= on_events + 1;
        end
        else if (note_busy_ready)
            note_busy_valid <= 1'b0;
    end

    task send_frame;
        begin
            @(negedge clk_sys);
            in_valid = 1'b1;
            cycles = 0;
            while (!in_ready)
            begin
                @(negedge clk_sys);
                cycles = cycles + 1;
                if (cycles > 3000) $fatal(1, "UI input timeout key=%0d", key);
            end
            @(negedge clk_sys);
            in_valid = 1'b0;
        end
    endtask

    task check_sample;
        input expected_on;
        input [15:0] expected_velocity;
        begin
            cycles = 0;
            while (!out_valid || note_velocity[0] !== expected_velocity)
            begin
                @(negedge clk_sys);
                cycles = cycles + 1;
                if (cycles > 20000) $fatal(1, "UI sample timeout key=%0d velocity=%0d expected=%0d",
                    key, note_velocity[0], expected_velocity);
            end
            if (note_on !== (expected_on ? 32'd1 : 32'd0) || note_off !== 32'd0)
                $fatal(1, "Wrong event/voice key=%0d on=%h off=%h", key, note_on, note_off);
            if (note_velocity[0] !== expected_velocity ||
                note_freq[0] < expected_frequency - 4 || note_freq[0] > expected_frequency + 4)
                $fatal(1, "Wrong routing key=%0d velocity=%0d expected=%0d freq=%0d", key,
                    note_velocity[0], expected_velocity, note_freq[0]);
            for (lane = 1; lane < 32; lane = lane + 1)
                if (note_velocity[lane] !== 16'd0)
                    $fatal(1, "Inactive voice has velocity key=%0d voice=%0d", key, lane);
            if (configuration_error || sample_overrun) $fatal(1, "UI diagnostic fault");
            samples = samples + 1;
            @(negedge clk_sys);
            if (on_events != 1) $fatal(1, "Repeated/missing note_on key=%0d count=%0d", key, on_events);
        end
    endtask

    initial
    begin
        for (key = 0; key < 24; key = key + 1)
        begin
            rst_n = 1'b0;
            in_valid = 1'b0;
            key_states = 24'd0;
            for (lane = 0; lane < 24; lane = lane + 1) key_velocity[lane] = 16'd0;
            repeat (8) @(negedge clk_sys);
            rst_n = 1'b1;
            repeat (400) @(negedge clk_sys);
            key_states = 24'd1 << key;
            key_velocity[key] = 16'd16384;
            frequency = 440.0 * (2.0 ** ((key - 9) / 12.0));
            expected_frequency = $rtoi(frequency * 65536.0 + 0.5);
            send_frame;
            check_sample(1'b1, 16'd16384);
            key_velocity[(key == 0) ? 1 : 0] = 16'hFFFF;
            send_frame;
            check_sample(1'b0, 16'd16384);
            key_velocity[key] = 16'd32768;
            send_frame;
            check_sample(1'b0, 16'd16658);
            key_velocity[key] = 16'd0;
            send_frame;
            check_sample(1'b0, 16'd16384);
            $display("PASS: key=%0d -> voice0, own pressure and neighbor isolation", key);
        end
        regression_passed = 1'b1;
        $display("VELOCITY_ROUTING_PASS keys=24 voices=32 samples=%0d", samples);
        $stop;
    end

    initial
    begin
        #10_000_000;
        $fatal(1, "Velocity routing watchdog");
    end
endmodule
