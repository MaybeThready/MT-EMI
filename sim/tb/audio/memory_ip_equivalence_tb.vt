`timescale 1ns/1ps
/** Compare vendor ROM and shared audio RAM to fast functional models. ROM covers
 * all16384 words and CE holds; RAM checks banks, address boundaries and random
 * write/read operations. Uses the exact one-clock configuration of the audio RTL.
 */
module memory_ip_equivalence_tb;
    GSR GSR(.GSRI(1'b1));
    reg clk=0;
    always #5 clk=~clk;
    reg ce=1,wr=0,rd=1,reset=0;
    reg [13:0] rom_addr=0;
    reg [16:0] wa=0,ra=0;
    reg [23:0] din=0;
    wire [15:0] actual_rom,model_rom;
    wire [23:0] actual_ram,model_ram;
    integer i,seed=9321;
    reg test_passed=0;
    rom_wavetables rom_u(.dout(actual_rom),.clk(clk),.oce(1'b1),.ce(ce),.reset(1'b0),.ad(rom_addr));
    wavetable_memory_model rom_model_u(.dout(model_rom),.clk(clk),.oce(1'b1),.ce(ce),.reset(1'b0),.ad(rom_addr));
    audio_mix_buffer ram_u(.dout(actual_ram),.clka(clk),.cea(wr),.clkb(clk),.ceb(rd),.oce(1'b1),.reset(reset),.ada(wa),.din(din),.adb(ra));
    audio_memory_model ram_model_u(.dout(model_ram),.clka(clk),.cea(wr),.clkb(clk),.ceb(rd),.oce(1'b1),.reset(reset),.ada(wa),.din(din),.adb(ra));
    initial
    begin
        repeat(4) @(negedge clk);
        for(i=0;i<16384;i=i+1)
        begin
            rom_addr=i;
            @(posedge clk); #1;
            if(actual_rom!==model_rom) $fatal(1,"ROM model mismatch addr=%0d %h/%h",i,actual_rom,model_rom);
            @(negedge clk);
        end
        ce=0;
        repeat(9)
        begin
            rom_addr=$random(seed);
            @(posedge clk); #1;
            if(actual_rom!==model_rom) $fatal(1,"ROM CE mismatch");
            @(negedge clk);
        end
        for(i=0;i<4096;i=i+1)
        begin
            wa=(i<80) ? i*1024 : (($random(seed)&131071)%81920);
            din=$random(seed); wr=1; ra=wa^17'd1;
            @(negedge clk); wr=0; ra=wa;
            @(posedge clk); #1;
            if(actual_ram!==model_ram) $fatal(1,"RAM model mismatch addr=%0d %h/%h",ra,actual_ram,model_ram);
            @(negedge clk);
        end
        test_passed=1;
        $display("MEMORY_IP_EQUIVALENCE_PASS ROM=16384 RAM=4096 CE=9");
        $finish;
    end
endmodule
