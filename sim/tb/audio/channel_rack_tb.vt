/**
 * 两路通道机架测试平台
 * 观察单音、同步同频及错开异频演奏的波形，并检查力度、事件和握手。
 */

`timescale 1ps/1ps
`include "../../../src/defines.vh"

module channel_rack_tb();
    localparam VOICE_NUM = 2;
    localparam CLK_SYS_PERIOD_CNT = 64'd1_000_000_000_000 / `CLK_SYS_FREQ;
    localparam [31:0] PHASE_INCR_K = (64'd1 << 32) / `SMP_TICK_FREQ;
    localparam [31:0] FREQ_375 = 32'd24_576_000;  // 375 Hz，128 个采样点/周期
    localparam [31:0] FREQ_750 = 32'd49_152_000;  // 750 Hz，64 个采样点/周期

    reg clk_sys;
    reg rst_n;
    wire smp_tick_up;

    sys_ticker ticker_u (
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .i2s_tick_up(),
        .i2s_tick_down(),
        .smp_tick_up(smp_tick_up),
        .smp_tick_down(),
        .scan_tick_up(),
        .scan_tick_down()
    );

    reg [VOICE_NUM-1:0] note_on, note_off;
    wire [VOICE_NUM-1:0] note_busy;
    wire note_busy_valid;
    reg note_busy_ready;
    reg [31:0] note_freq [VOICE_NUM-1:0];
    reg [15:0] note_velocity [VOICE_NUM-1:0];
    reg [15:0] detune;
    reg [19:0] attack_ticks, decay_ticks, release_ticks;
    reg [15:0] sustain_level;
    reg [3:0] wavetable_0, wavetable_1;
    reg [15:0] wavetable_interp;
    reg in_valid, out_ready;
    wire in_ready, out_valid;
    wire signed [16:0] audio_out;

    channel_rack #(
        .MAX_POLYPHONY(VOICE_NUM)
    ) rack_u (
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .smp_tick_up(smp_tick_up),
        .note_on(note_on),
        .note_off(note_off),
        .note_busy(note_busy),
        .note_busy_valid(note_busy_valid),
        .note_busy_ready(note_busy_ready),
        .note_freq(note_freq),
        .note_velocity(note_velocity),
        .detune(detune),
        .attack_ticks(attack_ticks),
        .decay_ticks(decay_ticks),
        .sustain_level(sustain_level),
        .release_ticks(release_ticks),
        .wavetable_0(wavetable_0),
        .wavetable_1(wavetable_1),
        .wavetable_interp(wavetable_interp),
        .audio_out(audio_out),
        .out_ready(out_ready),
        .in_valid(in_valid),
        .out_valid(out_valid),
        .in_ready(in_ready)
    );

    // Gowin ROM 原语通过全局 GSR 获取复位状态。
    GSR GSR (
        .GSRI(rst_n)
    );

    initial
    begin
        clk_sys = 1'b0;
        forever
        begin
            #(CLK_SYS_PERIOD_CNT / 2);
            clk_sys = ~clk_sys;
        end
    end

    reg [15:0] reference_rom [0:16383];
    reg [8*128-1:0] header_line;
    integer rom_file, read_count, rom_index;

    initial
    begin
        rom_file = $fopen("../assets/audio/wavetables.mi", "r");
        if (rom_file == 0)
        begin
            $display("FAIL: cannot open ../assets/audio/wavetables.mi");
            $stop;
        end
        repeat (3) read_count = $fgets(header_line, rom_file);
        for (rom_index = 0; rom_index < 16384; rom_index = rom_index + 1)
        begin
            read_count = $fscanf(rom_file, "%h", reference_rom[rom_index]);
            if (read_count != 1)
            begin
                $display("FAIL: incomplete MI file at address %0d", rom_index);
                $stop;
            end
        end
        $fclose(rom_file);
    end

    function [31:0] calc_increment;
        input [31:0] freq_code;
        reg [63:0] product;
        begin
            product = PHASE_INCR_K * freq_code;
            calc_increment = (product + 64'd32768) >> 16;
        end
    endfunction

    function [31:0] calc_offset;
        input [31:0] base_increment;
        input [15:0] amount;
        reg [35:0] ratio_product;
        reg [19:0] ratio;
        reg [51:0] offset_product;
        begin
            ratio_product = amount * 20'd7294;
            ratio = (ratio_product + 36'd32768) >> 16;
            offset_product = base_increment * ratio;
            calc_offset = (offset_product + 52'd524288) >> 20;
        end
    endfunction

    function [11:0] calc_out_phase;
        input [31:0] phase_code;
        begin
            if (phase_code[31:20] == 12'hfff)
                calc_out_phase = 12'hfff;
            else
                calc_out_phase = phase_code[31:20] + phase_code[19];
        end
    endfunction

    function [15:0] calc_volume;
        input [15:0] envelope_level, velocity;
        reg [31:0] product;
        begin
            product = envelope_level * velocity;
            calc_volume = (product + 32'd32768) >> 16;
        end
    endfunction

    function signed [15:0] calc_sample;
        input [3:0] wave_0, wave_1;
        input [15:0] coeff;
        input [11:0] wave_phase;
        reg [15:0] code_0, code_1;
        reg signed [16:0] point_0, point_1, delta, point_sum;
        reg signed [63:0] product;
        begin
            code_0 = reference_rom[{wave_0[1:0], wave_phase}];
            code_1 = reference_rom[{wave_1[1:0], wave_phase}];
            point_0 = $signed({code_0[15], code_0});
            point_1 = $signed({code_1[15], code_1});
            product = (point_1 - point_0) * $signed({1'b0, coeff});
            delta = (product + (product < 0 ? 64'sd16383 : 64'sd16384)) >>> 15;
            point_sum = point_0 + delta;
            calc_sample = point_sum[15:0];
        end
    endfunction

    function signed [15:0] calc_voice;
        input signed [15:0] point;
        input [15:0] level;
        reg signed [63:0] product, rounded;
        begin
            product = point * $signed({1'b0, level});
            rounded = (product + (product < 0 ? 64'sd32767 : 64'sd32768)) >>> 16;
            calc_voice = rounded[15:0];
        end
    endfunction

    integer scenario_id, sample_index, sample_count;
    integer transfer_count, feedback_count, stall_count, error_count;
    reg [31:0] expected_phase [VOICE_NUM*5-1:0];
    reg signed [16:0] observed_audio, expected_audio;
    reg [11:0] observed_phase_0, observed_phase_1;
    reg [15:0] observed_envelope_0, observed_envelope_1;
    reg [15:0] observed_volume_0, observed_volume_1;

    always @(posedge clk_sys or negedge rst_n)
    begin
        if (!rst_n)
        begin
            transfer_count <= 0;
            feedback_count <= 0;
        end
        else
        begin
            if (out_valid && out_ready)
                transfer_count <= transfer_count + 1;
            if (note_busy_valid && note_busy_ready)
                feedback_count <= feedback_count + 1;
        end
    end

    task reset_rack;
        begin
            @(negedge clk_sys);
            rst_n = 1'b0;
            in_valid = 1'b0;
            out_ready = 1'b1;
            note_busy_ready = 1'b1;
            note_on = '0;
            note_off = '0;
            repeat (4) @(negedge clk_sys);
            for (integer phase_index = 0; phase_index < VOICE_NUM*5; phase_index = phase_index + 1)
                expected_phase[phase_index] = '0;
            rst_n = 1'b1;
        end
    endtask

    task send_sample;
        input [1:0] new_note_on, new_note_off;
        input [31:0] freq_0, freq_1;
        input [15:0] velocity_0, velocity_1;
        input integer input_delay, output_stall;
        integer wait_cycles, old_transfer_count, old_feedback_count, expected_sum;
        integer lane, osc, side_sum;
        reg [31:0] base_inc, offset_inc;
        reg signed [15:0] base_point;
        reg signed [63:0] blend_product;
        reg feedback_stall;
        reg [VOICE_NUM-1:0] held_busy;
        reg [15:0] effective_volume [1:0];
        reg [11:0] phase_code;
        reg signed [15:0] point;
        reg signed [16:0] held_audio;
        reg [3:0] wave_0, wave_1;
        reg [15:0] interp;
        reg [15:0] requested_detune;
        begin
            @(posedge smp_tick_up);
            @(negedge smp_tick_up);
            @(negedge clk_sys);
            note_on = new_note_on;
            note_off = new_note_off;
            note_freq[0] = freq_0;
            note_freq[1] = freq_1;
            note_velocity[0] = velocity_0;
            note_velocity[1] = velocity_1;
            wave_0 = wavetable_0;
            wave_1 = wavetable_1;
            interp = wavetable_interp;
            requested_detune = detune;
            out_ready = output_stall == 0;
            feedback_stall = scenario_id == 3 && sample_index == 32;
            note_busy_ready = !feedback_stall;
            old_transfer_count = transfer_count;
            old_feedback_count = feedback_count;

            wait_cycles = 0;
            while (in_ready !== 1'b1 && wait_cycles < 32)
            begin
                @(negedge clk_sys);
                wait_cycles = wait_cycles + 1;
            end
            if (in_ready !== 1'b1)
            begin
                $display("FAIL input ready timeout: scenario=%0d sample=%0d", scenario_id, sample_index);
                $stop;
            end

            repeat (input_delay) @(negedge clk_sys);
            if (in_ready !== 1'b1)
            begin
                error_count = error_count + 1;
                $display("FAIL input waiting: scenario=%0d sample=%0d", scenario_id, sample_index);
            end
            for (lane = 0; lane < VOICE_NUM; lane = lane + 1)
            begin
                base_inc = calc_increment(lane == 0 ? freq_0 : freq_1);
                offset_inc = calc_offset(base_inc, detune);
                if (new_note_on[lane])
                begin
                    for (osc = 0; osc < 5; osc = osc + 1)
                        expected_phase[lane*5+osc] = '0;
                end
                else
                begin
                    expected_phase[lane*5] = expected_phase[lane*5] + base_inc;
                    expected_phase[lane*5+1] = expected_phase[lane*5+1] + base_inc - (offset_inc >> 1);
                    expected_phase[lane*5+2] = expected_phase[lane*5+2] + base_inc + (offset_inc >> 1);
                    expected_phase[lane*5+3] = expected_phase[lane*5+3] + base_inc - offset_inc;
                    expected_phase[lane*5+4] = expected_phase[lane*5+4] + base_inc + offset_inc;
                end
            end
            in_valid = 1'b1;

            @(posedge clk_sys);
            #1;
            if (in_ready !== 1'b0)
            begin
                error_count = error_count + 1;
                $display("FAIL input handshake: scenario=%0d sample=%0d", scenario_id, sample_index);
            end
            @(negedge clk_sys);
            in_valid = 1'b0;
            note_on = '0;
            note_off = '0;
            note_freq[0] = '0;
            note_freq[1] = '0;
            note_velocity[0] = '0;
            note_velocity[1] = '0;
            wavetable_0 = 4'd3;
            wavetable_1 = 4'd2;
            wavetable_interp = 16'h8000;
            detune = ~requested_detune;  // 握手后扰动输入，验证整个声部合成沿用锁存值。

            wait_cycles = 0;
            while (rack_u.synth_in_valid !== 1'b1 && wait_cycles < 700)
            begin
                if (in_ready !== 1'b0)
                begin
                    error_count = error_count + 1;
                    $display("FAIL premature ready: scenario=%0d sample=%0d", scenario_id, sample_index);
                end
                @(negedge clk_sys);
                wait_cycles = wait_cycles + 1;
            end
            if (rack_u.synth_in_valid !== 1'b1)
            begin
                $display("FAIL synthesizer input timeout: scenario=%0d sample=%0d", scenario_id, sample_index);
                $stop;
            end
            if (feedback_stall)
            begin
                held_busy = note_busy;
                if (note_busy_valid !== 1'b1 || held_busy !== rack_u.envelope_note_busy)
                begin
                    error_count = error_count + 1;
                    $display("FAIL feedback snapshot: scenario=%0d sample=%0d", scenario_id, sample_index);
                end
            end

            expected_sum = 0;
            for (lane = 0; lane < VOICE_NUM; lane = lane + 1)
            begin
                base_point = calc_sample(wave_0, wave_1, interp,
                                         calc_out_phase(expected_phase[lane*5]));
                side_sum = 0;
                for (osc = 0; osc < 5; osc = osc + 1)
                begin
                    phase_code = calc_out_phase(expected_phase[lane*5+osc]);
                    if (rack_u.phase[lane*5+osc] !== phase_code)
                    begin
                        error_count = error_count + 1;
                        $display("FAIL phase: scenario=%0d sample=%0d lane=%0d osc=%0d expected=%03h actual=%03h",
                                 scenario_id, sample_index, lane, osc, phase_code, rack_u.phase[lane*5+osc]);
                    end
                    point = calc_sample(wave_0, wave_1, interp, phase_code);
                    if (osc != 0)
                        side_sum = side_sum + point;
                end
                effective_volume[lane] = calc_volume(rack_u.envelope_volume[lane],
                                                      lane == 0 ? velocity_0 : velocity_1);
                if (rack_u.volume_r[lane] !== effective_volume[lane])
                begin
                    error_count = error_count + 1;
                    $display("FAIL velocity: scenario=%0d sample=%0d lane=%0d expected=%h actual=%h",
                             scenario_id, sample_index, lane,
                             effective_volume[lane], rack_u.volume_r[lane]);
                end
                blend_product = (side_sum - 4*base_point) * $signed({1'b0, requested_detune});
                point = base_point + ((blend_product +
                         (blend_product < 0 ? 64'sd262143 : 64'sd262144)) >>> 19);
                expected_sum = expected_sum + calc_voice(point, effective_volume[lane]);
            end
            expected_audio = expected_sum;
            observed_phase_0 = rack_u.phase[0];
            observed_phase_1 = rack_u.phase[5];
            observed_envelope_0 = rack_u.envelope_volume[0];
            observed_envelope_1 = rack_u.envelope_volume[1];
            observed_volume_0 = rack_u.volume_r[0];
            observed_volume_1 = rack_u.volume_r[1];

            wait_cycles = 0;
            while (out_valid !== 1'b1 && wait_cycles < 800)
            begin
                @(negedge clk_sys);
                wait_cycles = wait_cycles + 1;
            end
            if (out_valid !== 1'b1)
            begin
                $display("FAIL output timeout: scenario=%0d sample=%0d", scenario_id, sample_index);
                $stop;
            end
            observed_audio = audio_out;
            if (audio_out !== expected_audio)
            begin
                error_count = error_count + 1;
                $display("FAIL audio: scenario=%0d sample=%0d expected=%0d actual=%0d",
                         scenario_id, sample_index, expected_audio, audio_out);
            end

            held_audio = audio_out;
            repeat (output_stall)
            begin
                @(negedge clk_sys);
                stall_count = stall_count + 1;
                if (out_valid !== 1'b1 || in_ready !== 1'b0 || audio_out !== held_audio)
                begin
                    error_count = error_count + 1;
                    $display("FAIL output stall: scenario=%0d sample=%0d", scenario_id, sample_index);
                end
                if (feedback_stall && (note_busy_valid !== 1'b1 || note_busy !== held_busy))
                begin
                    error_count = error_count + 1;
                    $display("FAIL feedback stall: scenario=%0d sample=%0d", scenario_id, sample_index);
                end
            end
            out_ready = 1'b1;
            @(posedge clk_sys);
            #1;
            if (out_valid !== 1'b0 || transfer_count !== old_transfer_count + 1)
            begin
                error_count = error_count + 1;
                $display("FAIL output handshake: scenario=%0d sample=%0d", scenario_id, sample_index);
            end
            if (feedback_stall)
            begin
                if (note_busy_valid !== 1'b1 || note_busy !== held_busy ||
                    feedback_count !== old_feedback_count)
                begin
                    error_count = error_count + 1;
                    $display("FAIL independent feedback: scenario=%0d sample=%0d", scenario_id, sample_index);
                end
                @(negedge clk_sys);
                note_busy_ready = 1'b1;
                @(posedge clk_sys);
                #1;
            end
            if (note_busy_valid !== 1'b0 || feedback_count !== old_feedback_count + 1)
            begin
                error_count = error_count + 1;
                $display("FAIL feedback handshake: scenario=%0d sample=%0d", scenario_id, sample_index);
            end
            wavetable_0 = wave_0;
            wavetable_1 = wave_1;
            wavetable_interp = interp;
            detune = requested_detune;
            sample_count = sample_count + 1;
        end
    endtask

    integer i;
    initial
    begin
        rst_n = 1'b0;
        in_valid = 1'b0;
        out_ready = 1'b1;
        note_busy_ready = 1'b1;
        note_on = '0;
        note_off = '0;
        note_freq[0] = '0;
        note_freq[1] = '0;
        note_velocity[0] = '0;
        note_velocity[1] = '0;
        detune = 16'd0;
        attack_ticks = 20'd4;
        decay_ticks = 20'd8;
        sustain_level = 16'hc000;
        release_ticks = 20'd16;
        wavetable_0 = 4'd0;
        wavetable_1 = 4'd0;
        wavetable_interp = 16'd0;
        scenario_id = 0;
        sample_index = 0;
        sample_count = 0;
        stall_count = 0;
        error_count = 0;
        observed_audio = '0;
        expected_audio = '0;
        observed_phase_0 = '0;
        observed_phase_1 = '0;
        observed_envelope_0 = '0;
        observed_envelope_1 = '0;
        observed_volume_0 = '0;
        observed_volume_1 = '0;
        for (i = 0; i < VOICE_NUM*5; i = i + 1)
            expected_phase[i] = '0;

        reset_rack();
        scenario_id = 1;
        for (i = 0; i < 128; i = i + 1)
        begin
            sample_index = i;
            send_sample(i == 0 ? 2'b01 : 2'b00, 2'b00,
                        FREQ_375, FREQ_375, 16'hffff, 16'd0,
                        i == 0 ? 3 : 0, i == 32 ? 6 : 0);
        end
        for (i = 0; i < 20; i = i + 1)
        begin
            sample_index = 128 + i;
            send_sample(2'b00, i == 0 ? 2'b01 : 2'b00,
                        FREQ_375, FREQ_375, 16'hffff, 16'd0, 0, 0);
        end
        if (note_busy[0] !== 1'b0)
        begin
            error_count = error_count + 1;
            $display("FAIL single-note release");
        end
        $display("Scenario 1: one full 375 Hz period and release complete");

        reset_rack();
        scenario_id = 2;
        wavetable_0 = 4'd0;
        wavetable_1 = 4'd0;
        wavetable_interp = 16'd0;
        for (i = 0; i < 128; i = i + 1)
        begin
            sample_index = i;
            send_sample(i == 0 ? 2'b11 : 2'b00, 2'b00,
                        FREQ_375, FREQ_375, 16'h8000, 16'h8000,
                        i == 16 ? 4 : 0, i == 64 ? 5 : 0);
        end
        if (note_busy !== 2'b11)
        begin
            error_count = error_count + 1;
            $display("FAIL synchronous note busy");
        end
        $display("Scenario 2: synchronous same-frequency voices complete");

        reset_rack();
        scenario_id = 3;
        detune = 16'hffff;
        wavetable_0 = 4'd0;
        wavetable_1 = 4'd1;
        wavetable_interp = 16'h4000;
        for (i = 0; i < 128; i = i + 1)
        begin
            sample_index = i;
            send_sample(i == 0 ? 2'b01 : (i == 32 ? 2'b10 : 2'b00),
                        (i == 96 ? 2'b01 : (i == 112 ? 2'b10 : 2'b00)),
                        FREQ_375, FREQ_750,
                        (i >= 64 && i < 80) ? 16'd0 : 16'hc000,
                        16'h6000,
                        i == 32 ? 3 : 0, i == 80 ? 4 : 0);
            wavetable_0 = 4'd0;
            wavetable_1 = 4'd1;
            wavetable_interp = 16'h4000;
        end
        detune = 16'd0;  // 保留前段失谐积累的相位差，仍须还原基础音。
        for (i = 0; i < 20; i = i + 1)
        begin
            sample_index = 128 + i;
            send_sample(2'b00, 2'b00,
                        FREQ_375, FREQ_750, 16'hc000, 16'h6000, 0, 0);
            wavetable_0 = 4'd0;
            wavetable_1 = 4'd1;
            wavetable_interp = 16'h4000;
        end
        if (note_busy !== 2'b00)
        begin
            error_count = error_count + 1;
            $display("FAIL staggered-note release");
        end
        $display("Scenario 3: staggered different-frequency voices and release complete");

        $display("CHANNEL_RACK_TB: %0d samples total, %0d feedback handshakes in final scenario, %0d stalled cycles, %0d errors",
                 sample_count, feedback_count, stall_count, error_count);
        $stop;  // 留在 ModelSim GUI 中观察三段波形。
    end

    initial
    begin
        #(64'd30_000_000_000);
        $display("FAIL: channel rack testbench timeout");
        $stop;
    end
endmodule
