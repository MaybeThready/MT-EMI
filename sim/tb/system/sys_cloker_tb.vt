`timescale 1ps/1ps

module sys_clocker_tb();
    reg clk_core;
    reg rst_n;

    wire clk_sys;
    wire rst_sys_n;

    sys_clocker clk_u
    (
        .clk_core(clk_core),
        .rst_n(rst_n),
        .clk_sys(clk_sys),
        .rst_sys_n(rst_sys_n)
    );

    initial
    begin
        clk_core = 1'b0;
        forever
        begin
            #10_000;
            clk_core = ~clk_core;
        end
    end

    initial
    begin
        rst_n = 1'b0;
        #20_000;
        rst_n = 1'b1;
        repeat(1000)
        begin
            #20_000_000;
        end
        $stop;
    end
endmodule
