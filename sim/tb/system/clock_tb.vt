`timescale 1ps/1ps

module clock_tb();
    reg clk_core;
    reg rst_n;

    wire i2s_tick_up;  // 1.536M
    wire i2s_tick_down;
    wire smp_tick_up;  // 48k
    wire smp_tick_down;
    wire scan_tick_up;  // 12k
    wire scan_tick_down;

    clock clk_u
    (
        .clk_core(clk_core),
        .rst_n(rst_n),
        .clk_sys(clk_sys),
        .rst_sys_n(rst_sys_n),

        .i2s_tick_up(i2s_tick_up),  // 1.536M
        .i2s_tick_down(i2s_tick_down),
        .smp_tick_up(smp_tick_up),  // 48k
        .smp_tick_down(smp_tick_down),
        .scan_tick_up(scan_tick_up),  // 12k
        .scan_tick_down(scan_tick_down)
    );

    initial
    begin
        clk_core = 1'b0;
        forever
        begin
            #10_000;
            clk_core = ~clk_core;
        end
    end

    initial
    begin
        rst_n = 1'b0;
        #20_000;
        rst_n = 1'b1;
        repeat(1500)
        begin
            #20_000_000;
        end
        $stop;
    end
endmodule
