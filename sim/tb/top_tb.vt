`timescale 1ns/1ps
/**
 * 使用真实 sys_clocker、PLL 初始化逻辑和高云原语模型验证正式 top。
 * 覆盖锁定前复位、实际输出周期、心跳、串行参数采集、CRC 和运行中复位。
 * 增加动态弯音帧与背压检查；仅在定向背压阶段强制 UI 接收可用线，不改内部寄存器。
 * 不替代器件抖动和实物电气测试。
 */
module top_tb;
    reg clk_core = 1'b0;
    reg rst_n = 1'b0;
    wire [1:0] status_led;
    integer bit_count = 0;
    integer heartbeat_changes = 0;
    reg last_heartbeat = 1'b0;
    reg [31:0] expected_crc = 32'hffffffff;
    realtime first_edge;
    realtime measured_period;
    integer system_cycles = 0;
    integer last_sample_cycle = -1;
    integer last_scan_cycle = -1;
    integer captured_frames = 0;
    integer expected_bits = 0;
    reg [1795:0] expected_serial = '0;
    reg [27:0] held_source = '0;
    reg source_stalled = 1'b0;
    reg [15:0] held_bend = 16'h8000;
    integer bend_frames = 0;
    integer stalled_cycles = 0;
    reg [3:0] bend_coverage = 4'b0000;

    always #10 clk_core = ~clk_core;

    top #(
        .STATUS_COUNTER_WIDTH(8)
    ) top_u (
        .clk_core(clk_core), .rst_n(rst_n), .status_led(status_led)
    );

    always @(posedge top_u.clk_sys)
    begin
        if (top_u.rst_sys_n)
        begin
            system_cycles = system_cycles + 1;
            if (top_u.sample_tick)
            begin
                if (last_sample_cycle >= 0 && system_cycles - last_sample_cycle != 2048)
                    $fatal(1, "Sample tick spacing mismatch");
                last_sample_cycle = system_cycles;
            end
            if (top_u.scan_tick_up)
            begin
                if (last_scan_cycle >= 0 && system_cycles - last_scan_cycle != 8192)
                    $fatal(1, "Scan tick spacing mismatch");
                last_scan_cycle = system_cycles;
            end
            if (source_stalled && (!top_u.source_valid_r || top_u.source_frame_r !== held_source))
                $fatal(1, "Input changed during backpressure");
            if (source_stalled && top_u.bend_value[0] !== held_bend)
                $fatal(1, "Bend changed during backpressure");
            held_source = top_u.source_frame_r;
            held_bend = top_u.bend_value[0];
            source_stalled = top_u.source_valid_r && !top_u.source_ready;
            if (source_stalled) stalled_cycles = stalled_cycles + 1;
            if (top_u.source_valid_r && top_u.source_ready)
            begin
                case (bend_frames % 4)
                    0: if (held_bend !== 16'h8000) $fatal(1, "Missing center frame");
                    1: if (held_bend !== 16'h0000) $fatal(1, "Missing lower frame");
                    2: if (held_bend !== 16'hffff) $fatal(1, "Missing upper frame");
                    default: if (^held_bend === 1'bx) $fatal(1, "Unknown random bend");
                endcase
                bend_coverage[bend_frames % 4] = 1'b1;
                bend_frames = bend_frames + 1;
            end
            if (top_u.observed_valid)
            begin
                if (expected_bits == 0 || top_u.observed_serial !== expected_serial[0])
                    $fatal(1, "Serial output lost or changed a captured bit");
                expected_serial = {1'b0, expected_serial[1795:1]};
                expected_bits = expected_bits - 1;
                expected_crc = {expected_crc[30:0],1'b0} ^
                    ((expected_crc[31] ^ top_u.observed_serial) ? 32'h04c11db7 : 32'd0);
                bit_count = bit_count + 1;
            end
            if (top_u.audio_valid && top_u.audio_ready)
            begin
                if (expected_bits != 0)
                    $fatal(1, "New capture overwrote unfinished serial output");
                expected_serial = top_u.packed_parameters;
                expected_bits = 1796;
                captured_frames = captured_frames + 1;
            end
            #0.001;
            if (top_u.crc_r !== expected_crc)
                $fatal(1, "CRC mismatch");
            if (status_led[0] !== last_heartbeat)
                heartbeat_changes = heartbeat_changes + 1;
            last_heartbeat = status_led[0];
            if (top_u.configuration_error || top_u.sample_overrun)
                $fatal(1, "Unexpected diagnostic error");
        end
        else
        begin
            expected_crc = 32'hffffffff;
            last_heartbeat = 1'b0;
            system_cycles = 0;
            last_sample_cycle = -1;
            last_scan_cycle = -1;
            expected_bits = 0;
            source_stalled = 1'b0;
            bend_frames = 0;
        end
    end

    initial
    begin
        #101;
        rst_n = 1'b1;
        #1000;
        if (top_u.rst_sys_n !== 1'b0)
            $fatal(1, "System released before PLL initialization");
        wait (top_u.rst_sys_n === 1'b1);
        @(posedge top_u.clk_sys);
        first_edge = $realtime;
        repeat (1000) @(posedge top_u.clk_sys);
        measured_period = ($realtime - first_edge) / 1000.0;
        // 原语模型采用离散时间精度；允许 2 ps 量化误差。
        if (measured_period < 10.1765 || measured_period > 10.1805)
            $fatal(1, "Unexpected PLL period: %f ns", measured_period);
        // 同时阻止 UI 内部接收和向源端声明 ready，覆盖跨两个扫描节拍的背压。
        @(negedge top_u.clk_sys);
        force top_u.user_interface_u.input_frame_available = 1'b0;
        wait (top_u.source_valid_r === 1'b1);
        repeat (17000) @(negedge top_u.clk_sys);
        release top_u.user_interface_u.input_frame_available;
        repeat (80000) @(negedge top_u.clk_sys);
        if (bit_count < 2000 || heartbeat_changes < 50 || captured_frames < 20)
            $fatal(1, "Insufficient serial/heartbeat activity");
        if (bend_coverage !== 4'b1111 || stalled_cycles < 16000 || bend_frames < 8)
            $fatal(1, "Insufficient dynamic bend/backpressure coverage");
        $display("DYNAMIC_BEND_SOURCE_PASS frames=%0d stalled_cycles=%0d coverage=%b", bend_frames, stalled_cycles, bend_coverage);
        #2;
        rst_n = 1'b0;
        #1;
        if (top_u.rst_sys_n !== 1'b0 || status_led !== 2'b00)
            $fatal(1, "Asynchronous reset did not clear state");
        #100;
        rst_n = 1'b1;
        wait (top_u.rst_sys_n === 1'b1);
        repeat (3000) @(negedge top_u.clk_sys);
        $display("FORMAL_TOP_PASS period_ns=%f serial_bits=%0d heartbeat_changes=%0d frames=%0d", measured_period, bit_count, heartbeat_changes, captured_frames);
        $finish;
    end

    initial
    begin
        #50000000;
        $fatal(1, "PLL/board validation timeout");
    end
endmodule
