/**
 * 键盘子链与正式 sys_ticker/phase_accumulator_group 联仿。
 * 验证每采样一个事务、音符事件仅一次、三声部相位数值及持续音相位不被重复复位。
 * 音频 busy 是 TB 的简化模型；不代表真实包络/I2S 已实现。
 */
`timescale 1ns/1ps
module keyboard_phase_integration_tb;
    reg clk_sys = 1'b0;
    always #5.089286 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    wire smp_tick_up, scan_tick_up;
    reg [23:0] key_states = 24'd0;
    reg [15:0] key_velocity [23:0];
    reg [2:0] note_busy = 3'd0;
    reg in_valid = 1'b0;
    wire in_ready, ui_valid, ui_ready, phase_valid, phase_ready;
    wire [2:0] note_on, note_off;
    wire [31:0] note_freq [2:0];
    wire [15:0] note_velocity [2:0];
    wire [11:0] phase [2:0];
    wire sample_overrun;
    reg [31:0] reference_phase [2:0];
    reg [11:0] expected_phase [2:0];
    reg [63:0] increment_product;
    integer cycle_count = 0;
    integer input_count = 0;
    integer output_count = 0;
    integer tick_count = 0;
    integer on_count = 0;
    integer off_count = 0;
    integer voice, key_index;
    assign phase_ready = (cycle_count % 13) >= 5;
    always @(negedge clk_sys)
    begin
        if (!rst_n) cycle_count = 0;
        else cycle_count = cycle_count + 1;
    end
    sys_ticker sys_ticker_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .smp_tick_up(smp_tick_up), .scan_tick_up(scan_tick_up),
        .i2s_tick_up(), .i2s_tick_down(), .smp_tick_down(), .scan_tick_down()
    );
    keyboard_note_pipeline #(.MAX_POLYPHONY(3)) keyboard_note_pipeline_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .smp_tick_up(smp_tick_up), .scan_tick_up(scan_tick_up),
        .key_states(key_states), .key_velocity(key_velocity), .note_busy(note_busy),
        .bend_value(16'h8000),
        .in_valid(in_valid), .in_ready(in_ready), .note_on(note_on), .note_off(note_off),
        .note_freq(note_freq), .note_velocity(note_velocity), .out_valid(ui_valid), .out_ready(ui_ready),
        .sample_ready(), .sample_overrun(sample_overrun)
    );
    phase_accumulator_group #(.ACCUMULATOR_NUM(3)) phase_accumulator_group_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .smp_tick_up(smp_tick_up), .note_on(note_on),
        .init_phase(16'h2000), .freq(note_freq), .out_phase(phase),
        .in_valid(ui_valid), .in_ready(ui_ready), .out_valid(phase_valid), .out_ready(phase_ready)
    );
    always @(posedge clk_sys)
    begin
        if (rst_n)
        begin
            if (sample_overrun) $fatal(1, "键盘采样超期");
            if (smp_tick_up)
            begin
                if (input_count != tick_count || output_count != tick_count)
                    $fatal(1, "上一采样未在下一 tick 前完成");
                tick_count = tick_count + 1;
            end
            if (ui_valid && ui_ready)
            begin
                input_count = input_count + 1;
                for (voice = 0; voice < 3; voice = voice + 1)
                begin
                    // 此参考重算 64 位整数系数与舍入，不读取 DUT 内部相位或乘积。
                    increment_product = ((64'd1 << 32) / 64'd48000) * note_freq[voice];
                    reference_phase[voice] = note_on[voice] ? 32'h20000000 :
                        reference_phase[voice] + ((increment_product + 64'd32768) >> 16);
                    expected_phase[voice] = (reference_phase[voice][31:20] == 12'hfff) ? 12'hfff :
                        reference_phase[voice][31:20] + reference_phase[voice][19];
                    if (note_on[voice])
                    begin
                        on_count = on_count + 1;
                        note_busy[voice] <= 1'b1;
                    end
                    else if (note_off[voice])
                    begin
                        off_count = off_count + 1;
                        note_busy[voice] <= 1'b0;
                    end
                end
            end
            if (phase_valid)
            begin
                for (voice = 0; voice < 3; voice = voice + 1)
                    if (phase[voice] !== expected_phase[voice]) $fatal(1, "相位组声部 %0d 数值或事务错配", voice);
                if (phase_ready) output_count = output_count + 1;
            end
        end
    end
    task send_keys;
        input [23:0] states;
        begin
            @(negedge clk_sys);
            key_states = states;
            in_valid = 1'b1;
            while (!in_ready) @(negedge clk_sys);
            @(negedge clk_sys);
            in_valid = 1'b0;
        end
    endtask
    initial
    begin
        for (voice = 0; voice < 3; voice = voice + 1) reference_phase[voice] = 32'd0;
        for (key_index = 0; key_index < 24; key_index = key_index + 1) key_velocity[key_index] = 16'h8000;
        repeat (3) @(negedge clk_sys);
        rst_n = 1'b1;
        wait (output_count == 5);
        send_keys(24'h000200);
        wait (output_count == 20);
        send_keys(24'h000201);
        wait (output_count == 35);
        send_keys(24'h800201);
        wait (output_count == 50);
        send_keys(24'd0);
        wait (output_count == 100);
        @(negedge clk_sys);
        if (on_count != 3 || off_count != 3) $fatal(1, "重复重触发或漏松开");
        $display("KEYBOARD_PHASE_INTEGRATION_PASS samples=%0d voices=3 on=%0d off=%0d", output_count, on_count, off_count);
        $finish;
    end
    initial
    begin
        #3000000;
        $fatal(1, "键盘相位联仿超时");
    end
endmodule
