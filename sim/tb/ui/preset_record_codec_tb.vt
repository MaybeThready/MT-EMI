/**
 * 独立参考 CRC 按字节计算，验证 16 槽封装／读取、位翻转、版本、槽号、
 * 参数边界、未定义高级字段、输出背压稳定、运算中及待交付结果的异步复位取消。
 * 接收后立即扰动输入，验证CRC准备拍只使用已锁存记录，不延长上游保持义务。
 */
`timescale 1ns/1ps
module preset_record_codec_tb;
    reg clk_sys = 1'b0;
    always #5 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    reg [15:0] balance_gain = 16'd12124;
    wire [15:0] balance_gain_out;
    reg decode = 1'b0;
    reg [3:0] slot = 4'd0;
    reg [191:0] parameters = 192'd0;
    reg [511:0] record_in = 512'd0;
    reg in_valid = 1'b0;
    wire in_ready, out_valid;
    reg out_ready = 1'b0;
    wire [511:0] record_out;
    wire [191:0] parameters_out;
    wire [2:0] status;
    reg [511:0] golden, saved;
    integer i, bit_index;
    integer field_index;
    integer lower_bound [0:11];
    integer upper_bound [0:11];
    preset_record_codec preset_record_codec_u (
        .advanced_parameters(128'h001840008000100090002ee02800b000), .advanced_parameters_out(),
        .clk_sys(clk_sys), .rst_n(rst_n), .decode(decode), .slot(slot),
        .parameters(parameters), .balance_gain(balance_gain), .balance_gain_out(balance_gain_out), .record_in(record_in),
        .in_valid(in_valid), .in_ready(in_ready), .record_out(record_out),
        .parameters_out(parameters_out), .status(status),
        .out_valid(out_valid), .out_ready(out_ready)
    );

    function [15:0] reference_crc;
        input [495:0] data;
        reg [15:0] c;
        integer byte_index, step;
        begin
            c = 16'hffff;
            for (byte_index = 61; byte_index >= 0; byte_index = byte_index - 1)
            begin
                c = c ^ {data[byte_index*8 +: 8], 8'd0};
                for (step = 0; step < 8; step = step + 1)
                    c = c[15] ? (c << 1) ^ 16'h1021 : c << 1;
            end
            reference_crc = c;
        end
    endfunction
    task run_request;
        input do_decode;
        input [2:0] expected_status;
        reg [191:0] accepted_parameters;
        reg [511:0] accepted_record;
        reg [3:0] accepted_slot;
        reg [15:0] accepted_balance;
        begin
            @(negedge clk_sys);
            decode = do_decode;
            in_valid = 1'b1;
            while (!in_ready) @(negedge clk_sys);
            @(negedge clk_sys);
            in_valid = 1'b0;
            accepted_parameters = parameters;
            accepted_record = record_in;
            accepted_slot = slot;
            accepted_balance = balance_gain;
            parameters = ~parameters;
            record_in = ~record_in;
            slot = ~slot;
            balance_gain = ~balance_gain;
            decode = !do_decode;
            wait (out_valid);
            @(negedge clk_sys);
            parameters = accepted_parameters;
            record_in = accepted_record;
            slot = accepted_slot;
            balance_gain = accepted_balance;
            decode = do_decode;
            if (status !== expected_status) $fatal(1, "记录状态错误 got=%0d expected=%0d", status, expected_status);
            saved = record_out;
            repeat (7)
            begin
                @(negedge clk_sys);
                if (!out_valid || record_out !== saved || status !== expected_status)
                    $fatal(1, "背压期间记录改变");
            end
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
        end
    endtask
    initial
    begin
        repeat (3) @(negedge clk_sys);
        rst_n = 1'b1;
        parameters = {16'd100,16'd0,16'd63,16'd27,16'd0,16'd100,16'd2000,16'd1,16'd359,16'd100,16'd3,16'd0};
        for (i = 0; i < 16; i = i + 1)
        begin
            slot = i[3:0];
            balance_gain = (i == 0) ? 16'h0000 : ((i == 1) ? 16'h8000 : ((i == 2) ? 16'hc000 : 16'hffff));
            golden = {112'd0,balance_gain,128'h001840008000100090002ee02800b000,parameters,16'd21,12'd0,slot,16'd5,16'h5549};
            golden[511:496] = reference_crc(golden[495:0]);
            run_request(1'b0, 3'd0);
            if (saved !== golden) $fatal(1, "封装结果不符合独立参考");
            record_in = golden;
            run_request(1'b1, 3'd0);
            if (parameters_out !== parameters || balance_gain_out !== balance_gain) $fatal(1, "读取参数不一致");
        end
        // 新格式原样保存全16位；覆盖0、1、1.5和最大增益。
        for (i = 0; i < 4; i = i + 1)
        begin
            record_in = golden;
            case (i)
                0: record_in[399:384] = 16'h0000;
                1: record_in[399:384] = 16'h8000;
                2: record_in[399:384] = 16'hc000;
                3: record_in[399:384] = 16'hffff;
            endcase
            record_in[511:496] = reference_crc(record_in[495:0]);
            run_request(1'b1, 3'd0);
            if (balance_gain_out !== record_in[399:384]) $fatal(1, "Q15 gain boundary decode");
        end
        // 对格式3/4的每个合法百分比独立计算期望；101与高位污染必须拒绝。
        for (field_index = 3; field_index <= 4; field_index = field_index + 1)
        begin
            for (i = 0; i <= 102; i = i + 1)
            begin
                record_in = golden;
                record_in[31:16] = field_index;
                if (field_index == 3)
                begin
                    record_in[63:48] = 16'd13;
                    record_in[383:256] = 128'd0;
                end
                record_in[399:384] = (i == 102) ? 16'h8000 : i;
                record_in[511:496] = reference_crc(record_in[495:0]);
                run_request(1'b1, (i <= 100) ? 3'd0 : 3'd3);
                if (i <= 100 && balance_gain_out != (i * 32768 + 50) / 100)
                    $fatal(1, "Legacy gain conversion version=%0d percent=%0d", field_index, i);
            end
        end
        for (bit_index = 0; bit_index < 512; bit_index = bit_index + 1)
        begin
            record_in = golden ^ (512'd1 << bit_index);
            run_request(1'b1, 3'd1);
        end
        record_in = golden;
        record_in[31:16] = 16'd2;
        record_in[511:496] = reference_crc(record_in[495:0]);
        run_request(1'b1, 3'd2);
        record_in = golden;
        record_in[47:32] = 16'd0;
        record_in[511:496] = reference_crc(record_in[495:0]);
        run_request(1'b1, 3'd2);
        record_in = golden;
        record_in[79:64] = 16'd4;
        record_in[511:496] = reference_crc(record_in[495:0]);
        run_request(1'b1, 3'd3);
        record_in = golden;
        record_in[400] = 1'b1;
        record_in[511:496] = reference_crc(record_in[495:0]);
        run_request(1'b1, 3'd4);
        record_in = golden;
        record_in[271:256]=16'hf001;
        record_in[511:496]=reference_crc(record_in[495:0]); run_request(1,3);
        record_in = golden;
        record_in[287:272]=16'hf001;
        record_in[511:496]=reference_crc(record_in[495:0]); run_request(1,3);
        record_in = golden;
        record_in[303:288]=0;
        record_in[511:496]=reference_crc(record_in[495:0]); run_request(1,3);
        record_in = golden;
        record_in[319:304]=16'hf001;
        record_in[511:496]=reference_crc(record_in[495:0]); run_request(1,3);
        record_in = golden;
        record_in[335:320]=16'h0fff;
        record_in[511:496]=reference_crc(record_in[495:0]); run_request(1,3);
        record_in = golden;
        record_in[335:320]=16'hf001;
        record_in[511:496]=reference_crc(record_in[495:0]); run_request(1,3);
        record_in = golden;
        record_in[383:368]=256;
        record_in[511:496]=reference_crc(record_in[495:0]); run_request(1,3);
        // 每个字段分别检查最小值、最大值和越界值，CRC 保持正确。
        for (field_index = 0; field_index < 12; field_index = field_index + 1)
        begin
            lower_bound[field_index] = 0;
            upper_bound[field_index] = 100;
        end
        upper_bound[0] = 3;
        upper_bound[1] = 3;
        upper_bound[3] = 359;
        lower_bound[4] = 1;
        lower_bound[5] = 1;
        upper_bound[4] = 2000;
        upper_bound[5] = 2000;
        upper_bound[7] = 5000;
        for (field_index = 0; field_index < 12; field_index = field_index + 1)
        begin
            record_in = golden;
            record_in[64 + field_index * 16 +: 16] = lower_bound[field_index];
            record_in[511:496] = reference_crc(record_in[495:0]);
            run_request(1'b1, 3'd0);
            if (parameters_out !== record_in[255:64]) $fatal(1, "合法下界装载错误");
            record_in[64 + field_index * 16 +: 16] = upper_bound[field_index];
            record_in[511:496] = reference_crc(record_in[495:0]);
            run_request(1'b1, 3'd0);
            if (parameters_out !== record_in[255:64]) $fatal(1, "合法上界装载错误");
            record_in[64 + field_index * 16 +: 16] = upper_bound[field_index] + 1;
            record_in[511:496] = reference_crc(record_in[495:0]);
            run_request(1'b1, 3'd3);
            if (lower_bound[field_index] > 0)
            begin
                record_in[64 + field_index * 16 +: 16] = 16'd0;
                record_in[511:496] = reference_crc(record_in[495:0]);
                run_request(1'b1, 3'd3);
            end
        end
        record_in = golden;
        record_in[15:0] = 16'd0;
        record_in[511:496] = reference_crc(record_in[495:0]);
        run_request(1'b1, 3'd2);
        record_in = golden;
        record_in[63:48] = 16'd12;
        record_in[511:496] = reference_crc(record_in[495:0]);
        run_request(1'b1, 3'd2);
        record_in = golden;
        record_in[480] = 1'b1;
        record_in[511:496] = reference_crc(record_in[495:0]);
        run_request(1'b1, 3'd4);
        @(negedge clk_sys);
        in_valid = 1'b1;
        @(negedge clk_sys);
        in_valid = 1'b0;
        repeat (20) @(negedge clk_sys);
        rst_n = 1'b0;
        @(negedge clk_sys);
        rst_n = 1'b1;
        repeat (510) @(negedge clk_sys);
        if (out_valid || !in_ready) $fatal(1, "复位未取消旧事务");
        // 结果已有效但下游未接收时，在两个时钟沿之间复位。
        record_in = golden;
        @(negedge clk_sys);
        in_valid = 1'b1;
        @(negedge clk_sys);
        in_valid = 1'b0;
        wait (out_valid);
        @(posedge clk_sys);
        #1;
        rst_n = 1'b0;
        in_valid = 1'b1;
        #1;
        if (out_valid !== 1'b0 || in_ready !== 1'b0)
            $fatal(1, "结果未被异步复位取消");
        repeat (3) @(negedge clk_sys);
        in_valid = 1'b0;
        rst_n = 1'b1;
        repeat (510) @(negedge clk_sys);
        if (out_valid || !in_ready) $fatal(1, "复位期间错误接收了请求");
        run_request(1'b1, 3'd0);
        $display("PRESET_RECORD_CODEC_PASS slots=16 bit_errors=512 field_boundaries=12 format_range_extension_reset=PASS");
        $finish;
    end
    initial
    begin
        #10000000;
        $fatal(1, "记录测试超时");
    end
endmodule
