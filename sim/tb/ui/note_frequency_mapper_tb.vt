/** 直接用十二平均律实数表达式核对全部 24 键、非法索引、空声部、背压及复位。 */
`timescale 1ns/1ps
module note_frequency_mapper_tb;
    reg clk_sys = 1'b0;
    always #5 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    reg [4:0] key_id [2:0];
    reg [2:0] occupied = 3'b111;
    reg in_valid = 1'b0;
    wire in_ready, out_valid;
    reg out_ready = 1'b0;
    wire [31:0] note_freq [2:0];
    reg [31:0] expected [2:0];
    integer key_index, voice, stall;
    note_frequency_mapper #(.MAX_POLYPHONY(3)) note_frequency_mapper_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .key_id(key_id), .occupied(occupied),
        .in_valid(in_valid), .in_ready(in_ready), .note_freq(note_freq), .out_valid(out_valid), .out_ready(out_ready)
    );
    initial
    begin
        repeat (3) @(negedge clk_sys);
        rst_n = 1'b1;
        for (key_index = 0; key_index < 64; key_index = key_index + 1)
        begin
            occupied = (key_index < 32) ? 3'b111 : 3'b101;
            for (voice = 0; voice < 3; voice = voice + 1)
            begin
                key_id[voice] = (key_index + voice) % 32;
                expected[voice] = (occupied[voice] && (key_id[voice] < 24)) ?
                    $rtoi(440.0 * (2.0 ** (($itor(key_id[voice]) - 9.0) / 12.0)) * 65536.0 + 0.5) : 0;
            end
            in_valid = 1'b1;
            @(negedge clk_sys);
            in_valid = 1'b0;
            for (voice = 0; voice < 3; voice = voice + 1) key_id[voice] = 5'd31;
            for (stall = 0; stall < 5; stall = stall + 1)
            begin
                if (!out_valid) $fatal(1, "频率结果无效");
                for (voice = 0; voice < 3; voice = voice + 1)
                    if (note_freq[voice] !== expected[voice]) $fatal(1, "音高编码错误");
                @(negedge clk_sys);
            end
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
        end
        rst_n = 1'b0;
        #1;
        if (out_valid || note_freq[0]) $fatal(1, "复位失败");
        $display("NOTE_FREQUENCY_MAPPER_PASS cases=64 voices=3");
        $finish;
    end
endmodule
