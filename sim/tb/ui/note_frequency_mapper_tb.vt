`timescale 1ns/1ps
/** Independent equal-temperament check: every MIDI code0..127, occupied masks,
 * frozen payload under five-cycle backpressure and asynchronous reset. */
module note_frequency_mapper_tb;
    reg clk_sys=0, rst_n=0;
    always #5 clk_sys=~clk_sys;
    reg [6:0] note_number [2:0];
    reg [2:0] occupied=3'b111;
    reg in_valid=0, out_ready=0;
    wire in_ready,out_valid;
    wire [31:0] freq [2:0];
    reg [31:0] expected [2:0];
    integer n,v,s;
    reg test_passed=0;
    note_frequency_mapper #(.MAX_POLYPHONY(3)) dut (
        .clk_sys(clk_sys),.rst_n(rst_n),.note_number(note_number),.occupied(occupied),
        .in_valid(in_valid),.in_ready(in_ready),.note_freq(freq),.out_valid(out_valid),.out_ready(out_ready)
    );
    initial
    begin
        repeat(3) @(negedge clk_sys); rst_n=1;
        for(n=0;n<256;n=n+1)
        begin
            occupied=(n<128) ? 3'b111 : 3'b101;
            for(v=0;v<3;v=v+1)
            begin
                note_number[v]=(n+v)%128;
                expected[v]=(occupied[v] && note_number[v]>=60 && note_number[v]<=90) ?
                    $rtoi(440.0*(2.0**(($itor(note_number[v])-69.0)/12.0))*65536.0+0.5) : 0;
            end
            in_valid=1;
            do @(posedge clk_sys); while(!in_ready);
            @(negedge clk_sys); in_valid=0;
            for(v=0;v<3;v=v+1) note_number[v]=127;
            occupied=0;
            for(s=0;s<5;s=s+1)
            begin
                if(!out_valid) $fatal(1,"frequency valid");
                for(v=0;v<3;v=v+1) if(freq[v]!==expected[v]) $fatal(1,"frequency n=%0d v=%0d",n,v);
                @(negedge clk_sys);
            end
            out_ready=1;
            @(negedge clk_sys); out_ready=0;
        end
        rst_n=0; #1;
        if(out_valid || freq[0]) $fatal(1,"frequency reset");
        test_passed=1;
        $display("NOTE_FREQUENCY_MAPPER_PASS codes=128 masks=2 lanes=3");
        $finish;
    end
endmodule
