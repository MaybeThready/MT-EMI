`timescale 1ns/1ps
/**
 * 自检：有效帧边沿、无变化帧、多键、无效数据、连续 valid、输入等待、
 * 长输出背压、复位取消、复位后重新触发及确定性随机握手。
 * 使用逐键状态转移参考模型和事务队列，不依赖 DUT 内部状态。
 * 参数运行 KEY_NUM=1/3/24；无实际键盘或音频模块，不代表系统联调。
 */
module keyboard_frame_events_tb;
    parameter KEY_NUM = 24;
    parameter RANDOM_SEED = 32'h1379abcd;
    localparam real HALF_PERIOD_NS = 500000000.0 / 98304000.0;

    reg clk;
    reg test_passed;
    reg rst_n;
    reg [KEY_NUM-1:0] key_states;
    reg in_valid;
    reg out_ready;
    wire in_ready;
    wire out_valid;
    wire [KEY_NUM-1:0] press_event;
    wire [KEY_NUM-1:0] release_event;
    wire [KEY_NUM-1:0] frame_states;

    reg [KEY_NUM-1:0] expected_press [0:4095];
    reg [KEY_NUM-1:0] expected_release [0:4095];
    reg [KEY_NUM-1:0] expected_states [0:4095];
    reg [KEY_NUM-1:0] previous_keys;
    reg [KEY_NUM-1:0] one_key;
    reg [KEY_NUM-1:0] high_key;
    reg [KEY_NUM-1:0] random_frame;
    reg random_valid;
    reg last_input_fire;
    reg [31:0] random_state;
    integer write_count;
    integer read_count;
    integer accepted_total;
    integer delivered_total;
    integer canceled_total;
    integer stalled_cycles;
    integer input_wait_cycles;
    integer press_count;
    integer release_count;
    integer bit_index;
    integer iteration;

    keyboard_frame_events #(
        .KEY_NUM(KEY_NUM)
    ) keyboard_frame_events_u (
        .clk(clk),
        .rst_n(rst_n),
        .key_states(key_states),
        .in_valid(in_valid),
        .in_ready(in_ready),
        .press_event(press_event),
        .release_event(release_event),
        .frame_states(frame_states),
        .out_valid(out_valid),
        .out_ready(out_ready)
    );

    initial
    begin
        clk = 1'b0;
        forever #(HALF_PERIOD_NS) clk = ~clk;
    end

    // 在 DUT 非阻塞赋值之前检查本上升沿的事务。
    always @(posedge clk or negedge rst_n)
    begin
        if (!rst_n)
        begin
            if (write_count > read_count)
                canceled_total = canceled_total + write_count - read_count;
            write_count = 0;
            read_count = 0;
            previous_keys = {KEY_NUM{1'b0}};
        end
        else
        begin
            if (out_valid !== (write_count > read_count))
                $fatal(1, "valid/latency mismatch at %t", $time);
            if ((write_count - read_count) > 1)
                $fatal(1, "more than one outstanding frame");
            if ((in_ready !== 1'b0) && (in_ready !== 1'b1))
                $fatal(1, "unknown in_ready");
            if (out_valid && in_ready)
                $fatal(1, "one-frame buffer accepted input while pending");
            if (in_valid && !in_ready)
                input_wait_cycles = input_wait_cycles + 1;

            if (out_valid)
            begin
                if ((press_event !== expected_press[read_count]) ||
                    (release_event !== expected_release[read_count]) ||
                    (frame_states !== expected_states[read_count]))
                    $fatal(1, "payload mismatch at %t frame=%0d", $time, read_count);
                if (|(press_event & release_event))
                    $fatal(1, "same key pressed and released in one frame");

                if (out_ready)
                begin
                    for (bit_index = 0; bit_index < KEY_NUM; bit_index = bit_index + 1)
                    begin
                        if (press_event[bit_index]) press_count = press_count + 1;
                        if (release_event[bit_index]) release_count = release_count + 1;
                    end
                    read_count = read_count + 1;
                    delivered_total = delivered_total + 1;
                end
                else
                    stalled_cycles = stalled_cycles + 1;
            end

            if (in_valid && in_ready)
            begin
                if (write_count >= 4096)
                    $fatal(1, "test reference queue exhausted");
                expected_press[write_count] = {KEY_NUM{1'b0}};
                expected_release[write_count] = {KEY_NUM{1'b0}};
                for (bit_index = 0; bit_index < KEY_NUM; bit_index = bit_index + 1)
                begin
                    case ({previous_keys[bit_index], key_states[bit_index]})
                        2'b01: expected_press[write_count][bit_index] = 1'b1;
                        2'b10: expected_release[write_count][bit_index] = 1'b1;
                        2'b00, 2'b11: ;
                        default: $fatal(1, "unknown valid input frame");
                    endcase
                end
                expected_states[write_count] = key_states;
                previous_keys = key_states;
                write_count = write_count + 1;
                accepted_total = accepted_total + 1;
            end
        end
    end

    task step;
        input valid_value;
        input [KEY_NUM-1:0] frame_value;
        input ready_value;
        begin
            @(negedge clk);
            in_valid = valid_value;
            key_states = frame_value;
            out_ready = ready_value;
            @(posedge clk);
            last_input_fire = in_valid && in_ready;
            #0.001;
        end
    endtask

    task send_and_drain;
        input [KEY_NUM-1:0] frame_value;
        input integer stall_length;
        integer wait_index;
        begin
            step(1'b1, frame_value, 1'b0);
            if (!last_input_fire) $fatal(1, "idle receiver not ready");
            for (wait_index = 0; wait_index < stall_length; wait_index = wait_index + 1)
                step(1'b0, ~frame_value, 1'b0);
            step(1'b0, ~frame_value, 1'b1);
        end
    endtask

    task reset_dut;
        begin
            @(negedge clk);
            in_valid = 1'b0;
            out_ready = 1'b0;
            #1;
            rst_n = 1'b0;
            #0.001;
            if ((in_ready !== 1'b0) || (out_valid !== 1'b0) ||
                (press_event !== {KEY_NUM{1'b0}}) ||
                (release_event !== {KEY_NUM{1'b0}}) ||
                (frame_states !== {KEY_NUM{1'b0}}))
                $fatal(1, "asynchronous reset failed");
            repeat (2) @(posedge clk);
            @(negedge clk);
            rst_n = 1'b1;
        end
    endtask

    task advance_random;
        begin
            random_state = {random_state[30:0], random_state[31] ^
                random_state[21] ^ random_state[1] ^ random_state[0]};
        end
    endtask

    initial
    begin
        test_passed = 1'b0;
        accepted_total = 0;
        delivered_total = 0;
        canceled_total = 0;
        stalled_cycles = 0;
        input_wait_cycles = 0;
        press_count = 0;
        release_count = 0;
        write_count = 0;
        read_count = 0;
        rst_n = 1'b0;
        in_valid = 1'b0;
        out_ready = 1'b0;
        key_states = {KEY_NUM{1'b0}};
        one_key = {KEY_NUM{1'b0}};
        one_key[0] = 1'b1;
        high_key = {KEY_NUM{1'b0}};
        high_key[KEY_NUM-1] = 1'b1;
        random_state = RANDOM_SEED;
        last_input_fire = 1'b0;
        reset_dut;

        // valid=0 时改变所有按键，不能改变历史或输出事件。
        repeat (4) step(1'b0, {KEY_NUM{1'b1}}, 1'b1);
        send_and_drain({KEY_NUM{1'b0}}, 0);
        send_and_drain(one_key, 80);
        repeat (8) send_and_drain(one_key, 0);
        send_and_drain({KEY_NUM{1'b0}}, 2);
        send_and_drain(one_key, 0);
        send_and_drain(high_key, 3);
        send_and_drain({KEY_NUM{1'b1}}, 4);
        send_and_drain({KEY_NUM{1'b0}}, 0);
        $display("DIRECTED_EVENTS_PASS keys=%0d", KEY_NUM);

        // 上游下一帧在背压时持续 valid，握手前一直保持载荷。
        step(1'b1, one_key, 1'b0);
        repeat (12) step(1'b1, {KEY_NUM{1'b0}}, 1'b0);
        step(1'b1, {KEY_NUM{1'b0}}, 1'b1);
        if (last_input_fire) $fatal(1, "input accepted on pending output edge");
        step(1'b1, {KEY_NUM{1'b0}}, 1'b1);
        if (!last_input_fire) $fatal(1, "waiting input was not accepted");
        step(1'b0, one_key, 1'b1);

        // 随机 valid/ready，严格遵守上游保持协议，自动队列检查丢失和重复。
        for (iteration = 0; iteration < 1600; iteration = iteration + 1)
        begin
            advance_random;
            if (!in_valid || last_input_fire)
            begin
                random_valid = random_state[0] | random_state[3];
                random_frame = random_state;
            end
            else
            begin
                random_valid = in_valid;
                random_frame = key_states;
            end
            step(random_valid, random_frame, random_state[5] | random_state[7]);
        end
        while (in_valid && !last_input_fire)
            step(in_valid, key_states, 1'b1);
        step(1'b0, {KEY_NUM{1'b0}}, 1'b1);
        step(1'b0, {KEY_NUM{1'b0}}, 1'b1);
        if (read_count != write_count) $fatal(1, "random traffic not drained");
        $display("RANDOM_HANDSHAKE_PASS keys=%0d seed=%h", KEY_NUM, RANDOM_SEED);

        // 已接收但未消费的帧被异步复位取消，下一帧与全零历史比较。
        step(1'b1, {KEY_NUM{1'b1}}, 1'b0);
        repeat (4) step(1'b0, {KEY_NUM{1'b0}}, 1'b0);
        reset_dut;
        send_and_drain({KEY_NUM{1'b1}}, 0);
        send_and_drain({KEY_NUM{1'b1}}, 0);
        send_and_drain({KEY_NUM{1'b0}}, 0);
        repeat (6) step(1'b0, {KEY_NUM{1'b1}}, 1'b1);

        if (accepted_total != delivered_total + canceled_total)
            $fatal(1, "transaction accounting mismatch");
        if ((canceled_total != 1) || (stalled_cycles < 80) ||
            (input_wait_cycles < 12) || (press_count == 0) || (release_count == 0))
            $fatal(1, "required coverage missing");
        $display("KEYBOARD_FRAME_EVENTS_PASS keys=%0d accepted=%0d delivered=%0d canceled=%0d stall=%0d input_wait=%0d presses=%0d releases=%0d",
            KEY_NUM, accepted_total, delivered_total, canceled_total,
            stalled_cycles, input_wait_cycles, press_count, release_count);
        test_passed = 1'b1;
        #0.001;
        $finish;
    end

    initial
    begin
        #100000;
        $fatal(1, "test watchdog expired");
    end
endmodule
