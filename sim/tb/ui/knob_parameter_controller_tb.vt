`timescale 1ns/1ps
/** knob_parameter_controller 自检：复位、握手背压及数据语义。
 * 参考向量使用整数物理单位独立计算。
 */
module knob_parameter_controller_tb #(parameter WAVE_SELECT_STEPS=4, parameter STALL_SNAPSHOT=1);
    reg clk_sys = 1'b0;
    always #5.086263 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    integer index;
    integer cycle;
    integer count;
    integer file_handle;
    integer scan_count;
    string assets;
    string file_path;
    initial
    begin
        if (!$value$plusargs("ASSETS=%s", assets)) $fatal(1, "Missing ASSETS");
    end
    initial
    begin
        #20000000;
        $fatal(1, "Watchdog timeout");
    end
    reg signed [1:0] knob_delta [7:0];
    reg [7:0] knob_pressed_event = 8'd0;
    reg [1:0] mode = 2'd0;
    reg fine_adjust = 1'b0;
    reg edit_enable = 1'b1;
    reg edit_target = 1'b0;
    reg clear_wave_progress = 1'b0;
    reg in_valid = 1'b0;
    wire in_ready;
    wire frame_done_valid;
    reg frame_done_ready = 1'b0;
    wire configuration_error;
    wire signed [15:0] wave_progress;
    wire parameter_valid;
    reg parameter_ready = 1'b1;
    integer value [0:20];
    integer latest [0:12];
    integer held_snapshot [0:12];
    reg stalled = 1'b0;
    integer monitor_index;
    integer completions = 0;
    wire [3:0] wavetable_0 [0:0];
    wire [3:0] wavetable_1 [0:0];
    wire [6:0] interp_percent [0:0];
    wire [8:0] phase_degrees [0:0];
    wire [10:0] attack_ms [0:0];
    wire [10:0] decay_ms [0:0];
    wire [6:0] sustain_percent [0:0];
    wire [12:0] release_ms [0:0];
    wire [6:0] master_percent;
    wire [6:0] reverb_mix_percent;
    wire [6:0] delay_mix_percent;
    wire [6:0] distortion_mix_percent;
    wire [6:0] chorus_mix_percent;
    knob_parameter_controller #(
        .WAVE_SELECT_STEPS(WAVE_SELECT_STEPS)
    ) knob_parameter_controller_u (
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .knob_delta(knob_delta),
        .knob_pressed_event(knob_pressed_event),
        .mode(mode),
        .fine_adjust(fine_adjust),
        .edit_enable(edit_enable),
        .edit_target(edit_target),
        .clear_wave_progress(clear_wave_progress),
        .in_valid(in_valid),
        .in_ready(in_ready),
        .frame_done_valid(frame_done_valid),
        .frame_done_ready(frame_done_ready),
        .configuration_error(configuration_error),
        .wave_progress(wave_progress),
        .parameter_valid(parameter_valid),
        .parameter_ready(parameter_ready),
        .wavetable_0(wavetable_0),
        .wavetable_1(wavetable_1),
        .interp_percent(interp_percent),
        .phase_degrees(phase_degrees),
        .attack_ms(attack_ms),
        .decay_ms(decay_ms),
        .sustain_percent(sustain_percent),
        .release_ms(release_ms),
        .master_percent(master_percent),
        .reverb_mix_percent(reverb_mix_percent),
        .delay_mix_percent(delay_mix_percent),
        .distortion_mix_percent(distortion_mix_percent),
        .chorus_mix_percent(chorus_mix_percent)
    );

    task reset_dut;
        begin
            @(negedge clk_sys);
            rst_n = 1'b0;
            repeat (3) @(negedge clk_sys);
            rst_n = 1'b1;
            #1;
        end
    endtask
    always @(posedge clk_sys)
    begin
        if (!rst_n) stalled = 1'b0;
        else
        begin
            if (stalled)
            begin
                if (!parameter_valid) $fatal(1,"Snapshot valid withdrawn");
                if (wavetable_0[0] !== held_snapshot[0][3:0]) $fatal(1,"Stalled wavetable_0 changed");
                if (wavetable_1[0] !== held_snapshot[1][3:0]) $fatal(1,"Stalled wavetable_1 changed");
                if (interp_percent[0] !== held_snapshot[2][6:0]) $fatal(1,"Stalled interp_percent changed");
                if (phase_degrees[0] !== held_snapshot[3][8:0]) $fatal(1,"Stalled phase_degrees changed");
                if (attack_ms[0] !== held_snapshot[4][10:0]) $fatal(1,"Stalled attack_ms changed");
                if (decay_ms[0] !== held_snapshot[5][10:0]) $fatal(1,"Stalled decay_ms changed");
                if (sustain_percent[0] !== held_snapshot[6][6:0]) $fatal(1,"Stalled sustain_percent changed");
                if (release_ms[0] !== held_snapshot[7][12:0]) $fatal(1,"Stalled release_ms changed");
                if (master_percent !== held_snapshot[8][6:0]) $fatal(1,"Stalled master_percent changed");
                if (reverb_mix_percent !== held_snapshot[9][6:0]) $fatal(1,"Stalled reverb_mix_percent changed");
                if (delay_mix_percent !== held_snapshot[10][6:0]) $fatal(1,"Stalled delay_mix_percent changed");
                if (distortion_mix_percent !== held_snapshot[11][6:0]) $fatal(1,"Stalled distortion_mix_percent changed");
                if (chorus_mix_percent !== held_snapshot[12][6:0]) $fatal(1,"Stalled chorus_mix_percent changed");
            end
            stalled = parameter_valid && !parameter_ready;
            if (parameter_valid)
            begin
                held_snapshot[0] = wavetable_0[0];
                held_snapshot[1] = wavetable_1[0];
                held_snapshot[2] = interp_percent[0];
                held_snapshot[3] = phase_degrees[0];
                held_snapshot[4] = attack_ms[0];
                held_snapshot[5] = decay_ms[0];
                held_snapshot[6] = sustain_percent[0];
                held_snapshot[7] = release_ms[0];
                held_snapshot[8] = master_percent;
                held_snapshot[9] = reverb_mix_percent;
                held_snapshot[10] = delay_mix_percent;
                held_snapshot[11] = distortion_mix_percent;
                held_snapshot[12] = chorus_mix_percent;
            end
            if (parameter_valid && parameter_ready)
            begin
                latest[0] = wavetable_0[0];
                latest[1] = wavetable_1[0];
                latest[2] = interp_percent[0];
                latest[3] = phase_degrees[0];
                latest[4] = attack_ms[0];
                latest[5] = decay_ms[0];
                latest[6] = sustain_percent[0];
                latest[7] = release_ms[0];
                latest[8] = master_percent;
                latest[9] = reverb_mix_percent;
                latest[10] = delay_mix_percent;
                latest[11] = distortion_mix_percent;
                latest[12] = chorus_mix_percent;
            end
            if (frame_done_valid && frame_done_ready) completions = completions + 1;
        end
    end
    initial
    begin
        for (index=0;index<8;index=index+1) knob_delta[index]=2'sd0;
        #1;
        if ((WAVE_SELECT_STEPS<1) || (WAVE_SELECT_STEPS>32767))
        begin
            reset_dut;
            in_valid=1'b1;
            repeat (10) @(negedge clk_sys);
            if (!configuration_error || in_ready || frame_done_valid)
                $fatal(1,"Invalid threshold was silently accepted");
            $display("KNOB_PARAMETER_CONTROLLER_CONFIG_PASS steps=%0d",WAVE_SELECT_STEPS);
            $finish;
        end
        file_path=$sformatf("%s/bank_%0d.txt",assets,WAVE_SELECT_STEPS);
        file_handle=$fopen(file_path,"r");
        if (!file_handle) $fatal(1,"Missing bank vectors");
        reset_dut;
        repeat (6) @(negedge clk_sys);
        if (latest[0] != 0) $fatal(1,"Startup default wavetable_0");
        if (latest[1] != 1) $fatal(1,"Startup default wavetable_1");
        if (latest[2] != 0) $fatal(1,"Startup default interp_percent");
        if (latest[3] != 0) $fatal(1,"Startup default phase_degrees");
        if (latest[4] != 5) $fatal(1,"Startup default attack_ms");
        if (latest[5] != 150) $fatal(1,"Startup default decay_ms");
        if (latest[6] != 70) $fatal(1,"Startup default sustain_percent");
        if (latest[7] != 200) $fatal(1,"Startup default release_ms");
        if (latest[8] != 30) $fatal(1,"Startup default master_percent");
        if (latest[9] != 0) $fatal(1,"Startup default reverb_mix_percent");
        if (latest[10] != 0) $fatal(1,"Startup default delay_mix_percent");
        if (latest[11] != 0) $fatal(1,"Startup default distortion_mix_percent");
        if (latest[12] != 0) $fatal(1,"Startup default chorus_mix_percent");
        for (index=0;index<4800;index=index+1)
        begin
            scan_count=$fscanf(file_handle,"%d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d",value[0],value[1],value[2],value[3],value[4],value[5],value[6],value[7],value[8],value[9],value[10],value[11],value[12],value[13],value[14],value[15],value[16],value[17],value[18],value[19],value[20]);
            if (scan_count != 21) $fatal(1,"Bad bank vector %0d",index);
            @(negedge clk_sys);
            // 使用十帧突发验证编码器阻塞时仍能完成本地提交。
            parameter_ready=!STALL_SNAPSHOT || (index%10==9);
            mode=value[0];fine_adjust=value[1];edit_enable=value[2];edit_target=value[3];
            clear_wave_progress=value[4];knob_pressed_event=value[5];
            for (cycle=0;cycle<8;cycle=cycle+1) knob_delta[cycle]=(value[6]>>(2*cycle));
            in_valid=1'b1;
            do @(posedge clk_sys); while (!in_ready);
            @(negedge clk_sys);
            in_valid=1'b0;
            while (!frame_done_valid) @(negedge clk_sys);
            if (configuration_error || !frame_done_valid || $signed(wave_progress) != value[20])
                $fatal(1,"Bank completion/progress mismatch frame %0d",index);
            for (cycle=0;cycle<index%4;cycle=cycle+1)
            begin
                @(negedge clk_sys);
                if (!frame_done_valid || in_ready) $fatal(1,"Done not held");
            end
            frame_done_ready=1'b1;
            @(negedge clk_sys);
            frame_done_ready=1'b0;
            if (frame_done_valid) $fatal(1,"Duplicate done");
            if (parameter_ready)
            begin
                repeat (5) @(negedge clk_sys);
                for (cycle=0;cycle<13;cycle=cycle+1)
                    if (latest[cycle] !== value[cycle+7])
                        $fatal(1,"Bank value frame %0d field %0d expected %0d got %0d",index,cycle,value[cycle+7],latest[cycle]);
            end
        end
        if (completions != 4800) $fatal(1,"Completion count %0d",completions);
        // 复位取消未确认的本地完成应答和被阻塞的快照。
        parameter_ready=1'b0;
        in_valid=1'b1;
        do @(posedge clk_sys); while (!in_ready);
        @(negedge clk_sys);
        in_valid=1'b0;
        while (!frame_done_valid) @(negedge clk_sys);
        if (!frame_done_valid) $fatal(1,"No pending completion for reset test");
        reset_dut;
        if (frame_done_valid) $fatal(1,"Reset did not cancel completion");
        parameter_ready=1'b1;
        repeat (6) @(negedge clk_sys);
        if (latest[0] != 0) $fatal(1,"Reset default wavetable_0");
        if (latest[1] != 1) $fatal(1,"Reset default wavetable_1");
        if (latest[2] != 0) $fatal(1,"Reset default interp_percent");
        if (latest[3] != 0) $fatal(1,"Reset default phase_degrees");
        if (latest[4] != 5) $fatal(1,"Reset default attack_ms");
        if (latest[5] != 150) $fatal(1,"Reset default decay_ms");
        if (latest[6] != 70) $fatal(1,"Reset default sustain_percent");
        if (latest[7] != 200) $fatal(1,"Reset default release_ms");
        if (latest[8] != 30) $fatal(1,"Reset default master_percent");
        if (latest[9] != 0) $fatal(1,"Reset default reverb_mix_percent");
        if (latest[10] != 0) $fatal(1,"Reset default delay_mix_percent");
        if (latest[11] != 0) $fatal(1,"Reset default distortion_mix_percent");
        if (latest[12] != 0) $fatal(1,"Reset default chorus_mix_percent");
        $display("KNOB_PARAMETER_CONTROLLER_PASS steps=%0d stalled=%0d frames=4800",WAVE_SELECT_STEPS,STALL_SNAPSHOT);
        $finish;
    end
endmodule
