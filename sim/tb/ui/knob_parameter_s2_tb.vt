`timescale 1ns/1ps
/** S2高级参数自检：四效果上下界、单旋钮默认、效果恢复、快照背压与原子加载。
 * 仅通过公开接口验证；不强制DUT内部寄存器。
 */
module knob_parameter_s2_tb;
    reg clk_sys = 1'b0;
    reg rst_n = 1'b0;
    always #5 clk_sys = ~clk_sys;
    reg signed [1:0] knob_delta [7:0];
    reg [7:0] knob_pressed_event = 8'd0;
    reg [1:0] effect_select = 2'd0;
    reg [1:0] mode = 2'd2;
    reg effect_reset = 1'b0;
    reg in_valid = 1'b0;
    wire in_ready;
    wire frame_done_valid;
    wire parameter_valid;
    reg parameter_ready = 1'b1;
    reg load_valid = 1'b0;
    wire load_ready;
    wire [127:0] advanced, current_advanced;
    reg [127:0] held;
    wire [15:0] master, balance;
    wire [63:0] make_up_gains, current_make_up;
    wire [191:0] current_base;
    reg test_passed = 1'b0;
    integer i, effect_index, j;
    reg [127:0] wanted;
    reg [127:0] load_advanced = 128'h001840008000100090002ee02800b000;
    integer field_index, delivered_before;
    integer delivered = 0;
    always @(posedge clk_sys)
        if (rst_n && parameter_valid && parameter_ready) delivered = delivered + 1;
    localparam [127:0] DEFAULTS = 128'h001840008000100090002ee02800b000;
    localparam [127:0] MAXIMUMS = 128'h00ffffffffffF000f000fffff000f000;
    localparam [127:0] MINIMUMS = 128'h00000000000010000000000100000000;
    knob_parameter_controller #(.WAVE_SELECT_STEPS(4)) knob_parameter_controller_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .knob_delta(knob_delta),
        .knob_pressed_event(knob_pressed_event), .mode(mode), .fine_adjust(1'b0),
        .edit_enable(1'b1), .edit_target(1'b0), .clear_wave_progress(1'b0),
        .effect_select(effect_select), .effect_reset(effect_reset),
        .in_valid(in_valid), .in_ready(in_ready), .frame_done_valid(frame_done_valid), .frame_done_ready(1'b1),
        .advanced_parameters(advanced), .preset_current_advanced(current_advanced),
        .make_up_gains(make_up_gains), .preset_current_make_up(current_make_up),
        .preset_load_make_up({4{16'h8000}}),
        .master_gain(master), .balance_gain(balance),
        .parameter_valid(parameter_valid), .parameter_ready(parameter_ready),
        .preset_load_valid(load_valid), .preset_load_ready(load_ready),
        .preset_load_parameters(current_base), .preset_current_parameters(current_base),
        .preset_load_balance_gain(16'd12124), .preset_current_balance_gain(),
        .preset_load_advanced(load_advanced),
        .configuration_error(), .wave_progress(), .wavetable_0(), .wavetable_1(),
        .interp_percent(), .phase_degrees(), .attack_ms(), .decay_ms(),
        .sustain_percent(), .release_ms(), .reverb_mix_percent(), .delay_mix_percent(),
        .distortion_mix_percent(), .chorus_mix_percent(),
        .display_master_gain(), .display_update(), .display_activity_mask(), .display_reset_mask()
    );
    task event_frame;
        input signed [1:0] delta;
        input [7:0] presses;
        input reset_effect;
        begin
            @(negedge clk_sys);
            for (integer lane=0;lane<8;lane=lane+1) knob_delta[lane]=0;
            knob_delta[0]=delta; knob_delta[1]=delta;
            knob_pressed_event=presses; effect_reset=reset_effect; in_valid=1;
            do @(posedge clk_sys); while(!in_ready);
            @(negedge clk_sys); in_valid=0;
            wait(frame_done_valid);
            @(negedge clk_sys);
        end
    endtask
    task effect_knob;
        input integer lane;
        input signed [1:0] delta;
        input [7:0] presses;
        input reset_effect;
        begin
            @(negedge clk_sys);
            for (integer k=0;k<8;k=k+1) knob_delta[k]=0;
            knob_delta[lane]=delta;
            knob_pressed_event=presses; effect_reset=reset_effect; in_valid=1;
            do @(posedge clk_sys); while(!in_ready);
            @(negedge clk_sys); in_valid=0;
            wait(frame_done_valid);
            @(negedge clk_sys);
        end
    endtask
    initial
    begin
        for(i=0;i<8;i=i+1) knob_delta[i]=0;
        repeat(4) @(negedge clk_sys); rst_n=1;
        repeat(20) @(negedge clk_sys);
        wanted=DEFAULTS;
        for(effect_index=0;effect_index<4;effect_index=effect_index+1)
        begin
            effect_select=effect_index;
            for(j=0;j<300;j=j+1) event_frame(1,0,0);
            wanted[32*effect_index +:32]=MAXIMUMS[32*effect_index +:32];
            if(current_advanced!==wanted) $fatal(1,"Effect upper clamp index=%0d got=%h want=%h",effect_index,current_advanced,wanted);
            for(j=0;j<300;j=j+1) event_frame(-1,0,0);
            wanted[32*effect_index +:32]=MINIMUMS[32*effect_index +:32];
            if(current_advanced!==wanted) $fatal(1,"Effect lower clamp index=%0d",effect_index);
            event_frame(1,1,0); // press beats rotation for K1; K2 still rotates
            if(current_advanced[32*effect_index +:16]!==DEFAULTS[32*effect_index +:16]) $fatal(1,"K1 default priority");
            event_frame(0,2,0);
            wanted[32*effect_index +:32]=DEFAULTS[32*effect_index +:32];
            if(current_advanced!==wanted) $fatal(1,"K2 default");
            event_frame(1,0,0); event_frame(1,0,1);
            if(current_advanced!==wanted) $fatal(1,"Effect reset priority");
            mode=2'd1;
            effect_knob(4+effect_index,1,0,0);
            if(current_base[128+16*effect_index +: 16] !== 16'd5)
                $fatal(1,"Performance mix edit effect=%0d", effect_index);
            mode=2'd2;
            effect_knob(2,1,0,0);
            if(current_base[128+16*effect_index +: 16] !== 16'd10)
                $fatal(1,"Advanced K3 must edit same mix effect=%0d", effect_index);
            effect_knob(3,1,0,0);
            if(current_make_up[16*effect_index +: 16] !== 16'h8666)
                $fatal(1,"Advanced K4 gain effect=%0d", effect_index);
            effect_knob(2,0,8'd4,0);
            effect_knob(3,0,8'd8,0);
            if(current_base[128+16*effect_index +: 16] !== 16'd0 ||
                current_make_up[16*effect_index +: 16] !== 16'h8000)
                $fatal(1,"K3/K4 press defaults effect=%0d", effect_index);
            effect_knob(2,1,0,0);
            effect_knob(3,1,0,0);
            effect_knob(0,0,0,1);
            if(current_base[128+16*effect_index +: 16] !== 16'd0 ||
                current_make_up[16*effect_index +: 16] !== 16'h8000)
                $fatal(1,"Effect reset K3/K4 effect=%0d", effect_index);
        end
        repeat(20) @(negedge clk_sys);
        // 各字段仅改变最低一位，再只恢复该旋钮；八组变化必须分别触发新快照。
        for (field_index = 0; field_index < 8; field_index = field_index + 1)
        begin
            load_advanced = DEFAULTS ^ (128'd1 << (16*field_index));
            load_valid = 1'b1;
            do @(posedge clk_sys); while (!load_ready);
            @(negedge clk_sys); load_valid = 1'b0;
            repeat (20) @(negedge clk_sys);
            delivered_before = delivered;
            effect_select = field_index / 2;
            event_frame(0, 8'd1 << (field_index % 2), 0);
            repeat (20) @(negedge clk_sys);
            if (advanced !== DEFAULTS || delivered == delivered_before)
                $fatal(1, "Per-field change detection lost snapshot field=%0d", field_index);
            delivered_before = delivered;
            event_frame(0, 0, 0);
            repeat (20) @(negedge clk_sys);
            if (delivered != delivered_before) $fatal(1, "Unchanged frame emitted duplicate snapshot");
        end
        load_advanced = DEFAULTS;
        parameter_ready=0;
        event_frame(1,0,0);
        wait(parameter_valid); @(negedge clk_sys); held=advanced;
        event_frame(1,0,0);
        repeat(10) begin @(negedge clk_sys); if(!parameter_valid || advanced!==held) $fatal(1,"Advanced snapshot backpressure"); end
        load_valid=1;
        do @(posedge clk_sys); while(!load_ready);
        @(negedge clk_sys); load_valid=0;
        if(current_advanced!==DEFAULTS || master!=32768) $fatal(1,"Atomic advanced load/master preservation");
        if(advanced!==held) $fatal(1,"Load overwrote stalled snapshot");
        parameter_ready=1; repeat(25) @(negedge clk_sys);
        if(advanced!==DEFAULTS || balance!=12124 || master!=32768) $fatal(1,"Loaded advanced snapshot lost");
        test_passed=1;
        $display("KNOB_S2_PASS all_effect_bounds K3_shared_mix K4_make_up defaults reset_priority stalled_snapshot atomic_load master_preserved");
        $finish;
    end
    initial begin #1000000; $fatal(1,"S2 bank timeout"); end
endmodule
