`timescale 1ns/1ps
/** 两声部分配优先级与有效反馈回收：最低空闲、最老已松开、最老按住。 */
module voice_priority_feedback_tb;
    reg clk_sys = 0, rst_n = 0;
    always #5 clk_sys = ~clk_sys;
    reg [3:0] presses = 0, releases = 0;
    reg in_valid = 0, out_ready = 0, feedback_valid = 0;
    reg [1:0] busy = 0;
    wire in_ready, out_valid, feedback_done;
    wire [1:0] note_on, note_off, occupied, held;
    wire [1:0] owner [1:0];
    reg test_passed = 0;
    keyboard_voice_allocator #(.KEY_NUM(4), .MAX_POLYPHONY(2)) keyboard_voice_allocator_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .press_event(presses), .release_event(releases),
        .note_busy(busy), .note_busy_valid(feedback_valid), .feedback_done(feedback_done),
        .in_valid(in_valid), .in_ready(in_ready), .out_valid(out_valid), .out_ready(out_ready),
        .note_on(note_on), .note_off(note_off), .key_id(owner), .occupied(occupied), .held(held)
    );
    task event_frame;
        input [3:0] p, r;
        input [1:0] expected_on, expected_off;
        begin
            @(negedge clk_sys); presses = p; releases = r; in_valid = 1;
            do @(posedge clk_sys); while (!in_ready);
            @(negedge clk_sys); in_valid = 0;
            wait (out_valid);
            if (note_on !== expected_on || note_off !== expected_off) $fatal(1, "Priority mismatch");
            @(negedge clk_sys); out_ready = 1;
            @(negedge clk_sys); out_ready = 0; busy = 2'b11; feedback_valid = 1;
            @(negedge clk_sys); feedback_valid = 0;
            wait (feedback_done); @(negedge clk_sys);
        end
    endtask
    initial
    begin
        repeat (3) @(negedge clk_sys); rst_n = 1;
        event_frame(1,0,1,0);
        event_frame(2,0,2,0);
        event_frame(0,1,0,1);
        event_frame(4,0,1,0);
        if (owner[0] != 2) $fatal(1, "Old released voice not replaced");
        event_frame(8,0,2,0);
        if (owner[1] != 3) $fatal(1, "Old held voice not replaced");
        event_frame(0,2,0,0); // 被抢占旧键不能释放新音
        test_passed = 1;
        $display("VOICE_PRIORITY_FEEDBACK_PASS lowest_free oldest_released oldest_held old_key_protection");
        $finish;
    end
    initial begin #100000; $fatal(1, "Priority watchdog"); end
endmodule
