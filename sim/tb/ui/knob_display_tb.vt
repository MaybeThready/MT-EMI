`timescale 1ns/1ps
/** Verify all22 display parameter IDs through real public knob actions,
 * including same-default resets, disabled edits and effect-wide reset masks.
 */
module knob_display_tb;
    reg clk_sys=0;
    always #5 clk_sys=~clk_sys;
    reg rst_n=0,in_valid=0,edit_enable=1,effect_reset=0;
    reg [1:0] mode=0,effect_select=0;
    reg signed [1:0] knob_delta[7:0];
    reg [7:0] knob_pressed_event=0;
    wire in_ready,frame_done_valid,display_update;
    wire [21:0] activity,defaults;
    wire [15:0] display_master_gain;
    reg test_passed=0;
    knob_parameter_controller #(.WAVE_SELECT_STEPS(4)) knob_parameter_controller_u (
        .clk_sys(clk_sys),.rst_n(rst_n),.mode(mode),.fine_adjust(1'b0),
        .edit_enable(edit_enable),.edit_target(1'b0),.clear_wave_progress(1'b0),
        .effect_select(effect_select),.effect_reset(effect_reset),.in_valid(in_valid),.in_ready(in_ready),
        .knob_delta(knob_delta),.knob_pressed_event(knob_pressed_event),
        .frame_done_valid(frame_done_valid),.frame_done_ready(1'b1),
        .parameter_ready(1'b1),.preset_load_valid(1'b0),.preset_load_parameters(192'd0),
        .preset_load_advanced(128'd0),.preset_load_balance_gain(16'h8000),
        .preset_load_make_up({4{16'h8000}}),.preset_current_make_up(),.make_up_gains(),
        .display_master_gain(display_master_gain),.display_update(display_update),
        .display_activity_mask(activity),.display_reset_mask(defaults),
        .configuration_error(),
        .wave_progress(),
        .wavetable_0(),
        .wavetable_1(),
        .interp_percent(),
        .phase_degrees(),
        .attack_ms(),
        .decay_ms(),
        .sustain_percent(),
        .release_ms(),
        .master_gain(),
        .balance_gain(),
        .reverb_mix_percent(),
        .delay_mix_percent(),
        .distortion_mix_percent(),
        .chorus_mix_percent(),
        .advanced_parameters(),
        .preset_current_advanced(),
        .parameter_valid(),
        .preset_load_ready(),
        .preset_current_balance_gain(),
        .preset_current_parameters()
    );
    integer i,n;
    task action;
        input [21:0] expected_activity,expected_reset;
        begin
            @(negedge clk_sys); in_valid=1;
            do @(posedge clk_sys); while(!in_ready);
            @(negedge clk_sys); in_valid=0;
            wait(display_update); @(negedge clk_sys);
            if(activity!==expected_activity || defaults!==expected_reset)
                $fatal(1,"display mask got=%h/%h wanted=%h/%h mode=%0d",activity,defaults,expected_activity,expected_reset,mode);
            wait(frame_done_valid); repeat(3) @(negedge clk_sys);
        end
    endtask
    initial
    begin
        for(i=0;i<8;i=i+1) knob_delta[i]=0;
        repeat(3) @(negedge clk_sys); rst_n=1;
        // At defaults, every pressed knob must still generate a reset event.
        knob_pressed_event=8'hff; action(22'h3f5,22'h3f5);
        mode=1; action(22'h3c3a,22'h3c3a);
        knob_pressed_event=0; edit_enable=0;
        for(i=0;i<8;i=i+1) knob_delta[i]=1;
        action(0,0);
        for(i=0;i<8;i=i+1) knob_delta[i]=0;
        mode=2; edit_enable=1; knob_pressed_event=3;
        for(n=0;n<4;n=n+1)
        begin
            effect_select=n;
            action(22'h3 << (14+2*n),22'h3 << (14+2*n));
        end
        knob_pressed_event=0; edit_enable=0; effect_reset=1; effect_select=2;
        action((22'h3<<18)|(22'h1<<12),(22'h3<<18)|(22'h1<<12));
        if(display_master_gain!==16'h8000) $fatal(1,"unrelated actions changed master");
        test_passed=1;
        $display("KNOB_DISPLAY_PASS all22 same_default disabled effect_reset");
        $finish;
    end
    initial
    begin
        #100000;
        $fatal(1,"knob display watchdog");
    end
endmodule
