`timescale 1ns/1ps
/** Independent consumers stall a shared context; verifies exactly-once delivery,
 * batch identity across32-bit-style wrap (4-bit test), submenu/mode and cancellation.
 */
module chord_context_tb;
    localparam BATCH_ID_WIDTH=4;
    reg clk_sys;
    reg rst_n;
    wire scan_tick_up;
    assign scan_tick_up='0;
    reg [3:0] button_states;
    reg [BATCH_ID_WIDTH-1:0] button_batch_id;
    wire button_batch_last;
    assign button_batch_last=1'b1;
    reg button_in_valid;
    wire button_in_ready;
    wire [7:0] knob_states;
    assign knob_states='0;
    wire [7:0] knob_dirs;
    assign knob_dirs='0;
    wire [7:0] knob_pressed;
    assign knob_pressed='0;
    reg [BATCH_ID_WIDTH-1:0] knob_batch_id;
    wire knob_batch_last;
    assign knob_batch_last=1'b1;
    reg knob_in_valid;
    wire knob_in_ready;
    wire [3:0] wavetable_0 [0:0];
    wire [3:0] wavetable_1 [0:0];
    wire [15:0] wavetable_interp [0:0];
    wire [15:0] init_phase [0:0];
    wire [19:0] attack_ticks [0:0];
    wire [19:0] decay_ticks [0:0];
    wire [15:0] sustain_level [0:0];
    wire [19:0] release_ticks [0:0];
    wire [15:0] master_volume;
    wire [15:0] reverb_feedback;
    wire [15:0] reverb_damping;
    wire [15:0] delay_time;
    wire [15:0] delay_feedback;
    wire [15:0] distortion_gain;
    wire [15:0] distortion_tone;
    wire [15:0] chorus_rate;
    wire [7:0] chorus_depth;
    wire [15:0] balance_volume;
    wire [15:0] reverb_mix;
    wire [15:0] delay_mix;
    wire [15:0] distortion_mix;
    wire [15:0] chorus_mix;
    wire out_valid;
    reg out_ready;
    wire protocol_error;
    wire configuration_error;
    wire storage_out_valid;
    wire storage_out_ready;
    assign storage_out_ready='0;
    wire storage_out_write;
    wire [3:0] storage_out_slot;
    wire [511:0] storage_out_data;
    wire storage_in_valid;
    assign storage_in_valid='0;
    wire storage_in_ready;
    wire [2:0] storage_in_status;
    assign storage_in_status='0;
    wire [511:0] storage_in_data;
    assign storage_in_data='0;
    wire [1:0] menu_effect;
    wire menu_effect_reset;
    wire [127:0] menu_advanced_parameters;
    wire [2:0] menu_page;
    wire [1:0] menu_selection;
    wire [3:0] menu_slot;
    wire menu_save;
    wire [3:0] menu_result_status;
    wire storage_catalog_valid;
    assign storage_catalog_valid='0;
    wire [15:0] storage_slot_present;
    assign storage_slot_present='0;
    wire menu_slot_known;
    wire menu_slot_present;
    wire display_model_commit;
    wire keyboard_context_valid;
    reg keyboard_context_ready;
    wire [BATCH_ID_WIDTH-1:0] keyboard_context_batch_id;
    wire keyboard_context_play_mode;
    wire [512:0] display_model_payload;

    always #5 clk_sys=~clk_sys;
    integer batch,joiner_count=0,keyboard_count=0,old_joiner,old_keyboard,cycles;
    reg bd,kd,test_passed=0;
    reg [3:0] chosen_buttons;
    ui_control_pipeline #(.BATCH_ID_WIDTH(4),.WAVE_SELECT_STEPS(4)) dut(
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .scan_tick_up(scan_tick_up),
        .button_states(button_states),
        .button_batch_id(button_batch_id),
        .button_batch_last(button_batch_last),
        .button_in_valid(button_in_valid),
        .button_in_ready(button_in_ready),
        .knob_states(knob_states),
        .knob_dirs(knob_dirs),
        .knob_pressed(knob_pressed),
        .knob_batch_id(knob_batch_id),
        .knob_batch_last(knob_batch_last),
        .knob_in_valid(knob_in_valid),
        .knob_in_ready(knob_in_ready),
        .wavetable_0(wavetable_0),
        .wavetable_1(wavetable_1),
        .wavetable_interp(wavetable_interp),
        .init_phase(init_phase),
        .attack_ticks(attack_ticks),
        .decay_ticks(decay_ticks),
        .sustain_level(sustain_level),
        .release_ticks(release_ticks),
        .master_volume(master_volume),
        .reverb_feedback(reverb_feedback),
        .reverb_damping(reverb_damping),
        .delay_time(delay_time),
        .delay_feedback(delay_feedback),
        .distortion_gain(distortion_gain),
        .distortion_tone(distortion_tone),
        .chorus_rate(chorus_rate),
        .chorus_depth(chorus_depth),
        .balance_volume(balance_volume),
        .reverb_mix(reverb_mix),
        .delay_mix(delay_mix),
        .distortion_mix(distortion_mix),
        .chorus_mix(chorus_mix),
        .reverb_make_up(), .delay_make_up(), .distortion_make_up(), .chorus_make_up(),
        .out_valid(out_valid),
        .out_ready(out_ready),
        .protocol_error(protocol_error),
        .configuration_error(configuration_error),
        .storage_out_valid(storage_out_valid),
        .storage_out_ready(storage_out_ready),
        .storage_out_write(storage_out_write),
        .storage_out_slot(storage_out_slot),
        .storage_out_data(storage_out_data),
        .storage_in_valid(storage_in_valid),
        .storage_in_ready(storage_in_ready),
        .storage_in_status(storage_in_status),
        .storage_in_data(storage_in_data),
        .menu_effect(menu_effect),
        .menu_effect_reset(menu_effect_reset),
        .menu_advanced_parameters(menu_advanced_parameters),
        .menu_page(menu_page),
        .menu_selection(menu_selection),
        .menu_slot(menu_slot),
        .menu_save(menu_save),
        .menu_result_status(menu_result_status),
        .storage_catalog_valid(storage_catalog_valid),
        .storage_slot_present(storage_slot_present),
        .menu_slot_known(menu_slot_known),
        .menu_slot_present(menu_slot_present),
        .display_model_commit(display_model_commit),
        .keyboard_context_valid(keyboard_context_valid),
        .keyboard_context_ready(keyboard_context_ready),
        .keyboard_context_batch_id(keyboard_context_batch_id),
        .keyboard_context_play_mode(keyboard_context_play_mode),
        .display_model_payload(display_model_payload)
    );
    always @(posedge clk_sys)
    begin
        if(rst_n)
        begin
            if(protocol_error || configuration_error) $fatal(1,"context protocol/configuration");
            if(dut.context_valid && dut.context_ready) joiner_count=joiner_count+1;
            if(keyboard_context_valid && keyboard_context_ready) keyboard_count=keyboard_count+1;
        end
    end
    initial
    begin
        clk_sys=0; rst_n=0; button_states=0; button_batch_id=0; knob_batch_id=0;
        button_in_valid=0; knob_in_valid=0; keyboard_context_ready=0; out_ready=1;
        repeat(4) @(negedge clk_sys); rst_n=1;
        for(batch=0;batch<40;batch=batch+1)
        begin
            case(batch%8)
                1,3,7:chosen_buttons=1;
                5:chosen_buttons=4;
                default:chosen_buttons=0;
            endcase
            old_joiner=joiner_count; old_keyboard=keyboard_count;
            @(negedge clk_sys);
            button_states=chosen_buttons; button_batch_id=batch%16; knob_batch_id=batch%16;
            button_in_valid=1; knob_in_valid=1; bd=0; kd=0;
            while(!bd || !kd)
            begin
                @(posedge clk_sys);
                if(button_in_valid && button_in_ready) bd=1;
                if(knob_in_valid && knob_in_ready) kd=1;
                @(negedge clk_sys);
                if(bd) button_in_valid=0;
                if(kd) knob_in_valid=0;
            end
            wait(keyboard_context_valid);
            repeat(17)
            begin
                @(negedge clk_sys);
                if(!keyboard_context_valid || keyboard_context_batch_id!=batch%16 || keyboard_context_play_mode!=(batch>=7))
                    $fatal(1,"context changed under stall, batch=%0d",batch);
            end
            if(joiner_count!=old_joiner+1 || keyboard_count!=old_keyboard) $fatal(1,"fork replayed fast destination");
            keyboard_context_ready=1;
            @(negedge clk_sys); keyboard_context_ready=0;
            repeat(80) @(negedge clk_sys);
            if(keyboard_count!=old_keyboard+1 || joiner_count!=old_joiner+1) $fatal(1,"fork transfer count");
        end
        // Prefetch batch41 while batch40's keyboard consumer is still blocked.
        for(batch=40;batch<42;batch=batch+1)
        begin
            @(negedge clk_sys);
            button_states=(batch==40) ? 0 : 1; button_batch_id=batch%16; knob_batch_id=batch%16;
            button_in_valid=1; knob_in_valid=1; bd=0; kd=0;
            while(!bd || !kd)
            begin
                @(posedge clk_sys);
                if(button_in_valid && button_in_ready) bd=1;
                if(knob_in_valid && knob_in_ready) kd=1;
                @(negedge clk_sys);
                if(bd) button_in_valid=0;
                if(kd) knob_in_valid=0;
            end
            if(batch==40) wait(keyboard_context_valid);
        end
        repeat(80) @(negedge clk_sys);
        if(!keyboard_context_valid || keyboard_context_batch_id!=8) $fatal(1,"prefetch overwrote stalled context tag");
        keyboard_context_ready=1;
        @(negedge clk_sys); keyboard_context_ready=0;
        wait(keyboard_context_valid && keyboard_context_batch_id==9);
        @(negedge clk_sys); keyboard_context_ready=1;
        @(negedge clk_sys); keyboard_context_ready=0;
        repeat(80) @(negedge clk_sys);
        if(joiner_count!=42 || keyboard_count!=42) $fatal(1,"prefetch transfer count");
        test_passed=1;
        $display("CHORD_CONTEXT_PASS batches=42 stalls=17 batch_wraps=2 next_batch_prefetch exactly_once_both_consumers");
        $finish;
    end
    initial begin #2000000; $fatal(1,"context watchdog"); end
endmodule
