`timescale 1ns/1ps
/** ui_control_state 自检：复位、握手背压及数据语义。
 * 参考向量使用整数物理单位独立计算；另测音色命令背压、异步复位取消及重新发送。
 */
module ui_control_state_tb;
    reg clk_sys = 1'b0;
    always #5.086263 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    integer index;
    integer cycle;
    integer count;
    integer file_handle;
    integer scan_count;
    string assets;
    string file_path;
    initial
    begin
        if (!$value$plusargs("ASSETS=%s", assets)) $fatal(1, "Missing ASSETS");
    end
    initial
    begin
        #20000000;
        $fatal(1, "Watchdog timeout");
    end
    reg [3:0] button_pressed_event = 4'd0;
    reg [3:0] button_released_event = 4'd0;
    reg [3:0] button_held = 4'd0;
    reg in_valid = 1'b0;
    wire in_ready;
    wire [1:0] mode;
    wire fine_adjust;
    wire edit_enable;
    wire edit_target;
    wire clear_wave_progress;
    wire context_valid;
    reg context_ready = 1'b0;
    wire preset_command_valid;
    reg preset_command_ready = 1'b0;
    wire preset_command_write;
    wire [3:0] preset_command_slot;
    integer value [0:5];
    ui_control_state ui_control_state_u (
        .effect_select(), .effect_reset(), .menu_effect_reset(),
        .preset_command_valid(preset_command_valid),
        .preset_command_ready(preset_command_ready),
        .preset_command_write(preset_command_write),
        .preset_command_slot(preset_command_slot),
        .preset_result_valid(1'b0),
        .preset_result_ready(),
        .preset_result_status(4'd0),
        .menu_page(),
        .menu_selection(),
        .menu_slot(),
        .menu_save(),
        .menu_result_status(),
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .button_pressed_event(button_pressed_event),
        .button_released_event(button_released_event),
        .button_held(button_held),
        .in_valid(in_valid),
        .in_ready(in_ready),
        .mode(mode),
        .fine_adjust(fine_adjust),
        .edit_enable(edit_enable),
        .edit_target(edit_target),
        .clear_wave_progress(clear_wave_progress),
        .context_valid(context_valid),
        .context_ready(context_ready),
        .display_view()
    );

    task press_menu_button;
        input [3:0] pressed;
        begin
            @(negedge clk_sys);
            button_pressed_event = pressed;
            button_held = 4'd0;
            in_valid = 1'b1;
            do @(posedge clk_sys); while (!in_ready);
            @(negedge clk_sys);
            in_valid = 1'b0;
            repeat (2) @(negedge clk_sys);
        end
    endtask

    task prepare_save;
        begin
            // B1 主菜单，B3 选保存，三个 B1 依次选槽、确认、执行。
            press_menu_button(4'b0001);
            press_menu_button(4'b0100);
            press_menu_button(4'b0100);
            press_menu_button(4'b0001);
            press_menu_button(4'b0001);
            press_menu_button(4'b0001);
        end
    endtask

    task check_command_reset;
        begin
            context_ready = 1'b1;
            prepare_save;
            repeat (8)
            begin
                if (!preset_command_valid || !preset_command_write || preset_command_slot != 4'd0)
                    $fatal(1,"保存命令未在背压时保持");
                @(negedge clk_sys);
            end
            #1;
            rst_n = 1'b0;
            in_valid = 1'b1;
            #1;
            if (preset_command_valid !== 1'b0 || in_ready !== 1'b0)
                $fatal(1,"保存命令未被异步复位取消");
            repeat (3) @(negedge clk_sys);
            in_valid = 1'b0;
            rst_n = 1'b1;
            repeat (5) @(negedge clk_sys);
            if (preset_command_valid || !edit_enable)
                $fatal(1,"复位后出现旧命令或误入菜单");
            prepare_save;
            if (!preset_command_valid) $fatal(1,"复位后无法生成新命令");
            preset_command_ready = 1'b1;
            @(negedge clk_sys);
            preset_command_ready = 1'b0;
            repeat (4) @(negedge clk_sys);
            if (preset_command_valid) $fatal(1,"保存命令重复交付");
            $display("UI_COMMAND_RESET_PASS stalled asynchronous_cancel restart_once");
        end
    endtask

    task reset_dut;
        begin
            @(negedge clk_sys);
            rst_n = 1'b0;
            repeat (3) @(negedge clk_sys);
            rst_n = 1'b1;
            #1;
        end
    endtask

    initial
    begin
        #1;
        file_path = {assets,"/control.txt"};
        file_handle = $fopen(file_path,"r");
        if (!file_handle) $fatal(1,"Cannot open control vectors");
        reset_dut;
        for (index=0; index<512; index=index+1)
        begin
            scan_count=$fscanf(file_handle,"%d %d %d %d %d %d",value[0],value[1],value[2],value[3],value[4],value[5]);
            if (scan_count != 6) $fatal(1,"Bad control vector");
            @(negedge clk_sys);
            button_pressed_event=value[0];
            button_held=value[1];
            button_released_event=~button_held;
            in_valid=1'b1;
            do @(posedge clk_sys); while (!in_ready);
            @(negedge clk_sys);
            in_valid=1'b0;
            button_pressed_event=4'hF;
            button_held=4'd0;
            for (cycle=0;cycle<1+index%11;cycle=cycle+1)
            begin
                if (!context_valid || mode !== value[2][1:0] ||
                    fine_adjust !== value[3][0] || edit_enable !== value[4][0] ||
                    clear_wave_progress !== value[5][0] || edit_target !== 1'b0)
                    $fatal(1,"Context mismatch vector %0d",index);
                @(negedge clk_sys);
            end
            context_ready=1'b1;
            @(negedge clk_sys);
            context_ready=1'b0;
            if (context_valid) $fatal(1,"Context delivered twice");
        end
        reset_dut;
        if (context_valid || mode !== 2'd0 || !edit_enable)
            $fatal(1,"Control reset mismatch");
        check_command_reset;
        $display("UI_CONTROL_STATE_PASS frames=512");
        $finish;
    end
endmodule
