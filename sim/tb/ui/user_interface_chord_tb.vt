`timescale 1ns/1ps
/** Full 32-voice UI->rack->mixer at 2048-clock ticks, no peripheral/LCD modules.
 * Tests menu confirm+new key in same frame, held-mode retention, cancel, high notes,
 * pressure smoothing, bend on tails, simultaneous old off/new on, 24-key bursts,
 * PCM/display stalls, long-stall overrun detection and reset/restart.
 */
module user_interface_chord_tb;
    GSR GSR(.GSRI(1'b1));
    reg clk_sys=0,rst_n=0;
    always #5 clk_sys=~clk_sys;
    reg [10:0] tick_count=0;
    wire tick=tick_count==0;
    always @(posedge clk_sys) tick_count<=tick_count+1'b1;
    reg [23:0] keys=0;
    reg [15:0] pressure [23:0];
    reg [3:0] buttons=0;
    reg [7:0] knob_states=0,knob_dirs=0,knob_pressed=0;
    reg [15:0] bend=16'h8000;
    reg in_valid=0,pcm_ready=1,display_ready=0;
    wire in_ready,pcm_valid,display_valid,config_error,overrun;
    wire signed [15:0] pcm;
    wire [527:0] display_state;
    integer commits=0,pcm_count=0,nonzero_count=0,tick_age=0,max_pcm_age=0;
    integer on_count,off_count,target,i,t,n,new_index,expected_bend,bend_tolerance;
    reg [31:0] last_on=0,last_off=0;
    reg [31:0] last_freq [31:0];
    reg [15:0] last_velocity [31:0];
    reg allow_overrun=0,checking=1,test_passed=0;
    reg [527:0] stalled_display;
    reg display_stalled=0;
    reg signed [15:0] stalled_pcm;
    reg pcm_stalled=0;
    chord_audio_fixture dut(
        .clk_sys(clk_sys),.rst_n(rst_n),.scan_tick_up(1'b0),.smp_tick_up(tick),
        .key_states(keys),.key_velocity(pressure),.button_states(buttons),
        .knob_states(knob_states),.knob_dirs(knob_dirs),.knob_pressed(knob_pressed),
        .bend_position(bend),.in_valid(in_valid),.in_ready(in_ready),
        .audio_out(pcm),.out_valid(pcm_valid),.out_ready(pcm_ready),
        .display_out_state(display_state),.display_out_valid(display_valid),.display_out_ready(display_ready),
        .configuration_error(config_error),.sample_overrun(overrun)
    );
    function integer popcount;
        input [31:0] mask;
        integer b;
        begin
            popcount=0;
            for(b=0;b<32;b=b+1) popcount=popcount+mask[b];
        end
    endfunction
    always @(posedge clk_sys)
    begin
        if(!rst_n)
        begin
            display_stalled=0; pcm_stalled=0; tick_age=0;
        end
        else
        begin
            if(tick) tick_age=0;
            else tick_age=tick_age+1;
            if(config_error) $fatal(1,"UI configuration/protocol error");
            if(overrun && !allow_overrun) $fatal(1,"unexpected sample overrun");
            if(display_stalled && (!display_valid || display_state!==stalled_display)) $fatal(1,"display payload changed under backpressure");
            display_stalled=display_valid && !display_ready;
            if(display_stalled) stalled_display=display_state;
            if(pcm_stalled && (!pcm_valid || pcm!==stalled_pcm)) $fatal(1,"PCM changed under backpressure");
            pcm_stalled=pcm_valid && !pcm_ready;
            if(pcm_stalled) stalled_pcm=pcm;
            if(dut.ui_valid && dut.ui_audio_ready)
            begin
                last_on=dut.note_on; last_off=dut.note_off;
                if(|(last_on & last_off)) $fatal(1,"on/off conflict on a lane");
                for(n=0;n<32;n=n+1)
                begin
                    last_freq[n]=dut.note_freq[n]; last_velocity[n]=dut.note_velocity[n];
                end
            end
            if(dut.user_interface_u.keyboard_note_pipeline_u.event_ready) commits=commits+1;
            if(pcm_valid && pcm_ready)
            begin
                pcm_count=pcm_count+1;
                if(^pcm===1'bx) $fatal(1,"unknown audio");
                if(pcm!=0) nonzero_count=nonzero_count+1;
                if(!allow_overrun && tick_age>max_pcm_age) max_pcm_age=tick_age;
            end
        end
    end
    task frame;
        input [3:0] b;
        input [23:0] k;
        input integer expected_on,expected_off;
        integer timeout;
        begin
            @(negedge clk_sys); buttons=b; keys=k; in_valid=1; target=commits+1;
            do @(posedge clk_sys); while(!in_ready);
            @(negedge clk_sys); in_valid=0;
            timeout=0;
            while(commits<target)
            begin
                @(negedge clk_sys); timeout=timeout+1;
                if(timeout>10000) $fatal(1,"input/context/audio deadlock");
            end
            on_count=popcount(last_on); off_count=popcount(last_off);
            if(on_count!=expected_on || off_count!=expected_off)
                $fatal(1,"frame %0d expected on/off=%0d/%0d actual=%0d/%0d masks=%h/%h",
                    commits,expected_on,expected_off,on_count,off_count,last_on,last_off);
            $display("CHORD_AUDIO_FRAME %0d on=%0d off=%0d time=%0t",commits,on_count,off_count,$time);
        end
    endtask
    task check_triad;
        input integer root;
        integer lane,tone;
        reg [31:0] expected_freq;
        begin
            tone=0;
            for(lane=0;lane<32;lane=lane+1)
                if(last_on[lane])
                begin
                    expected_freq=$rtoi(440.0*(2.0**(($itor(root+((tone==0) ? 0 : ((tone==1) ? 4 : 7)))-69.0)/12.0))*65536.0+0.5);
                    if(last_freq[lane]!==expected_freq) $fatal(1,"triad root=%0d tone=%0d freq=%0d/%0d",root,tone,last_freq[lane],expected_freq);
                    tone=tone+1;
                end
            if(tone!=3) $fatal(1,"triad incomplete");
        end
    endtask
    task choose_normal;
        begin
            frame(4'h1,0,0,0); frame(0,0,0,0);
            frame(4'h1,0,0,0); frame(0,0,0,0);
            frame(4'h2,0,0,0); frame(0,0,0,0);
        end
    endtask
    initial
    begin
        for(i=0;i<24;i=i+1) pressure[i]=16'h8000;
        repeat(5) @(negedge clk_sys); rst_n=1;
        frame(0,0,0,0);
        frame(0,24'h000001,1,0);
        frame(1,24'h000001,0,0); frame(0,24'h000001,0,0);
        frame(1,24'h000001,0,0); frame(0,24'h000001,0,0);
        frame(4,24'h000001,0,0); frame(0,24'h000001,0,0);
        frame(1,24'h000201,3,0); // Confirm chord + press A4 in exactly the same frame.
        check_triad(69);
        frame(0,24'h000201,0,0);
        frame(0,24'h000200,0,1); // C4 was started in normal mode: only one off.
        frame(0,0,0,3);
        // Cancel a normal-mode candidate, preserving chord mode.
        choose_normal;
        frame(8,0,0,0); frame(0,0,0,0);
        frame(8,0,0,0); frame(0,0,0,0);
        frame(0,24'h800000,3,0); check_triad(83);
        frame(0,24'h000001,3,3); check_triad(60);
        // Pressure changes must not retrigger any of the three voices.
        for(i=0;i<24;i=i+1) pressure[i]=16'h4000;
        frame(0,24'h000001,0,0);
        repeat(100) @(posedge tick);
        @(negedge clk_sys);
        for(i=0;i<32;i=i+1)
            if(dut.user_interface_u.keyboard_note_pipeline_u.latest_held_r[i] && dut.note_velocity[i]!=16'h4000)
                $fatal(1,"held chord pressure did not converge");
        // Apply common +200-cent bend; all occupied tones including tails must shift.
        bend=16'hffff;
        frame(0,24'h000001,0,0);
        for(i=0;i<32;i=i+1)
            if(dut.user_interface_u.keyboard_note_pipeline_u.latest_occupied_r[i])
            begin
                t=dut.user_interface_u.keyboard_note_pipeline_u.latest_note_number_r[i];
                expected_bend=$rtoi(440.0*(2.0**(($itor(t)-67.0)/12.0))*65536.0+0.5);
                // UQ1.17 endpoint ratio is rounded: <=0.5 ratio LSB plus frequency rounding.
                bend_tolerance=$rtoi(440.0*(2.0**(($itor(t)-69.0)/12.0))*65536.0/262144.0)+4;
                if(last_freq[i]<expected_bend-bend_tolerance || last_freq[i]>expected_bend+bend_tolerance)
                    $fatal(1,"chord bend note=%0d actual=%0d expected=%0d tolerance=%0d",t,last_freq[i],expected_bend,bend_tolerance);
            end
        bend=16'h8000;
        frame(0,0,0,3);
        frame(0,24'hffffff,30,0);
        frame(0,24'hffffff,0,0);
        frame(0,0,0,30);
        choose_normal;
        frame(1,24'hffffff,24,0); // Confirm normal and full keyboard in one frame.
        frame(0,0,0,24);
        // Entire display channel has been stalled; audio must have continued throughout.
        if(pcm_count<100 || nonzero_count<20) $fatal(1,"audio did not continue during display stall");
        display_ready=1;
        repeat(100) @(negedge clk_sys);
        if(display_state[509] || display_state[510]) $fatal(1,"latest display mode not published");
        // A short PCM stall within the frame preserves payload and recovers.
        @(negedge clk_sys); pcm_ready=0;
        wait(pcm_valid); repeat(40) @(negedge clk_sys); pcm_ready=1;
        repeat(8) @(posedge tick);
        // An unbounded consumer stall is diagnosed, not hidden.
        allow_overrun=1; @(negedge clk_sys); pcm_ready=0;
        i=0;
        while(!overrun && i<20000)
        begin
            @(negedge clk_sys); i=i+1;
        end
        if(!overrun) $fatal(1,"missing long-stall overrun indication");
        pcm_ready=1;
        repeat(6) @(posedge tick);
        rst_n=0; in_valid=0; buttons=0; keys=0; #1;
        if(pcm_valid || display_valid) $fatal(1,"reset failed to cancel outputs");
        repeat(5) @(negedge clk_sys); allow_overrun=0; rst_n=1;
        frame(0,0,0,0); frame(0,24'h000200,1,0);
        test_passed=1;
        $display("USER_INTERFACE_CHORD_PASS commits=%0d PCM=%0d nonzero=%0d max_tick_to_PCM=%0d/2048",commits,pcm_count,nonzero_count,max_pcm_age);
        $finish;
    end
    initial begin #30000000; $fatal(1,"UI/audio watchdog"); end
endmodule

/**
 * UI/音频验证核心：整帧输入→user_interface→32声部机架→mixer。
 * 所有输入须由调用者同步并组成完整帧；不包含驱动、LCD或I2S。
 * 输出SQ1.15 PCM，按out_valid&&out_ready交付；显示出口独立背压。
 * 一个rack事务绑定同批mixer参数；存储请求返回明确错误2，不模拟持久化。
 * 本核用于功能/时序验证，不是完整乐器板级连接。
 */
module chord_audio_fixture #(
    parameter KEY_NUM=24, parameter MAX_POLYPHONY=32, parameter WAVE_SELECT_STEPS=4
)(
    input clk_sys, input rst_n, input scan_tick_up, input smp_tick_up,
    input [KEY_NUM-1:0] key_states, input [15:0] key_velocity [KEY_NUM-1:0],
    input [3:0] button_states,
    input [7:0] knob_states, input [7:0] knob_dirs, input [7:0] knob_pressed,
    input [15:0] bend_position, input in_valid, output in_ready,
    output signed [15:0] audio_out, output out_valid, input out_ready,
    output [527:0] display_out_state, output display_out_valid, input display_out_ready,
    output configuration_error, output sample_overrun
);
    localparam KNOB_NUM=8, BEND_NUM=1, CHANNEL_NUM=1;
    wire ui_valid, ui_audio_ready;
    wire [15:0] bend_value [BEND_NUM-1:0];
    wire [MAX_POLYPHONY-1:0] note_busy;
    wire note_busy_valid;
    wire note_busy_ready;
    wire [MAX_POLYPHONY-1:0] note_on;
    wire [MAX_POLYPHONY-1:0] note_off;
    wire [31:0] note_freq [MAX_POLYPHONY-1:0];
    wire [15:0] note_velocity [MAX_POLYPHONY-1:0];
    wire [3:0] wavetable_0 [CHANNEL_NUM-1:0];
    wire [3:0] wavetable_1 [CHANNEL_NUM-1:0];
    wire [15:0] wavetable_interp [CHANNEL_NUM-1:0];
    wire [15:0] init_phase [CHANNEL_NUM-1:0];
    wire [19:0] attack_ticks [CHANNEL_NUM-1:0];
    wire [19:0] decay_ticks [CHANNEL_NUM-1:0];
    wire [15:0] sustain_level [CHANNEL_NUM-1:0];
    wire [19:0] release_ticks [CHANNEL_NUM-1:0];
    wire [15:0] master_volume;
    wire [15:0] reverb_feedback;
    wire [15:0] reverb_damping;
    wire [15:0] delay_time;
    wire [15:0] delay_feedback;
    wire [15:0] distortion_gain;
    wire [15:0] distortion_tone;
    wire [15:0] chorus_rate;
    wire [7:0] chorus_depth;
    wire [15:0] balance_volume;
    wire [15:0] reverb_mix;
    wire [15:0] delay_mix;
    wire [15:0] distortion_mix;
    wire [15:0] chorus_mix;
    wire storage_out_valid;
    wire storage_out_ready;
    wire storage_out_write;
    wire [3:0] storage_out_slot;
    wire [511:0] storage_out_data;
    wire storage_in_valid;
    wire storage_in_ready;
    wire [2:0] storage_in_status;
    wire [511:0] storage_in_data;
    wire [1:0] menu_effect;
    wire menu_effect_reset;
    wire [127:0] menu_advanced_parameters;
    wire [2:0] menu_page;
    wire [1:0] menu_selection;
    wire [3:0] menu_slot;
    wire menu_save;
    wire [3:0] menu_result_status;
    wire storage_catalog_valid;
    wire [15:0] storage_slot_present;
    wire menu_slot_known;
    wire menu_slot_present;
    assign bend_value[0]=bend_position;
    reg storage_pending_r;
    assign storage_out_ready=!storage_pending_r;
    assign storage_in_valid=storage_pending_r;
    assign storage_in_status=3'd2;
    assign storage_in_data=512'd0;
    assign storage_catalog_valid=1'b1;
    assign storage_slot_present=16'd0;
    always @(posedge clk_sys or negedge rst_n)
    begin
        if(!rst_n) storage_pending_r<=1'b0;
        else
        begin
            if(storage_in_valid && storage_in_ready) storage_pending_r<=1'b0;
            if(storage_out_valid && storage_out_ready) storage_pending_r<=1'b1;
        end
    end
    user_interface #(.KEY_NUM(KEY_NUM),.MAX_POLYPHONY(MAX_POLYPHONY),.WAVE_SELECT_STEPS(WAVE_SELECT_STEPS)) user_interface_u (
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .scan_tick_up(scan_tick_up),
        .key_states(key_states),
        .key_velocity(key_velocity),
        .knob_states(knob_states),
        .knob_dirs(knob_dirs),
        .knob_pressed(knob_pressed),
        .bend_value(bend_value),
        .note_busy(note_busy),
        .note_busy_valid(note_busy_valid),
        .note_busy_ready(note_busy_ready),
        .note_on(note_on),
        .note_off(note_off),
        .note_freq(note_freq),
        .note_velocity(note_velocity),
        .wavetable_0(wavetable_0),
        .wavetable_1(wavetable_1),
        .wavetable_interp(wavetable_interp),
        .init_phase(init_phase),
        .attack_ticks(attack_ticks),
        .decay_ticks(decay_ticks),
        .sustain_level(sustain_level),
        .release_ticks(release_ticks),
        .out_ready(ui_audio_ready),
        .in_valid(in_valid),
        .out_valid(ui_valid),
        .in_ready(in_ready),
        .button_states(button_states),
        .smp_tick_up(smp_tick_up),
        .master_volume(master_volume),
        .reverb_feedback(reverb_feedback),
        .reverb_damping(reverb_damping),
        .delay_time(delay_time),
        .delay_feedback(delay_feedback),
        .distortion_gain(distortion_gain),
        .distortion_tone(distortion_tone),
        .chorus_rate(chorus_rate),
        .chorus_depth(chorus_depth),
        .balance_volume(balance_volume),
        .reverb_mix(reverb_mix),
        .delay_mix(delay_mix),
        .distortion_mix(distortion_mix),
        .chorus_mix(chorus_mix),
        .configuration_error(configuration_error),
        .sample_overrun(sample_overrun),
        .storage_out_valid(storage_out_valid),
        .storage_out_ready(storage_out_ready),
        .storage_out_write(storage_out_write),
        .storage_out_slot(storage_out_slot),
        .storage_out_data(storage_out_data),
        .storage_in_valid(storage_in_valid),
        .storage_in_ready(storage_in_ready),
        .storage_in_status(storage_in_status),
        .storage_in_data(storage_in_data),
        .menu_effect(menu_effect),
        .menu_effect_reset(menu_effect_reset),
        .menu_advanced_parameters(menu_advanced_parameters),
        .menu_page(menu_page),
        .menu_selection(menu_selection),
        .menu_slot(menu_slot),
        .menu_save(menu_save),
        .menu_result_status(menu_result_status),
        .storage_catalog_valid(storage_catalog_valid),
        .storage_slot_present(storage_slot_present),
        .menu_slot_known(menu_slot_known),
        .menu_slot_present(menu_slot_present),
        .display_out_state(display_out_state),
        .display_out_valid(display_out_valid),
        .display_out_ready(display_out_ready)
    );
    wire signed [15+$clog2(MAX_POLYPHONY):0] rack_audio;
    wire rack_ready,rack_valid,mixer_ready;
    reg parameters_busy_r;
    reg [215:0] parameters_r;
    wire [15:0] mix_reverb_mix,mix_reverb_feedback,mix_reverb_damping;
    wire [15:0] mix_delay_mix,mix_delay_time,mix_delay_feedback;
    wire [15:0] mix_distortion_mix,mix_distortion_gain,mix_distortion_tone;
    wire [15:0] mix_chorus_mix,mix_chorus_rate,mix_balance,mix_master;
    wire [7:0] mix_chorus_depth;
    assign {mix_reverb_mix,mix_reverb_feedback,mix_reverb_damping,
            mix_delay_mix,mix_delay_time,mix_delay_feedback,
            mix_distortion_mix,mix_distortion_gain,mix_distortion_tone,
            mix_chorus_mix,mix_chorus_rate,mix_chorus_depth,mix_balance,mix_master}=parameters_r;
    assign ui_audio_ready=rack_ready && !parameters_busy_r;
    always @(posedge clk_sys or negedge rst_n)
    begin
        if(!rst_n)
        begin
            parameters_busy_r<=1'b0; parameters_r<='0;
        end
        else
        begin
            if(rack_valid && mixer_ready && parameters_busy_r) parameters_busy_r<=1'b0;
            if(ui_valid && ui_audio_ready)
            begin
                parameters_busy_r<=1'b1;
                parameters_r<={reverb_mix,reverb_feedback,reverb_damping,
                    delay_mix,delay_time,delay_feedback,distortion_mix,distortion_gain,distortion_tone,
                    chorus_mix,chorus_rate,chorus_depth,balance_volume,master_volume};
            end
        end
    end
    channel_rack #(.MAX_POLYPHONY(MAX_POLYPHONY)) channel_rack_u (
        .clk_sys(clk_sys),.rst_n(rst_n),.smp_tick_up(smp_tick_up),
        .note_on(note_on),.note_off(note_off),.note_busy(note_busy),
        .note_busy_valid(note_busy_valid),.note_busy_ready(note_busy_ready),
        .note_freq(note_freq),.note_velocity(note_velocity),.init_phase(init_phase[0]),
        .attack_ticks(attack_ticks[0]),.decay_ticks(decay_ticks[0]),
        .sustain_level(sustain_level[0]),.release_ticks(release_ticks[0]),
        .wavetable_0(wavetable_0[0]),.wavetable_1(wavetable_1[0]),.wavetable_interp(wavetable_interp[0]),
        .in_valid(ui_valid && !parameters_busy_r),.in_ready(rack_ready),
        .audio_out(rack_audio),.out_valid(rack_valid),.out_ready(mixer_ready && parameters_busy_r)
    );
    mixer #(.MAX_POLYPHONY(MAX_POLYPHONY)) mixer_u (
        .clk_sys(clk_sys),.rst_n(rst_n),.smp_tick_up(smp_tick_up),.audio_in(rack_audio),
        .reverb_mix(mix_reverb_mix),.reverb_feedback(mix_reverb_feedback),.reverb_damping(mix_reverb_damping),
        .delay_mix(mix_delay_mix),.delay_time(mix_delay_time),.delay_feedback(mix_delay_feedback),
        .distortion_mix(mix_distortion_mix),.distortion_gain(mix_distortion_gain),.distortion_tone(mix_distortion_tone),
        .chorus_mix(mix_chorus_mix),.chorus_rate(mix_chorus_rate),.chorus_depth(mix_chorus_depth),
        .balance_volume(mix_balance),.master_volume(mix_master),
        .in_valid(rack_valid && parameters_busy_r),.in_ready(mixer_ready),
        .audio_out(audio_out),.out_valid(out_valid),.out_ready(out_ready)
    );
endmodule
