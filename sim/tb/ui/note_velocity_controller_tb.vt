/** 力度自检：5% 下限、满量程、双向平滑、尾音冻结、抢占重置、空声部、
 * 背压、差值恰好等于步长及其相邻值、非法键号、各流水阶段复位取消。
 * 独立整数模型逐事务计算；严格检查新增流水延迟及输入捕获后隔离。
 */
`timescale 1ns/1ps
module note_velocity_controller_tb;
    reg clk_sys = 1'b0;
    always #5 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    reg [1:0] key_id [2:0];
    reg [15:0] key_velocity [2:0];
    reg [2:0] occupied = 3'b111, held = 3'b111, note_on = 3'b111;
    reg in_valid = 1'b0;
    wire in_ready, out_valid;
    reg out_ready = 1'b0;
    wire [15:0] note_velocity [2:0];
    integer model [2:0];
    integer frame, voice, target, difference, stall, stage, boundary;
    note_velocity_controller #(.KEY_NUM(3), .MAX_POLYPHONY(3)) note_velocity_controller_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .key_id(key_id), .key_velocity(key_velocity),
        .occupied(occupied), .held(held), .note_on(note_on), .in_valid(in_valid), .in_ready(in_ready),
        .note_velocity(note_velocity), .out_valid(out_valid), .out_ready(out_ready)
    );
    initial
    begin
        for (voice = 0; voice < 3; voice = voice + 1)
        begin
            model[voice] = 0;
            key_id[voice] = voice;
        end
        repeat (3) @(negedge clk_sys);
        rst_n = 1'b1;
        for (frame = 0; frame < 814; frame = frame + 1)
        begin
            note_on = (frame == 0 || frame == 650) ? 3'b111 : 3'b000;
            occupied = (frame >= 750) ? 3'b101 : 3'b111;
            held = (frame >= 500 && frame < 650) ? 3'b000 : 3'b111;
            key_velocity[0] = (frame < 250) ? 16'd0 : 16'hffff;
            key_velocity[1] = (frame < 250) ? 16'hffff : 16'd0;
            key_velocity[2] = (frame == 0) ? 16'd3276 : (frame * 991) & 65535;
            for (voice = 0; voice < 3; voice = voice + 1)
                key_id[voice] = voice;
            if (frame >= 800)
            begin
                // 每对事务先初始化为 32768，再测试 +/-273、274、275 和零差值。
                boundary = (frame - 800) / 2;
                occupied = 3'b111;
                held = 3'b111;
                note_on = (frame % 2 == 0) ? 3'b111 : 3'b000;
                key_velocity[0] = (frame % 2 == 0) ? 16'd32768 : 32768 + 273 + boundary % 3;
                key_velocity[1] = (frame % 2 == 0) ? 16'd32768 : 32768 - 273 - boundary % 3;
                key_velocity[2] = 16'd32768;
                if (frame == 813) key_id[2] = 2'd3;
            end
            for (voice = 0; voice < 3; voice = voice + 1)
            begin
                target = key_velocity[voice] < 3277 ? 3277 : key_velocity[voice];
                if (!occupied[voice] || key_id[voice] >= 3) model[voice] = 0;
                else if (note_on[voice]) model[voice] = target;
                else if (held[voice])
                begin
                    difference = target - model[voice];
                    if (difference > 274) difference = 274;
                    if (difference < -274) difference = -274;
                    model[voice] = model[voice] + difference;
                end
            end
            in_valid = 1'b1;
            @(negedge clk_sys);
            in_valid = 1'b0;
            for (voice = 0; voice < 3; voice = voice + 1)
                key_velocity[voice] = ~key_velocity[voice];
            // E0 已捕获，随后 E1 计算差值／候选，E2 提交结果。
            if (out_valid || in_ready) $fatal(1, "力度计算阶段时序错误");
            occupied = 3'b000;
            held = 3'b000;
            note_on = 3'b000;
            for (voice = 0; voice < 3; voice = voice + 1)
                key_id[voice] = 2'd3;
            @(negedge clk_sys);
            if (out_valid || in_ready) $fatal(1, "中间计算阶段提前发布结果");
            @(negedge clk_sys);
            for (stall = 0; stall < (frame % 5) + 1; stall = stall + 1)
            begin
                if (!out_valid || in_ready) $fatal(1, "力度握手失败");
                for (voice = 0; voice < 3; voice = voice + 1)
                    if (note_velocity[voice] !== model[voice]) $fatal(1, "力度帧 %0d 声部 %0d 不匹配", frame, voice);
                @(negedge clk_sys);
            end
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
        end
        // 分别在捕获后、候选计算后、有效结果等待期间取消事务。
        for (stage = 0; stage < 3; stage = stage + 1)
        begin
            occupied = 3'b111;
            held = 3'b111;
            note_on = 3'b111;
            for (voice = 0; voice < 3; voice = voice + 1)
            begin
                key_id[voice] = voice;
                key_velocity[voice] = 16'hffff;
            end
            in_valid = 1'b1;
            @(negedge clk_sys);
            in_valid = 1'b0;
            repeat (stage) @(negedge clk_sys);
            rst_n = 1'b0;
            #1;
            if (out_valid || in_ready) $fatal(1, "流水阶段 %0d 复位握手错误", stage);
            for (voice = 0; voice < 3; voice = voice + 1)
                if (note_velocity[voice] !== 16'd0) $fatal(1, "流水阶段复位残留力度");
            @(negedge clk_sys);
            rst_n = 1'b1;
            repeat (4) @(negedge clk_sys);
            if (out_valid || !in_ready) $fatal(1, "复位后泄漏旧事务");
        end
        // ready 预先为高仍必须完成 E0/E1/E2，并在 E3 仅交付一次。
        out_ready = 1'b1;
        in_valid = 1'b1;
        @(negedge clk_sys);
        in_valid = 1'b0;
        repeat (2) @(negedge clk_sys);
        if (!out_valid) $fatal(1, "预置 ready 时未产生 valid");
        for (voice = 0; voice < 3; voice = voice + 1)
            if (note_velocity[voice] !== 16'hffff) $fatal(1, "复位后新事务错误");
        @(negedge clk_sys);
        if (out_valid || !in_ready) $fatal(1, "预置 ready 时交付重复");
        rst_n = 1'b0;
        #1;
        if (out_valid || note_velocity[0]) $fatal(1, "力度复位失败");
        $display("NOTE_VELOCITY_CONTROLLER_PASS samples=815 voices=3 reset_stages=3");
        $finish;
    end
endmodule
