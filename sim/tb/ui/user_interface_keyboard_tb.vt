/** 键盘整链：采样前后边沿、压力冻结、抢占、旧键隔离、事件一次交付、跨 tick 背压。 */
`timescale 1ns/1ps
module user_interface_keyboard_tb;
    reg clk_sys = 1'b0;
    always #5 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    reg smp_tick_up = 1'b0;
    reg [2:0] key_states = 3'd0;
    reg [15:0] key_velocity [2:0];
    reg [0:0] note_busy = 1'b0;
    reg in_valid = 1'b0;
    wire in_ready, out_valid, sample_ready, sample_overrun;
    reg out_ready = 1'b0;
    wire [0:0] note_on, note_off;
    wire [31:0] note_freq [0:0];
    wire [15:0] note_velocity [0:0];
    integer sample_count = 0;
    integer on_count = 0;
    integer off_count = 0;
    integer cycles;
    wire [15:0] bend_value [0:0];
    assign bend_value[0] = 16'h8000;
    wire [15:0] master_volume;
    wire configuration_error;
    reg [7:0] knob_states = 8'd0;
    user_interface #(.KEY_NUM(3), .MAX_POLYPHONY(1), .WAVE_SELECT_STEPS(4)) user_interface_u (
        // 存储未接入的旧测试：新增输入明确接零，输出留空。
        .storage_out_valid(),
        .storage_out_ready(1'b0),
        .storage_out_write(),
        .storage_out_slot(),
        .storage_out_data(),
        .storage_in_valid(1'b0),
        .storage_in_ready(),
        .storage_in_status(3'd0),
        .storage_in_data(512'd0),
        .menu_page(),
        .menu_selection(),
        .menu_slot(),
        .menu_save(),
        .menu_result_status(),
        .storage_catalog_valid(1'b0),
        .storage_slot_present(16'd0),
        .menu_slot_known(),
        .menu_slot_present(),
        .clk_sys(clk_sys), .rst_n(rst_n), .scan_tick_up(1'b0), .smp_tick_up(smp_tick_up),
        .key_states(key_states), .key_velocity(key_velocity), .note_busy(note_busy),
        .in_valid(in_valid), .in_ready(in_ready), .note_on(note_on), .note_off(note_off),
        .note_freq(note_freq), .note_velocity(note_velocity), .out_valid(out_valid), .out_ready(out_ready),
        .sample_overrun(sample_overrun), .button_states(4'd0),
        .knob_states(knob_states), .knob_dirs(8'hff), .knob_pressed(8'd0), .bend_value(bend_value),
        .master_volume(master_volume), .balance_volume(), .configuration_error(configuration_error),
        .wavetable_0(), .wavetable_1(), .wavetable_interp(), .init_phase(), .attack_ticks(),
        .decay_ticks(), .sustain_level(), .release_ticks(), .reverb_mix(), .delay_mix(), .distortion_mix(), .chorus_mix()
    );
    always @(posedge clk_sys)
    begin
        if (rst_n && out_valid && out_ready)
        begin
            sample_count = sample_count + 1;
            if (note_on) on_count = on_count + 1;
            if (note_off) off_count = off_count + 1;
        end
    end
    task send_keys;
        input [2:0] states;
        begin
            @(negedge clk_sys);
            key_states = states;
            in_valid = 1'b1;
            while (!in_ready) @(negedge clk_sys);
            @(negedge clk_sys);
            in_valid = 1'b0;
            repeat (100) @(negedge clk_sys);
        end
    endtask
    task tick;
        begin
            smp_tick_up = 1'b1;
            @(negedge clk_sys);
            smp_tick_up = 1'b0;
        end
    endtask
    task sample;
        input expected_on;
        input expected_off;
        input [31:0] expected_frequency;
        input [15:0] expected_velocity;
        input integer stalled_ticks;
        integer stall;
        begin
            tick;
            cycles = 0;
            while (!out_valid)
            begin
                @(negedge clk_sys);
                cycles = cycles + 1;
                if (cycles > 13) $fatal(1, "采样计算超时");
            end
            if (cycles != 12) $fatal(1, "单声部弯音流水延迟错误");
            for (stall = 0; stall <= stalled_ticks; stall = stall + 1)
            begin
                if (note_on !== expected_on || note_off !== expected_off ||
                    note_freq[0] !== expected_frequency || note_velocity[0] !== expected_velocity)
                    $fatal(1, "采样 %0d 错误 on/off=%b/%b freq=%d vel=%d", sample_count, note_on, note_off, note_freq[0], note_velocity[0]);
                if (stall < stalled_ticks) tick;
            end
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
        end
    endtask
    initial
    begin
        key_velocity[0] = 16'd0;
        key_velocity[1] = 16'd20000;
        key_velocity[2] = 16'hffff;
        repeat (3) @(negedge clk_sys);
        rst_n = 1'b1;
        sample(0, 0, 0, 0, 0);
        knob_states = 8'h04;
        send_keys(3'b001);
        sample(1, 0, 32'd17145893, 16'd3277, 5);
        if (master_volume !== 16'd22938 || configuration_error) $fatal(1, "音符与控制参数汇合失败");
        knob_states = 8'd0;
        if (!sample_overrun) $fatal(1, "遗漏超期诊断");
        note_busy = 1'b1;
        sample(0, 0, 32'd17145893, 16'd3277, 0);
        key_velocity[0] = 16'hffff;
        send_keys(3'b001);
        sample(0, 0, 32'd17145893, 16'd3551, 0);
        sample(0, 0, 32'd17145893, 16'd3825, 0);
        key_velocity[0] = 16'd0;
        send_keys(3'b000);
        sample(0, 1, 32'd17145893, 16'd3825, 0);
        sample(0, 0, 32'd17145893, 16'd3825, 0);
        // 尾音被新键抢占；旧 busy 保持高，不能自动释放新键。
        send_keys(3'b010);
        sample(1, 0, 32'd18165441, 16'd20000, 0);
        send_keys(3'b110);
        sample(1, 0, 32'd19245614, 16'hffff, 0);
        send_keys(3'b100);
        sample(0, 0, 32'd19245614, 16'hffff, 0);
        send_keys(3'b000);
        sample(0, 1, 32'd19245614, 16'hffff, 0);
        // 没有新代际确认，busy 低也不冒险回收；随后低高低确认才可回收。
        note_busy = 1'b0;
        repeat (3) @(negedge clk_sys);
        send_keys(3'b000);
        sample(0, 0, 32'd19245614, 16'hffff, 0);
        note_busy = 1'b1;
        repeat (3) @(negedge clk_sys);
        note_busy = 1'b0;
        repeat (3) @(negedge clk_sys);
        send_keys(3'b000);
        sample(0, 0, 0, 0, 0);
        if (on_count != 3 || off_count != 2) $fatal(1, "事件丢失或重复");
        // 有事件的旧事务消费与新 tick 同沿，旧 handler 的 valid 不能被重复捕获。
        send_keys(3'b001);
        tick;
        while (!out_valid) @(negedge clk_sys);
        if (!note_on) $fatal(1, "同沿测试没有待发新音");
        out_ready = 1'b1;
        smp_tick_up = 1'b1;
        @(negedge clk_sys);
        smp_tick_up = 1'b0;
        out_ready = 1'b0;
        while (!out_valid) @(negedge clk_sys);
        if (note_on || note_off || note_freq[0] !== 32'd17145893 || note_velocity[0] !== 16'd3277)
            $fatal(1, "同沿交付导致旧事件重放或载荷错误");
        out_ready = 1'b1;
        @(negedge clk_sys);
        out_ready = 1'b0;
        if (on_count != 4 || off_count != 2) $fatal(1, "同沿事件消费次数错误");
        rst_n = 1'b0;
        #1;
        if (out_valid || sample_overrun) $fatal(1, "整链复位失败");
        $display("USER_INTERFACE_KEYBOARD_PASS samples=%0d on=%0d off=%0d", sample_count, on_count, off_count);
        $finish;
    end
    initial
    begin
        #1000000;
        $fatal(1, "键盘整链超时");
    end
endmodule
