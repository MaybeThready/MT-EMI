`timescale 1ns/1ps
/** Independent timestamp scoreboard: 24-key frames, mode changes, all-key bursts,
 * retained tails, reclaim, same-key retrigger, stolen-owner protection and stalls.
 * P=1/2/3/6/32 exercises atomic group rejection and full rack allocation.
 */
module chord_allocator_tb;
    parameter P=32;
    reg clk_sys=0, rst_n=0;
    always #5 clk_sys=~clk_sys;
    reg [23:0] keys=0;
    reg play_mode=0, in_valid=0, out_ready=0, busy_valid=0;
    reg [P-1:0] busy=0;
    reg [15:0] pressure [23:0];
    wire [15:0] saved_pressure [23:0];
    wire in_ready, out_valid, feedback_done;
    wire [P-1:0] on_event, off_event, occupied, held;
    wire [4:0] owner [P-1:0];
    wire [6:0] pitch [P-1:0];
    reg [23:0] previous=0;
    reg [P-1:0] ref_alloc=0, ref_held=0, expected_on=0, expected_off=0, reserved=0;
    integer ref_owner [0:P-1], ref_pitch [0:P-1], started [0:P-1];
    integer selected [0:2];
    integer serial=0, frame_index=0, seed=20261102;
    integer i,j,k,t,best,need,available,cycles,max_cycles=0,stall,klass,best_class;
    reg test_passed=0;
    reg [23:0] presses, releases;
    keyboard_event_handler #(.KEY_NUM(24),.MAX_POLYPHONY(P)) dut (
        .clk_sys(clk_sys),.rst_n(rst_n),.scan_tick_up(1'b0),.play_mode(play_mode),
        .key_states(keys),.key_velocity(pressure),.note_busy(busy),.note_busy_valid(busy_valid),
        .feedback_done(feedback_done),.note_on(on_event),.note_off(off_event),.key_id(owner),
        .note_number(pitch),.occupied(occupied),.held(held),.frame_velocity(saved_pressure),
        .in_valid(in_valid),.in_ready(in_ready),.out_valid(out_valid),.out_ready(out_ready)
    );
    task check;
        begin
            if(on_event!==expected_on || off_event!==expected_off || occupied!==ref_alloc || held!==ref_held)
                $fatal(1,"P=%0d frame=%0d bitmap on=%h/%h off=%h/%h occ=%h/%h held=%h/%h",
                    P,frame_index,on_event,expected_on,off_event,expected_off,occupied,ref_alloc,held,ref_held);
            if(|(on_event & off_event)) $fatal(1,"same lane on and off");
            for(j=0;j<P;j=j+1)
                if(owner[j]!==ref_owner[j] || pitch[j]!==ref_pitch[j])
                    $fatal(1,"P=%0d frame=%0d lane=%0d owner=%0d/%0d pitch=%0d/%0d",
                        P,frame_index,j,owner[j],ref_owner[j],pitch[j],ref_pitch[j]);
            for(j=0;j<24;j=j+1)
                if(saved_pressure[j]!==((frame_index*177+j*2039)&65535)) $fatal(1,"pressure frame skew");
        end
    endtask
    task run_frame;
        input [23:0] now_keys;
        input mode;
        begin
            // Complete feedback first, independently retire only released zero-busy lanes.
            @(negedge clk_sys);
            for(i=0;i<P;i=i+1)
            begin
                busy[i]=ref_alloc[i] && (ref_held[i] || (($random(seed)&3)!=0));
                if(ref_alloc[i] && !ref_held[i] && !busy[i])
                begin
                    ref_alloc[i]=0; ref_owner[i]=0; ref_pitch[i]=0;
                end
            end
            busy_valid=1;
            @(negedge clk_sys); busy_valid=0;
            wait(feedback_done);
            @(negedge clk_sys);
            presses=now_keys & ~previous;
            releases=~now_keys & previous;
            previous=now_keys;
            expected_on=0; expected_off=0; reserved=0;
            for(i=0;i<P;i=i+1)
                if(ref_alloc[i] && ref_held[i] && releases[ref_owner[i]])
                begin
                    ref_held[i]=0; expected_off[i]=1;
                end
            // Select by class + absolute timestamp, not the RTL's bounded age permutation.
            for(k=0;k<24;k=k+1)
            begin
                if(presses[k])
                begin
                    need=mode ? 3 : 1;
                    available=0;
                    for(i=0;i<P;i=i+1) if(!reserved[i]) available=available+1;
                    if(available>=need)
                    begin
                        for(t=0;t<need;t=t+1)
                        begin
                            best=-1; best_class=3;
                            for(i=0;i<P;i=i+1)
                            begin
                                klass=!ref_alloc[i] ? 0 : (!ref_held[i] ? 1 : 2);
                                if(!reserved[i] && (best<0 || klass<best_class ||
                                    (klass==best_class && klass!=0 && started[i]<started[best])))
                                begin
                                    best=i; best_class=klass;
                                end
                            end
                            selected[t]=best;
                            reserved[best]=1;
                        end
                        for(t=0;t<need;t=t+1)
                        begin
                            i=selected[t]; serial=serial+1;
                            ref_alloc[i]=1; ref_held[i]=1; ref_owner[i]=k;
                            ref_pitch[i]=60+k+((t==0) ? 0 : ((t==1) ? 4 : 7));
                            started[i]=serial;
                            expected_on[i]=1; expected_off[i]=0;
                        end
                    end
                end
            end
            keys=now_keys; play_mode=mode;
            for(i=0;i<24;i=i+1) pressure[i]=(frame_index*177+i*2039)&65535;
            in_valid=1;
            do @(posedge clk_sys); while(!in_ready);
            @(negedge clk_sys); in_valid=0;
            keys=~now_keys; play_mode=~mode;
            for(i=0;i<24;i=i+1) pressure[i]=16'hffff;
            cycles=0;
            while(!out_valid)
            begin
                @(negedge clk_sys); cycles=cycles+1;
                if(cycles>1400) $fatal(1,"allocator deadline");
            end
            if(cycles>max_cycles) max_cycles=cycles;
            for(stall=0;stall<frame_index%7+1;stall=stall+1)
            begin
                check;
                @(negedge clk_sys);
            end
            out_ready=1;
            @(negedge clk_sys); out_ready=0;
            if(out_valid) $fatal(1,"event repeated after acceptance");
            frame_index=frame_index+1;
        end
    endtask
    initial
    begin
        for(i=0;i<P;i=i+1)
        begin
            ref_owner[i]=0; ref_pitch[i]=0; started[i]=0;
        end
        for(i=0;i<24;i=i+1) pressure[i]=0;
        repeat(3) @(negedge clk_sys); rst_n=1;
        run_frame(24'h800000,1); // B5 expands above the physical keyboard.
        run_frame(24'h800000,0); // Held chord survives a global mode change.
        run_frame(24'h000000,0);
        run_frame(24'hffffff,1); // 24 simultaneous chords, first ten admitted at P=32.
        run_frame(24'h000000,1);
        run_frame(24'hffffff,0); // Normal full keyboard regression.
        run_frame(24'h000000,0);
        repeat(700) run_frame($random(seed),($random(seed)&1));
        run_frame(24'h000000,0);
        // Cancel an unaccepted transaction on reset, then verify first press semantics.
        rst_n=0; #1;
        if(out_valid || on_event || off_event || occupied) $fatal(1,"async reset");
        ref_alloc=0; ref_held=0; previous=0;
        for(i=0;i<P;i=i+1)
        begin
            ref_owner[i]=0; ref_pitch[i]=0; started[i]=0;
        end
        repeat(3) @(negedge clk_sys); rst_n=1;
        run_frame(24'h000001,1);
        test_passed=1;
        $display("CHORD_ALLOCATOR_PASS P=%0d frames=%0d max_cycles=%0d",P,frame_index,max_cycles);
        $finish;
    end
    initial begin #30000000; $fatal(1,"allocator watchdog"); end
endmodule
