/**
 * Schroeder 混响测试平台
 * 使用真实 audio_mix_buffer IP，观察 48 kHz 采样序号上的冲激响应，
 * 并检查 24 位 RAM、复位后的历史屏蔽和 valid-ready 握手。
 */

`timescale 1ps/1ps
`include "../../../src/defines.vh"

module reverb_tb();
    localparam CLK_SYS_PERIOD_CNT = 64'd1_000_000_000_000 / `CLK_SYS_FREQ;
    localparam [16:0] RAM_BASE_ADDR = 17'd8192;
    localparam [16:0] RAM_END_ADDR = RAM_BASE_ADDR + 17'd7494;

    reg clk_sys, rst_n;
    reg signed [20:0] audio_in;
    reg [15:0] reverb_mix, reverb_feedback, reverb_damping;
    reg in_valid, out_ready;
    wire in_ready, out_valid;
    wire signed [23:0] audio_out;
    wire ram_read_en, ram_write_en;
    wire [16:0] ram_read_addr, ram_write_addr;
    wire signed [23:0] ram_read_data, ram_write_data;

    reverb #(
        .MAX_POLYPHONY(32),
        .RAM_BASE_ADDR(RAM_BASE_ADDR)
    ) reverb_u (
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .audio_in(audio_in),
        .reverb_mix(reverb_mix),
        .reverb_feedback(reverb_feedback),
        .reverb_damping(reverb_damping),
        .audio_out(audio_out),
        .out_ready(out_ready),
        .in_valid(in_valid),
        .out_valid(out_valid),
        .in_ready(in_ready),
        .ram_read_en(ram_read_en),
        .ram_read_addr(ram_read_addr),
        .ram_read_data(ram_read_data),
        .ram_write_en(ram_write_en),
        .ram_write_addr(ram_write_addr),
        .ram_write_data(ram_write_data)
    );

    audio_mix_buffer ram_u (
        .dout(ram_read_data),
        .clka(clk_sys),
        .cea(ram_write_en),
        .clkb(clk_sys),
        .ceb(ram_read_en),
        .oce(1'b1),
        .reset(~rst_n),
        .ada(ram_write_addr),
        .din(ram_write_data),
        .adb(ram_read_addr)
    );

    GSR GSR (
        .GSRI(rst_n)
    );

    initial
    begin
        clk_sys = 1'b0;
        forever
        begin
            #(CLK_SYS_PERIOD_CNT / 2);
            clk_sys = ~clk_sys;
        end
    end

    integer scenario_id, sample_index, wet_count;
    integer read_count, write_count, stall_count;
    reg signed [20:0] impulse;
    reg signed [23:0] observed_audio, held_audio;
    reg first_write_seen;
    reg [16:0] pending_read_addr;
    reg pending_read;

    always @(posedge clk_sys)
    begin
        if (!rst_n)
            pending_read <= 1'b0;
        else
        begin
            if (ram_read_en && ram_write_en)
                $fatal(1, "Simultaneous RAM read and write");
            if (ram_read_en)
            begin
                read_count <= read_count + 1;
                pending_read_addr <= ram_read_addr;
                pending_read <= 1'b1;
                if (ram_read_addr < RAM_BASE_ADDR || ram_read_addr >= RAM_END_ADDR)
                    $fatal(1, "RAM read address out of reverb region: %0d", ram_read_addr);
            end
            if (ram_write_en)
            begin
                write_count <= write_count + 1;
                if (!pending_read || ram_write_addr !== pending_read_addr)
                    $fatal(1, "Reverb read/write address changed within a stage");
                pending_read <= 1'b0;
                if (ram_write_addr < RAM_BASE_ADDR || ram_write_addr >= RAM_END_ADDR)
                    $fatal(1, "RAM write address out of reverb region: %0d", ram_write_addr);
                if (sample_index == 0 && !first_write_seen)
                begin
                    first_write_seen <= 1'b1;
                    if (ram_write_addr !== RAM_BASE_ADDR ||
                        ram_write_data !== (impulse >>> 2))
                        $fatal(1, "First comb write lost 24-bit precision: %0d", ram_write_data);
                end
            end
        end
    end

    task send_sample;
        input signed [20:0] sample;
        input [15:0] mix, feedback, damping;
        begin
            @(negedge clk_sys);
            while (!in_ready)
                @(negedge clk_sys);
            audio_in = sample;
            reverb_mix = mix;
            reverb_feedback = feedback;
            reverb_damping = damping;
            in_valid = 1'b1;
            @(negedge clk_sys);
            in_valid = 1'b0;
            while (!out_valid)
            begin
                if (in_ready)
                    $fatal(1, "Input ready while processing sample %0d", sample_index);
                @(negedge clk_sys);
            end
            observed_audio = audio_out;
            held_audio = audio_out;
            if (mix == 16'd0 && observed_audio !== $signed(sample))
                $fatal(1, "Dry sample mismatch at %0d: got %0d expected %0d",
                       sample_index, observed_audio, sample);
            if (sample_index == 0 && observed_audio !== $signed(impulse))
                $fatal(1, "Dry impulse mismatch: %0d", observed_audio);
            if (mix != 16'd0 && sample_index > 0 &&
                sample_index < 1499 && observed_audio !== 24'sd0)
                $fatal(1, "Wet output before first comb tap at %0d: %0d",
                       sample_index, observed_audio);
            if (mix != 16'd0 && sample_index == 1499)
            begin
                if (impulse > 0 && observed_audio < 24'sd50000)
                    $fatal(1, "Positive first wet tap missing: %0d", observed_audio);
                if (impulse < 0 && observed_audio > -24'sd50000)
                    $fatal(1, "Negative first wet tap missing: %0d", observed_audio);
            end
            if (mix != 16'd0 && sample_index >= 1499 && observed_audio != 0)
                wet_count = wet_count + 1;

            // 下游暂停时保持音频输出和 out_valid，直到握手完成。
            repeat (2) @(negedge clk_sys);
            if (!out_valid || in_ready || audio_out !== held_audio)
                $fatal(1, "Output changed under backpressure at sample %0d", sample_index);
            stall_count = stall_count + 1;
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
        end
    endtask

    task run_impulse;
        input signed [20:0] peak;
        input integer sample_total;
        begin
            rst_n = 1'b0;
            in_valid = 1'b0;
            out_ready = 1'b0;
            impulse = peak;
            wet_count = 0;
            first_write_seen = 1'b0;
            repeat (4) @(negedge clk_sys);
            rst_n = 1'b1;
            for (sample_index = 0; sample_index < sample_total;
                 sample_index = sample_index + 1)
            begin
                send_sample(sample_index == 0 ? peak : 21'sd0,
                            sample_index == 0 ? 16'd0 : 16'hffff,
                            sample_index == 0 ? 16'd0 : 16'hc000,
                            16'h4000);
            end
            if (!first_write_seen || wet_count < 4)
                $fatal(1, "Impulse response incomplete: writes=%0d wet=%0d",
                       first_write_seen, wet_count);
            $display("PASS scenario %0d: %0d samples, %0d wet outputs, %0d reads, %0d writes",
                     scenario_id, sample_total, wet_count, read_count, write_count);
        end
    endtask

    initial
    begin
        rst_n = 1'b0;
        audio_in = '0;
        reverb_mix = '0;
        reverb_feedback = '0;
        reverb_damping = '0;
        in_valid = 1'b0;
        out_ready = 1'b0;
        scenario_id = 0;
        sample_index = 0;
        wet_count = 0;
        read_count = 0;
        write_count = 0;
        stall_count = 0;
        first_write_seen = 1'b0;
        observed_audio = '0;
        held_audio = '0;
        impulse = '0;

        scenario_id = 1;
        run_impulse(21'sd900000, 4000);
        scenario_id = 2;
        run_impulse(-21'sd900000, 2500);
        scenario_id = 3;
        rst_n = 1'b0;
        repeat (4) @(negedge clk_sys);
        rst_n = 1'b1;
        impulse = 21'sd123456;
        sample_index = 0;
        send_sample(impulse, 16'd0, 16'hf000, 16'hf000);
        sample_index = 1;
        send_sample(-21'sd234567, 16'd0, 16'hf000, 16'hf000);
        sample_index = 2;
        send_sample(21'sd0, 16'd0, 16'hf000, 16'hf000);
        $display("PASS reverb: both polarities, full 24-bit history, dry/wet, reset, RAM and handshake");
        $stop;
    end

    initial
    begin
        repeat (1_000_000) @(posedge clk_sys);
        $fatal(1, "Reverb test timed out");
    end
endmodule
