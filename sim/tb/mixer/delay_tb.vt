/**
 * 24 位反馈延迟测试平台
 * 使用真实 audio_mix_buffer IP，逐采样检查回声、参数改变、饱和、
 * 复位后的历史屏蔽、RAM 地址与 valid-ready 握手，并保留波形供 GUI 观察。
 * TB 连续发送采样以缩短仿真；sample_index 对应 48 kHz 的音频采样序号。
 */

`timescale 1ps/1ps
`include "../../../src/defines.vh"

module delay_tb();
    localparam CLK_SYS_PERIOD_CNT = 64'd1_000_000_000_000 / `CLK_SYS_FREQ;
    localparam [16:0] RAM_BASE_ADDR = 17'd8192;
    localparam [16:0] RAM_END_ADDR = RAM_BASE_ADDR + 17'd65536;

    reg clk_sys, rst_n;
    reg signed [23:0] audio_in;
    reg [15:0] delay_mix, delay_time, delay_feedback;
    reg in_valid, out_ready;
    wire in_ready, out_valid;
    wire signed [23:0] audio_out;
    wire ram_read_en, ram_write_en;
    wire [16:0] ram_read_addr, ram_write_addr;
    wire signed [23:0] ram_read_data, ram_write_data;

    delay #(
        .RAM_BASE_ADDR(RAM_BASE_ADDR)
    ) delay_u (
        .clk_sys(clk_sys),
        .rst_n(rst_n),
        .audio_in(audio_in),
        .delay_mix(delay_mix),
        .delay_time(delay_time),
        .delay_feedback(delay_feedback),
        .audio_out(audio_out),
        .out_ready(out_ready),
        .in_valid(in_valid),
        .out_valid(out_valid),
        .in_ready(in_ready),
        .ram_read_en(ram_read_en),
        .ram_read_addr(ram_read_addr),
        .ram_read_data(ram_read_data),
        .ram_write_en(ram_write_en),
        .ram_write_addr(ram_write_addr),
        .ram_write_data(ram_write_data)
    );

    audio_mix_buffer ram_u (
        .dout(ram_read_data),
        .clka(clk_sys),
        .cea(ram_write_en),
        .clkb(clk_sys),
        .ceb(ram_read_en),
        .oce(1'b1),
        .reset(~rst_n),
        .ada(ram_write_addr),
        .din(ram_write_data),
        .adb(ram_read_addr)
    );

    GSR GSR (
        .GSRI(rst_n)
    );

    initial
    begin
        clk_sys = 1'b0;
        forever
        begin
            #(CLK_SYS_PERIOD_CNT / 2);
            clk_sys = ~clk_sys;
        end
    end

    reg signed [23:0] reference_ram [0:65535];
    reg [15:0] reference_ptr;
    reg [16:0] reference_count;
    reg [16:0] expected_read_addr, expected_write_addr;
    reg signed [23:0] expected_audio, expected_write_data;
    reg signed [23:0] observed_audio;
    integer scenario_id, sample_index, read_seen, write_seen, transfer_count;

    function signed [23:0] sat24;
        input signed [63:0] value;
        begin
            if (value > 64'sd8388607)
                sat24 = 24'sh7fffff;
            else if (value < -64'sd8388608)
                sat24 = 24'sh800000;
            else
                sat24 = value[23:0];
        end
    endfunction

    function signed [25:0] mult_ref;
        input signed [24:0] a;
        input [15:0] coeff;
        reg signed [63:0] product, upper;
        begin
            product = a * $signed({1'b0, coeff});
            upper = product >>> 16;
            if (upper == 64'sd33554431 ||
                (product < 0 && product[15:0] == 16'h8000))
                mult_ref = upper[25:0];
            else
                mult_ref = upper + product[15];
        end
    endfunction

    always @(posedge clk_sys)
    begin
        if (rst_n)
        begin
            if (ram_read_en && ram_write_en)
                $fatal(1, "Simultaneous RAM read and write");
            if (ram_read_en)
            begin
                read_seen <= read_seen + 1;
                if (ram_read_addr !== expected_read_addr ||
                    ram_read_addr < RAM_BASE_ADDR || ram_read_addr >= RAM_END_ADDR)
                    $fatal(1, "Read address mismatch at sample %0d: %0d expected %0d",
                           sample_index, ram_read_addr, expected_read_addr);
            end
            if (ram_write_en)
            begin
                write_seen <= write_seen + 1;
                if (ram_write_addr !== expected_write_addr ||
                    ram_write_addr < RAM_BASE_ADDR || ram_write_addr >= RAM_END_ADDR)
                    $fatal(1, "Write address mismatch at sample %0d: %0d expected %0d",
                           sample_index, ram_write_addr, expected_write_addr);
                if (ram_write_data !== expected_write_data)
                    $fatal(1, "RAM data mismatch at sample %0d: %0d expected %0d",
                           sample_index, ram_write_data, expected_write_data);
            end
        end
    end

    task reset_case;
        begin
            rst_n = 1'b0;
            in_valid = 1'b0;
            out_ready = 1'b0;
            reference_ptr = '0;
            reference_count = '0;
            repeat (4) @(negedge clk_sys);
            rst_n = 1'b1;
        end
    endtask

    task send_sample;
        input signed [23:0] sample;
        input [15:0] mix, time_value, feedback;
        reg [15:0] effective_time, read_ptr;
        reg [15:0] effective_feedback;
        reg signed [23:0] delayed;
        reg signed [24:0] mix_delta;
        begin
            effective_time = time_value == 16'd0 ? 16'd1 : time_value;
            effective_feedback = feedback > 16'hf000 ? 16'hf000 : feedback;
            read_ptr = reference_ptr - effective_time;
            delayed = reference_count >= {1'b0, effective_time} ?
                      reference_ram[read_ptr] : 24'sd0;
            expected_read_addr = RAM_BASE_ADDR + {1'b0, read_ptr};
            expected_write_addr = RAM_BASE_ADDR + {1'b0, reference_ptr};
            expected_write_data = sat24($signed(sample) +
                                        mult_ref($signed({delayed[23], delayed}),
                                                 effective_feedback));
            mix_delta = $signed({delayed[23], delayed}) -
                        $signed({sample[23], sample});
            expected_audio = sat24($signed(sample) + mult_ref(mix_delta, mix));
            read_seen = 0;
            write_seen = 0;

            @(negedge clk_sys);
            while (!in_ready)
                @(negedge clk_sys);
            audio_in = sample;
            delay_mix = mix;
            delay_time = time_value;
            delay_feedback = feedback;
            in_valid = 1'b1;
            @(negedge clk_sys);
            in_valid = 1'b0;
            while (!out_valid)
            begin
                if (in_ready)
                    $fatal(1, "Input ready while processing sample %0d", sample_index);
                @(negedge clk_sys);
            end
            observed_audio = audio_out;
            if (audio_out !== expected_audio || read_seen != 1 || write_seen != 1)
                $fatal(1, "Output mismatch at scenario %0d sample %0d: got %0d expected %0d; reads=%0d writes=%0d",
                       scenario_id, sample_index, audio_out, expected_audio,
                       read_seen, write_seen);
            repeat (2) @(negedge clk_sys);
            if (!out_valid || in_ready || audio_out !== observed_audio)
                $fatal(1, "Output changed under backpressure at sample %0d", sample_index);
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
            reference_ram[reference_ptr] = expected_write_data;
            reference_ptr = reference_ptr + 16'd1;
            if (reference_count != 17'd65536)
                reference_count = reference_count + 17'd1;
            transfer_count = transfer_count + 1;
        end
    endtask

    initial
    begin
        rst_n = 1'b0;
        audio_in = '0;
        delay_mix = '0;
        delay_time = '0;
        delay_feedback = '0;
        in_valid = 1'b0;
        out_ready = 1'b0;
        reference_ptr = '0;
        reference_count = '0;
        observed_audio = '0;
        expected_audio = '0;
        expected_write_data = '0;
        expected_read_addr = '0;
        expected_write_addr = '0;
        scenario_id = 0;
        sample_index = 0;
        read_seen = 0;
        write_seen = 0;
        transfer_count = 0;

        scenario_id = 1;
        reset_case();
        for (sample_index = 0; sample_index < 96; sample_index = sample_index + 1)
            send_sample(sample_index == 0 ? 24'sd4000000 : 24'sd0,
                        16'h8000, 16'd4, 16'h8000);
        $display("PASS short positive echo and feedback");

        scenario_id = 2;
        reset_case();
        for (sample_index = 0; sample_index < 5100; sample_index = sample_index + 1)
            send_sample(sample_index == 0 ? -24'sd2000000 :
                        sample_index == 2500 ? 24'sd1000000 : 24'sd0,
                        16'h8000, 16'd2400, 16'hc000);
        $display("PASS long negative echo and overlapping input");

        scenario_id = 3;
        reset_case();
        for (sample_index = 0; sample_index < 128; sample_index = sample_index + 1)
            send_sample(sample_index[0] ? -24'sd7000000 : 24'sd7000000,
                        sample_index < 32 ? 16'd0 :
                        sample_index < 64 ? 16'hffff : 16'h8000,
                        sample_index < 32 ? 16'd7 :
                        sample_index < 64 ? 16'd3 :
                        sample_index < 96 ? 16'd0 : 16'hffff,
                        16'hffff);
        $display("PASS saturation, dry/wet, zero/max delay, parameter changes and reset");

        scenario_id = 4;
        reset_case();
        for (sample_index = 0; sample_index < 65537; sample_index = sample_index + 1)
            send_sample(sample_index == 0 ? 24'sd4000000 : 24'sd0,
                        16'h8000, 16'hffff, 16'd0);
        $display("PASS 65535-sample echo and 65536-address pointer wrap");
        $display("PASS delay: %0d valid-ready transfers with real Gowin SDP RAM",
                 transfer_count);
        $stop;
    end

    initial
    begin
        repeat (2_000_000) @(posedge clk_sys);
        $fatal(1, "Delay test timed out");
    end
endmodule
