/**
 * 单声部合唱测试平台。使用真实 audio_mix_buffer IP，逐采样检查
 * LFO、双抽头地址、线性插值、环形指针、复位历史屏蔽和握手背压。
 * 连续发送音频采样以缩短仿真，保留输出波形供 ModelSim GUI 观察。
 */

`timescale 1ps/1ps
`include "../../../src/defines.vh"

module chorus_tb();
    localparam CLK_SYS_PERIOD_CNT = 64'd1_000_000_000_000 / `CLK_SYS_FREQ;
    localparam [16:0] RAM_BASE_ADDR = 17'd73728;
    localparam [16:0] RAM_END_ADDR = RAM_BASE_ADDR + 17'd1024;
    localparam [18:0] STEP_K = 19'd357914;

    reg clk_sys, rst_n;
    reg signed [23:0] audio_in;
    reg [15:0] chorus_mix, chorus_rate;
    reg [7:0] chorus_depth;
    reg in_valid, out_ready;
    wire in_ready, out_valid;
    wire signed [23:0] audio_out;
    wire ram_read_en, ram_write_en;
    wire [16:0] ram_read_addr, ram_write_addr;
    wire signed [23:0] ram_read_data, ram_write_data;

    chorus #(
        .RAM_BASE_ADDR(RAM_BASE_ADDR)
    ) chorus_u (
        .clk_sys(clk_sys), .rst_n(rst_n),
        .audio_in(audio_in),
        .chorus_mix(chorus_mix),
        .chorus_rate(chorus_rate),
        .chorus_depth(chorus_depth),
        .audio_out(audio_out),
        .out_ready(out_ready), .in_valid(in_valid),
        .out_valid(out_valid), .in_ready(in_ready),
        .ram_read_en(ram_read_en), .ram_read_addr(ram_read_addr),
        .ram_read_data(ram_read_data),
        .ram_write_en(ram_write_en), .ram_write_addr(ram_write_addr),
        .ram_write_data(ram_write_data)
    );

    audio_mix_buffer ram_u (
        .dout(ram_read_data),
        .clka(clk_sys), .cea(ram_write_en),
        .clkb(clk_sys), .ceb(ram_read_en),
        .oce(1'b1), .reset(~rst_n),
        .ada(ram_write_addr), .din(ram_write_data),
        .adb(ram_read_addr)
    );

    GSR GSR (
        .GSRI(rst_n)
    );

    initial
    begin
        clk_sys = 1'b0;
        forever
        begin
            #(CLK_SYS_PERIOD_CNT / 2);
            clk_sys = ~clk_sys;
        end
    end

    reg signed [23:0] reference_ram [0:1023];
    reg [31:0] reference_phase;
    reg [9:0] reference_ptr;
    reg [10:0] reference_count;
    reg [16:0] expected_read_new_addr, expected_read_old_addr;
    reg [16:0] expected_write_addr;
    reg signed [23:0] expected_audio, expected_wet, observed_audio;
    integer scenario_id, sample_index, read_seen, write_seen, transfer_count;
    real wave_phase;

    function signed [23:0] sat24;
        input signed [63:0] value;
        begin
            if (value > 64'sd8388607)
                sat24 = 24'sh7fffff;
            else if (value < -64'sd8388608)
                sat24 = 24'sh800000;
            else
                sat24 = value[23:0];
        end
    endfunction

    function signed [25:0] mult_ref;
        input signed [24:0] a;
        input [15:0] coeff;
        reg signed [63:0] product, upper;
        begin
            product = a * $signed({1'b0, coeff});
            upper = product >>> 16;
            if (upper == 64'sd33554431 ||
                (product < 0 && product[15:0] == 16'h8000))
                mult_ref = upper[25:0];
            else
                mult_ref = upper + product[15];
        end
    endfunction

    always @(posedge clk_sys)
    begin
        if (rst_n)
        begin
            if (ram_read_en && ram_write_en)
                $fatal(1, "Simultaneous RAM read and write");
            if (ram_read_en)
            begin
                if (ram_read_addr < RAM_BASE_ADDR || ram_read_addr >= RAM_END_ADDR ||
                    (read_seen == 0 && ram_read_addr !== expected_read_new_addr) ||
                    (read_seen == 1 && ram_read_addr !== expected_read_old_addr))
                    $fatal(1, "RAM read mismatch at sample %0d: address=%0d read=%0d",
                           sample_index, ram_read_addr, read_seen);
                read_seen <= read_seen + 1;
            end
            if (ram_write_en)
            begin
                if (ram_write_addr !== expected_write_addr ||
                    ram_write_addr < RAM_BASE_ADDR || ram_write_addr >= RAM_END_ADDR ||
                    ram_write_data !== audio_in)
                    $fatal(1, "RAM write mismatch at sample %0d", sample_index);
                write_seen <= write_seen + 1;
            end
        end
    end

    task reset_case;
        begin
            rst_n = 1'b0;
            in_valid = 1'b0;
            out_ready = 1'b0;
            reference_phase = '0;
            reference_ptr = '0;
            reference_count = '0;
            repeat (4) @(negedge clk_sys);
            rst_n = 1'b1;
        end
    endtask

    task send_sample;
        input signed [23:0] sample;
        input [15:0] mix, rate;
        input [7:0] depth;
        reg [15:0] triangle;
        reg [23:0] offset;
        reg [9:0] delay_samples, read_new_ptr, read_old_ptr;
        reg signed [23:0] newer, older;
        reg signed [24:0] interp_delta, mix_delta;
        reg [34:0] step_product;
        reg [31:0] expected_phase;
        begin
            step_product = rate * STEP_K;
            expected_phase = reference_phase + step_product[34:16];
            triangle = reference_phase[31] ?
                       ~reference_phase[30:15] : reference_phase[30:15];
            offset = depth * triangle;
            delay_samples = 10'd256 + {2'b0, offset[23:16]};
            read_new_ptr = reference_ptr - delay_samples;
            read_old_ptr = reference_ptr - delay_samples - 10'd1;
            newer = reference_count >= {1'b0, delay_samples} ?
                    reference_ram[read_new_ptr] : 24'sd0;
            older = reference_count >= {1'b0, delay_samples} + 11'd1 ?
                    reference_ram[read_old_ptr] : 24'sd0;
            interp_delta = $signed({older[23], older}) -
                           $signed({newer[23], newer});
            expected_wet = sat24($signed(newer) +
                                 mult_ref(interp_delta, offset[15:0]));
            mix_delta = $signed({expected_wet[23], expected_wet}) -
                        $signed({sample[23], sample});
            expected_audio = sat24($signed(sample) + mult_ref(mix_delta, mix));
            expected_read_new_addr = RAM_BASE_ADDR + {7'd0, read_new_ptr};
            expected_read_old_addr = RAM_BASE_ADDR + {7'd0, read_old_ptr};
            expected_write_addr = RAM_BASE_ADDR + {7'd0, reference_ptr};
            read_seen = 0;
            write_seen = 0;

            @(negedge clk_sys);
            while (!in_ready)
                @(negedge clk_sys);
            audio_in = sample;
            chorus_mix = mix;
            chorus_rate = rate;
            chorus_depth = depth;
            in_valid = 1'b1;
            @(negedge clk_sys);
            in_valid = 1'b0;
            chorus_mix = ~mix;
            chorus_rate = ~rate;
            chorus_depth = ~depth;
            while (!out_valid)
            begin
                if (in_ready)
                    $fatal(1, "Input ready while processing sample %0d", sample_index);
                @(negedge clk_sys);
            end
            observed_audio = audio_out;
            if (audio_out !== expected_audio || chorus_u.wet_r !== expected_wet ||
                read_seen != 2 || write_seen != 1 ||
                chorus_u.phase_r !== expected_phase)
                $fatal(1, "Mismatch scenario %0d sample %0d: out=%0d expected=%0d wet=%0d expected=%0d reads=%0d writes=%0d",
                       scenario_id, sample_index, audio_out, expected_audio,
                       chorus_u.wet_r, expected_wet, read_seen, write_seen);
            repeat (2) @(negedge clk_sys);
            if (!out_valid || in_ready || audio_out !== observed_audio)
                $fatal(1, "Output changed under backpressure at sample %0d", sample_index);
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
            reference_ram[reference_ptr] = sample;
            reference_ptr = reference_ptr + 10'd1;
            if (reference_count != 11'd1024)
                reference_count = reference_count + 11'd1;
            reference_phase = expected_phase;
            transfer_count = transfer_count + 1;
        end
    endtask

    initial
    begin
        rst_n = 1'b0;
        audio_in = '0;
        chorus_mix = '0;
        chorus_rate = '0;
        chorus_depth = '0;
        in_valid = 1'b0;
        out_ready = 1'b0;
        reference_phase = '0;
        reference_ptr = '0;
        reference_count = '0;
        expected_audio = '0;
        expected_wet = '0;
        observed_audio = '0;
        scenario_id = 0;
        sample_index = 0;
        read_seen = 0;
        write_seen = 0;
        transfer_count = 0;

        scenario_id = 1;
        reset_case();
        for (sample_index = 0; sample_index < 700; sample_index = sample_index + 1)
        begin
            wave_phase = 6.283185307179586 * 440.0 * sample_index / 48000.0;
            send_sample($rtoi(24_000.0 * $sin(wave_phase)),
                        16'h9000, 16'h4000, 8'd96);
        end
        $display("PASS continuous 440 Hz waveform, startup history and parameter latch");

        scenario_id = 2;
        reset_case();
        for (sample_index = 0; sample_index < 12_100; sample_index = sample_index + 1)
            send_sample(((sample_index % 113) - 56) * 24'sd40_000,
                        16'h8000, 16'hffff, 8'hff);
        $display("PASS full LFO cycle, maximum depth, interpolation and RAM pointer wrap");

        scenario_id = 3;
        reset_case();
        for (sample_index = 0; sample_index < 1_100; sample_index = sample_index + 1)
            send_sample(sample_index[0] ? -24'sd8_000_000 : 24'sd8_000_000,
                        sample_index < 350 ? 16'd0 :
                        sample_index < 700 ? 16'hffff : 16'h4000,
                        16'd0,
                        sample_index < 550 ? 8'd0 : 8'hff);
        $display("PASS fixed delay, dry/wet extremes, high amplitude and reset");
        $display("PASS chorus: %0d valid-ready transfers with real Gowin SDP RAM",
                 transfer_count);
        $stop;
    end

    initial
    begin
        repeat (400_000) @(posedge clk_sys);
        $fatal(1, "Chorus test timed out");
    end
endmodule
