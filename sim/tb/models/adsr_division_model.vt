/**
 * 仿真专用ADSR除法器模型：非零divisor下计算UQ4.32结果，32级流水、低有效异步复位。
 * 仅替代仿真的原厂门级网表；综合仍使用src/adsr_division/adsr_division.v。
 * 已对照厂商网表逐拍检查整数/分数位、边界输入和中途复位；divisor=0不定义有效结果。
 */
`timescale 1ns/1ps
module adsr_division
(
    input clk,
    input rstn,
    input [3:0] dividend,
    input [19:0] divisor,
    output [31:0] remainder,
    output [3:0] quotient
);
    reg [35:0] pipeline_r [0:31];
    integer stage;
    assign quotient = pipeline_r[31][35:32];
    assign remainder = pipeline_r[31][31:0];
    always @(posedge clk or negedge rstn)
    begin
        if (!rstn)
        begin
            for (stage = 0; stage < 32; stage = stage + 1)
                pipeline_r[stage] <= 36'd0;
        end
        else
        begin
            pipeline_r[0] <= (divisor != 0) ? ({dividend, 32'd0} / divisor) : 36'd0;
            for (stage = 1; stage < 32; stage = stage + 1)
                pipeline_r[stage] <= pipeline_r[stage-1];
        end
    end
endmodule
