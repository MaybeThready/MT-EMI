/** Invalid odd pixel divider is rejected; no panel clock, writes or backlight. */
`timescale 1ns/1ps
module lcd_configuration_tb;
    parameter BAD_DIV=3;
    parameter BAD_WIDTH=1;
    parameter BAD_HEIGHT=1;
    GSR GSR (.GSRI(1'b1));
    reg clk=1'b0,rst_n=1'b0;
    wire word_ready,present_ready,configuration_error,lcd_clk,lcd_en,lcd_bl;
    wire [5:0] lcd_r,lcd_g,lcd_b;
    reg test_passed=1'b0;
    lcd_driver #(.PIXEL_DIV(BAD_DIV),.H_ACTIVE(BAD_WIDTH),.V_ACTIVE(BAD_HEIGHT)) lcd_driver_u (
        .clk(clk),.rst_n(rst_n),.word_valid(1'b1),.word_ready(word_ready),
        .word_kind(1'b0),.word_addr(12'd0),.word_data(32'd0),
        .present_valid(1'b1),.present_ready(present_ready),.frame_start(),.frame_active(),.address_error(),
        .configuration_error(configuration_error),.lcd_clk(lcd_clk),.lcd_en(lcd_en),
        .lcd_r(lcd_r),.lcd_g(lcd_g),.lcd_b(lcd_b),.lcd_bl(lcd_bl),.lcd_hs_n(),.lcd_vs_n()
    );
    always #5 clk=~clk;
    initial
    begin
        #22;rst_n=1'b1;
        repeat(30) @(negedge clk);
        if(!configuration_error || {word_ready,present_ready,lcd_clk,lcd_en,lcd_bl,lcd_r,lcd_g,lcd_b}!==23'd0)
            $fatal(1,"Invalid configuration not contained");
        test_passed=1'b1;$display("LCD_CONFIGURATION_PASS div=%0d width=%0d height=%0d",BAD_DIV,BAD_WIDTH,BAD_HEIGHT);$finish;
    end
endmodule
