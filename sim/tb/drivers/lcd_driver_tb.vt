/**
 * Independent panel-edge scoreboard: every active/blank pixel, glyphs, columns,
 * sparse clear, pending-write protection, three atomic scene swaps and reset.
 * Parameters cover /2,/4,/6, non-cell-aligned sizes, no porches and full 800x480.
 * Optional +PPM=path exports actual sampled RGB of scene 1 (not a mockup).
 */
`timescale 1ns/1ps
module lcd_driver_tb;
    parameter PIXEL_DIV = 4;
    parameter H_ACTIVE = 65;
    parameter V_ACTIVE = 33;
    parameter H_BACK = 3;
    parameter H_FRONT = 5;
    parameter V_BACK = 2;
    parameter V_FRONT = 3;
    localparam H_TOTAL = H_ACTIVE+H_BACK+H_FRONT;
    localparam V_TOTAL = V_ACTIVE+V_BACK+V_FRONT;
    localparam CELLS = ((H_ACTIVE+7)/8)*((V_ACTIVE+15)/16);
    GSR GSR (.GSRI(1'b1));
    reg clk=1'b0, rst_n=1'b0;
    reg word_valid=1'b0, word_kind=1'b0, present_valid=1'b0;
    reg [11:0] word_addr=12'd0;
    reg [31:0] word_data=32'd0;
    wire word_ready, present_ready, frame_start, frame_active, address_error, configuration_error;
    wire lcd_clk,lcd_en,lcd_bl,lcd_hs_n,lcd_vs_n;
    wire [5:0] lcd_r,lcd_g,lcd_b;
    reg test_passed=1'b0;
    reg [7:0] font [0:2047];
    integer commits=0, panel_scene=0, completed=0, samples=0, pixels=0;
    integer px,py,cx,cy,cell_addr,idx,lo,hi,ch,colour,fd=0;
    integer written=0;
    integer system_edges=0;
    integer model_version=0;
    integer version_pipe [0:3];
    integer stage;
    reg [17:0] expected_rgb;
    reg expected_de;
    reg [18:0] stable_data;
    reg [1023:0] ppm_path;
    time last_rise=0;
    lcd_driver #(
        .PIXEL_DIV(PIXEL_DIV),.H_ACTIVE(H_ACTIVE),.V_ACTIVE(V_ACTIVE),
        .H_BACK(H_BACK),.H_FRONT(H_FRONT),.V_BACK(V_BACK),.V_FRONT(V_FRONT)
    ) lcd_driver_u (
        .clk(clk),.rst_n(rst_n),.word_valid(word_valid),.word_ready(word_ready),
        .word_kind(word_kind),.word_addr(word_addr),.word_data(word_data),
        .present_valid(present_valid),.present_ready(present_ready),
        .frame_start(frame_start),.frame_active(frame_active),.address_error(address_error),
        .configuration_error(configuration_error),.lcd_clk(lcd_clk),.lcd_en(lcd_en),
        .lcd_r(lcd_r),.lcd_g(lcd_g),.lcd_b(lcd_b),.lcd_bl(lcd_bl),.lcd_hs_n(lcd_hs_n),.lcd_vs_n(lcd_vs_n)
    );
    always #5 clk=~clk;
    always @(posedge clk or negedge rst_n)
    begin
        if(!rst_n)
        begin
            model_version<=0;
            for(stage=0;stage<4;stage=stage+1) version_pipe[stage]<=0;
        end
        else
        begin
            if(present_valid&&present_ready) model_version<=model_version+1;
            version_pipe[0]<=model_version;
            for(stage=1;stage<4;stage=stage+1) version_pipe[stage]<=version_pipe[stage-1];
        end
    end
    always @(negedge rst_n)
    begin
        commits=0;panel_scene=0;samples=0;pixels=0;last_rise=0;system_edges=0;
    end
    function [17:0] palette;
        input integer c;
        begin
            case(c)
                0:palette=18'd0;
                6:palette={6'd63,6'd0,6'd0};
                8:palette={6'd4,6'd6,6'd8};
                9:palette={6'd6,6'd9,6'd12};
                10:palette={6'd10,6'd16,6'd19};
                12:palette={6'd20,6'd54,6'd55};
                14:palette={6'd63,6'd51,6'd25};
                15:palette={6'd57,6'd59,6'd60};
                default:palette=18'h3ffff;
            endcase
        end
    endfunction
    function integer wave_y;
        input integer x;
        begin
            // Test-only sampled sinusoid; real PCM processing belongs upstream.
            wave_y=$rtoi((V_ACTIVE-1)/2.0 + ((V_ACTIVE-1)/4.0)*$sin(x*6.283185307179586/128.0));
        end
    endfunction
    function integer wave_lo;
        input integer x;
        integer a,b;
        begin
            a=wave_y(x);b=wave_y((x>0)?x-1:x);
            wave_lo=(a<b)?a:b;
        end
    endfunction
    function integer wave_hi;
        input integer x;
        integer a,b;
        begin
            a=wave_y(x);b=wave_y((x>0)?x-1:x);
            wave_hi=(a>b)?a:b;
        end
    endfunction
    task send_word;
        input kind;
        input integer addr;
        input [31:0] data;
        begin
            @(negedge clk);
            word_valid=1'b1; word_kind=kind; word_addr=addr; word_data=data;
            @(posedge clk);
            while (!word_ready) @(posedge clk);
            @(negedge clk); word_valid=1'b0;
        end
    endtask
    task present;
        begin
            @(negedge clk); present_valid=1'b1;
            @(posedge clk);
            while(!present_ready) @(posedge clk);
            @(negedge clk); present_valid=1'b0;
        end
    endtask
    task build_scene;
        input integer version;
        integer x,y;
        reg [31:0] data;
        begin
            for(x=0;x<H_ACTIVE;x=x+1)
            begin
                y=wave_y(x);
                if(version==1) data=(32'd1<<22)|(32'd12<<18)|(wave_hi(x)<<9)|wave_lo(x);
                else data=(32'd1<<22)|(32'd14<<18)|((V_ACTIVE*3/4)<<9)|(V_ACTIVE/4);
                send_word(1'b1,x,data);
            end
            send_word(1'b0,0,(32'd1<<15)|(32'd9<<11)|(32'd15<<7)|((version==1)?32'd65:32'd66));
            if(CELLS>1) send_word(1'b0,CELLS-1,(32'd14<<7)|32'd90);
        end
    endtask
    always @(posedge clk)
    begin
        if(rst_n) system_edges=system_edges+1;
        if(rst_n && present_valid && present_ready) commits=commits+1;
        if(rst_n && present_valid && word_ready) $fatal(1,"Writes allowed during pending present");
    end
    always @(posedge lcd_clk)
    begin
        stable_data={lcd_en,lcd_r,lcd_g,lcd_b};
        #0.001;
        if(rst_n)
        begin
            if(last_rise!=0 && $time-last_rise!=PIXEL_DIV*10) $fatal(1,"PCLK period");
            last_rise=$time;
            if(((system_edges-1)%PIXEL_DIV)!=((PIXEL_DIV/2+5)%PIXEL_DIV))
                $fatal(1,"PCLK phase disagrees with registered scan/SDC contract");
            if(stable_data!=={lcd_en,lcd_r,lcd_g,lcd_b}) $fatal(1,"RGB/DE unstable at rising edge");
            cx=samples%H_TOTAL; cy=(samples/H_TOTAL)%V_TOTAL;
            if(cx==0 && cy==0) panel_scene=version_pipe[3];
            if(panel_scene!=version_pipe[3]) $fatal(1,"Scene tore within a frame");
            expected_de=(cx>=H_BACK && cx<H_BACK+H_ACTIVE && cy>=V_BACK && cy<V_BACK+V_ACTIVE);
            idx=0;
            if(expected_de && panel_scene>0)
            begin
                px=cx-H_BACK; py=cy-V_BACK;
                idx=((px%64==0)||(py%64==0))?10:8;
                if(panel_scene==1)
                begin
                    lo=wave_lo(px); hi=wave_hi(px); colour=12;
                end
                else if(panel_scene==2)
                begin
                    lo=V_ACTIVE/4; hi=V_ACTIVE*3/4; colour=14;
                end
                else
                begin
                    lo=V_ACTIVE/2; hi=lo; colour=6;
                end
                if((panel_scene<3 || px==H_ACTIVE-1) && py>=lo && py<=hi) idx=colour;
                cell_addr=(py/16)*((H_ACTIVE+7)/8)+px/8;
                ch=0;
                if(panel_scene<3)
                begin
                    if(cell_addr==0)
                    begin
                        ch=(panel_scene==1)?65:66; idx=9; colour=15;
                    end
                    else if(cell_addr==CELLS-1)
                    begin
                        ch=90; colour=14;
                    end
                    if(ch!=0 && ((font[ch*16+py%16]>>(7-px%8))&1)) idx=colour;
                end
            end
            expected_rgb=palette(idx);
            if(lcd_en!==expected_de || {lcd_r,lcd_g,lcd_b}!==expected_rgb)
                $fatal(1,"Panel mismatch scene=%0d raster=%0d,%0d expected=%h got=%h DE=%b/%b",panel_scene,cx,cy,expected_rgb,{lcd_r,lcd_g,lcd_b},expected_de,lcd_en);
            if(expected_de)
            begin
                pixels=pixels+1;
                if(fd!=0 && panel_scene==1)
                begin
                    $fwrite(fd,"%0d %0d %0d\n",{lcd_r,2'b00},{lcd_g,2'b00},{lcd_b,2'b00});
                    written=written+1;
                end
            end
            if(cx==H_TOTAL-1 && cy==V_TOTAL-1)
            begin
                if(pixels!=H_ACTIVE*V_ACTIVE) $fatal(1,"Active pixel count");
                pixels=0;
                if(panel_scene>0) completed=panel_scene;
            end
            samples=samples+1;
        end
    end
    initial
    begin
        $readmemh("../assets/drivers/lcd_font.hex",font);
        if($value$plusargs("PPM=%s",ppm_path))
        begin
            fd=$fopen(ppm_path,"w");
            $fwrite(fd,"P3\n%0d %0d\n255\n",H_ACTIVE,V_ACTIVE);
        end
        #32; @(negedge clk); rst_n=1'b1;
        build_scene(1);
        // Invalid address, reversed range, reserved bits: consume but do not corrupt.
        send_word(1'b1,H_ACTIVE,32'd0);
        send_word(1'b0,CELLS,32'd0);
        if(V_ACTIVE>1) send_word(1'b1,0,(32'd1<<22)|32'd1);
        send_word(1'b1,0,32'h80000000);
        if(!address_error) $fatal(1,"Invalid word not reported");
        present;
        build_scene(2);
        // Keep a valid transaction waiting during clear without changing data.
        present;
        send_word(1'b1,H_ACTIVE-1,(32'd1<<22)|(32'd6<<18)|((V_ACTIVE/2)<<9)|(V_ACTIVE/2));
        present;
        wait(completed>=3);
        if(fd!=0)
        begin
            if(written!=H_ACTIVE*V_ACTIVE) $fatal(1,"PPM count");
            $fclose(fd);
        end
        @(negedge clk); rst_n=1'b0;
        #0.001;
        if({lcd_clk,lcd_en,lcd_r,lcd_g,lcd_b,lcd_bl,frame_active,address_error}!==23'd0)
            $fatal(1,"Async reset exposed stale data");
        @(negedge clk); rst_n=1'b1;
        repeat(20) @(negedge clk);
        if(frame_active) $fatal(1,"Reset retained scene");
        test_passed=1'b1;
        $display("LCD_STREAM_PANEL_PASS size=%0dx%0d div=%0d scenes=3 pixels_per_frame=%0d",H_ACTIVE,V_ACTIVE,PIXEL_DIV,H_ACTIVE*V_ACTIVE);
        $finish;
    end
    initial
    begin
        #250000000;
        $fatal(1,"LCD timeout");
    end
endmodule
