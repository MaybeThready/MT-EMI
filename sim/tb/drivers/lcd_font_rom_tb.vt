/** Actual SDPB font initialization, all 2048 rows, blank codes, A known shape. */
`timescale 1ns/1ps
module lcd_font_rom_tb;
    GSR GSR (.GSRI(1'b1));
    reg clk=1'b0,rst_n=1'b0;
    reg [6:0] ascii_code=7'd0;
    reg [3:0] glyph_y=4'd0;
    wire [7:0] glyph_row;
    reg [7:0] expected [0:2047];
    integer i;
    reg test_passed=1'b0;
    lcd_font_rom lcd_font_rom_u (.clk(clk),.rst_n(rst_n),.ascii_code(ascii_code),.glyph_y(glyph_y),.glyph_row(glyph_row));
    always #5 clk=~clk;
    initial
    begin
        $readmemh("../assets/drivers/lcd_font.hex",expected);
        #20; rst_n=1'b1;
        for(i=0;i<2048;i=i+1)
        begin
            @(negedge clk); ascii_code=i/16; glyph_y=i%16;
            @(posedge clk); #1;
            if(glyph_row!==expected[i]) $fatal(1,"Glyph row %0d",i);
        end
        if(expected[65*16+1]!==8'h38 || expected[65*16+7]!==8'h7c) $fatal(1,"Known A shape");
        test_passed=1'b1;
        $display("LCD_FONT_PASS rows=2048"); $finish;
    end
endmodule
