/**
 * SDP存储自检：真实SDPB、16/32位数据、跨块尾地址、读使能与独立读写。
 */
`timescale 1ns/1ps
module lcd_sdp_ram_tb;
    parameter DATA_WIDTH=16;
    parameter DEPTH=2051;
    GSR GSR (.GSRI(1'b1));
    reg clk=1'b0,rst_n=1'b0,wr_en=1'b0,rd_en=1'b0;
    reg [11:0] wr_addr=12'd0,rd_addr=12'd0;
    reg [DATA_WIDTH-1:0] wr_data=0;
    wire [DATA_WIDTH-1:0] rd_data;
    reg [DATA_WIDTH-1:0] held;
    integer i;
    reg test_passed=1'b0;
    lcd_sdp_ram #(.DATA_WIDTH(DATA_WIDTH),.DEPTH(DEPTH),.ADDR_WIDTH(12)) lcd_sdp_ram_u (
        .clk(clk),.rst_n(rst_n),.wr_en(wr_en),.wr_addr(wr_addr),.wr_data(wr_data),
        .rd_en(rd_en),.rd_addr(rd_addr),.rd_data(rd_data)
    );
    always #5 clk=~clk;
    function [DATA_WIDTH-1:0] pattern;
        input integer addr;
        begin
            pattern=(32'hdeaf0031^(addr*32'h01010101));
        end
    endfunction
    initial
    begin
        #20; rst_n=1'b1;
        for(i=0;i<DEPTH;i=i+1)
        begin
            @(negedge clk); wr_en=1'b1; wr_addr=i; wr_data=pattern(i);
        end
        @(negedge clk); wr_en=1'b0;
        for(i=DEPTH-1;i>=0;i=i-1)
        begin
            @(negedge clk); rd_en=1'b1; rd_addr=i;
            @(posedge clk); #1;
            if(rd_data!==pattern(i)) $fatal(1,"RAM width=%0d addr=%0d expected=%h actual=%h",DATA_WIDTH,i,pattern(i),rd_data);
        end
        held=rd_data;
        @(negedge clk); rd_en=1'b0; rd_addr=DEPTH;
        repeat(3) @(negedge clk);
        if(rd_data!==held) $fatal(1,"Disabled read changed output");
        @(negedge clk);
        wr_en=1'b1;wr_addr=DEPTH-1;wr_data=pattern(DEPTH+1);
        rd_en=1'b1;rd_addr=0;
        @(posedge clk);#1;
        if(rd_data!==pattern(0)) $fatal(1,"Independent ports");
        @(negedge clk);wr_en=1'b0;rd_addr=DEPTH-1;
        @(posedge clk);#1;
        if(rd_data!==pattern(DEPTH+1)) $fatal(1,"Concurrent write lost");
        test_passed=1'b1; $display("LCD_SDP_PASS width=%0d depth=%0d",DATA_WIDTH,DEPTH); $finish;
    end
endmodule
