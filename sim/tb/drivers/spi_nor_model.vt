`timescale 1ns/1ps
/**
 * 引脚级 SPI NOR 行为模型：命令/地址/页边界、WEL/WIP、SFDP 和延迟输出。
 * 存储器独立于 DUT 复位；支持拒绝写使能、忙超时、编程损坏及掉电部分写入。
 * 仅用于功能验证；不是厂商模型或电气签核。数据校验不复用 DUT CRC 实现。
 */
module spi_nor_model
(
    input clk_sys,
    input cs_n,
    input sck,
    input mosi,
    output miso
);
    reg [7:0] memory [0:131071];
    reg [7:0] page_buffer [0:255];
    reg [7:0] command;
    reg [23:0] address;
    reg [7:0] shift_byte;
    reg miso_r = 1'b1;
    reg wel = 1'b0;
    integer busy_cycles = 0;
    integer program_cycles = 200;
    integer erase_cycles = 400;
    integer received_bits = 0;
    integer program_count = 0;
    integer pending_kind = 0;
    integer pending_address = 0;
    integer pending_count = 0;
    integer command_count = 0;
    integer erase_count = 0;
    integer program_commands = 0;
    integer read_count = 0;
    integer i;
    integer output_index;
    integer output_bit;
    reg [7:0] output_byte;
    reg reject_wren = 1'b0;
    reg stuck_busy = 1'b0;
    reg corrupt_program = 1'b0;
    reg bad_sfdp = 1'b0;
    reg bad_id = 1'b0;
    reg [1:0] address_mode = 2'd0;
    reg [3:0] page_exponent = 4'd8;
    reg [7:0] erase_opcode = 8'h20;
    reg [23:0] configured_id = 24'hef4018;
    time last_sck_change = 0;
    time last_cs_rise = 0;
    time last_mosi_change = 0;
    reg check_timing = 1'b1;
    assign #8 miso = cs_n ? 1'bz : miso_r;

    initial
    begin
        for (i = 0; i < 131072; i = i + 1) memory[i] = 8'hff;
    end

    // Independent memory completion; resetting FPGA does not cancel a chip operation.
    task complete_operation;
        input integer limit;
        integer n;
        integer count;
        begin
            count = (limit < pending_count) ? limit : pending_count;
            if (pending_kind == 1)
            begin
                for (n = 0; n < count; n = n + 1)
                    memory[(pending_address & 131071) + n] = memory[(pending_address & 131071) + n] & page_buffer[n];
                if (corrupt_program && count > 0)
                    memory[pending_address & 131071] = 8'h00;
            end
            else if (pending_kind == 2)
            begin
                for (n = 0; n < count; n = n + 1)
                    memory[(pending_address & 131071) + n] = 8'hff;
            end
            pending_kind = 0;
            busy_cycles = 0;
        end
    endtask

    task power_cut;
        input integer completed_bytes;
        begin
            complete_operation(completed_bytes);
            wel = 1'b0;
        end
    endtask

    always @(posedge clk_sys)
    begin
        if (busy_cycles > 0 && !stuck_busy)
        begin
            busy_cycles = busy_cycles - 1;
            if (busy_cycles == 0) complete_operation(4096);
        end
    end

    function [7:0] sfdp_byte;
        input integer index;
        begin
            sfdp_byte = 8'h00;
            case (index)
                0: sfdp_byte = bad_sfdp ? 8'h00 : 8'h53;
                1: sfdp_byte = 8'h46;
                2: sfdp_byte = 8'h44;
                3: sfdp_byte = 8'h50;
                4: sfdp_byte = 8'h06;
                5: sfdp_byte = 8'h01;
                6: sfdp_byte = 8'h00;
                7: sfdp_byte = 8'hff;
                8: sfdp_byte = 8'h00;
                9: sfdp_byte = 8'h06;
                10: sfdp_byte = 8'h01;
                11: sfdp_byte = 8'd16;
                12: sfdp_byte = 8'h30;
                15: sfdp_byte = 8'hff;
                48: sfdp_byte = 8'h01;
                49: sfdp_byte = erase_opcode;
                50: sfdp_byte = {5'd0, address_mode, 1'b0};
                52, 53, 54: sfdp_byte = 8'hff;
                55: sfdp_byte = 8'h07;
                88: sfdp_byte = {page_exponent, 4'd0};
                default: ;
            endcase
        end
    endfunction

    always @(mosi) last_mosi_change = $time;
    always @(negedge cs_n)
    begin
        if (check_timing && last_cs_rise != 0 && ($time - last_cs_rise < 40))
            $fatal(1, "Flash CS high gap too short");
        received_bits = 0;
        program_count = 0;
        command = 8'h00;
        address = 24'd0;
        shift_byte = 8'd0;
        miso_r = 1'b1;
    end

    always @(posedge sck)
    begin
        if (!cs_n)
        begin
            if (check_timing && $time - last_mosi_change < 2)
                $fatal(1, "Flash MOSI setup violation");
            shift_byte = {shift_byte[6:0], mosi};
            received_bits = received_bits + 1;
            if ((received_bits % 8) == 0)
            begin
                if (received_bits == 8)
                begin
                    command = shift_byte;
                    command_count = command_count + 1;
                    if (command == 8'h03) read_count = read_count + 1;
                end
                else if ((command == 8'h03 || command == 8'h02 || command == 8'h20 || command == 8'h5a)
                    && received_bits <= 32) address = {address[15:0], shift_byte};
                else if (command == 8'h02 && received_bits > 32)
                begin
                    if (program_count >= 256) $fatal(1, "Page program overflow");
                    page_buffer[program_count] = shift_byte;
                    program_count = program_count + 1;
                end
            end
        end
        last_sck_change = $time;
    end

    always @(negedge sck)
    begin
        if (!cs_n)
        begin
            output_byte = 8'hff;
            output_index = received_bits / 8;
            output_bit = 7 - (received_bits % 8);
            if (command == 8'h05 && output_index >= 1)
                output_byte = {6'd0, wel, (busy_cycles > 0 || stuck_busy)};
            else if (command == 8'h9f && output_index >= 1 && output_index <= 3)
                output_byte = bad_id ? 8'hff : (configured_id >> (8*(3-output_index)));
            else if (command == 8'h5a && output_index >= 5)
                output_byte = sfdp_byte(address + output_index - 5);
            else if (command == 8'h03 && output_index >= 4)
            begin
                if (address < 24'hfe0000) $fatal(1, "Read outside reserved region");
                output_byte = memory[(address & 131071) + output_index - 4];
            end
            miso_r = output_byte[output_bit];
        end
        last_sck_change = $time;
    end

    always @(posedge cs_n)
    begin
        last_cs_rise = $time;
        if (received_bits >= 8 && (received_bits % 8) == 0 && busy_cycles == 0 && !stuck_busy)
        begin
            if (command == 8'h06 && !reject_wren) wel = 1'b1;
            if (command == 8'h02 && wel && program_count > 0)
            begin
                if (address < 24'hfe0000 || (address[7:0] + program_count > 256))
                    $fatal(1, "Illegal program address/page crossing");
                pending_kind = 1;
                pending_address = address;
                pending_count = program_count;
                busy_cycles = program_cycles;
                program_commands = program_commands + 1;
                wel = 1'b0;
            end
            if (command == 8'h20 && wel && received_bits == 32)
            begin
                if (address < 24'hfe0000 || address[11:0] != 0)
                    $fatal(1, "Illegal erase address");
                pending_kind = 2;
                pending_address = address;
                pending_count = 4096;
                busy_cycles = erase_cycles;
                erase_count = erase_count + 1;
                wel = 1'b0;
            end
            if (command != 8'h03 && command != 8'h02 && command != 8'h20 && command != 8'h06
                && command != 8'h05 && command != 8'h9f && command != 8'h5a && command != 8'hab)
                $fatal(1, "Unexpected/destructive opcode %h", command);
        end
    end
endmodule
