/**
 * 测试板载ADC请求/完成协议、弯音位置标定、回中/平滑、双路、背压及超时复位。
 * 同时串联单音频率换算，0/0.5/1V应得到-200/0/+200音分；正确后打印PASS。
 * ADCLRC为本文件的协议行为模型，不仿真模拟精度，不能与厂商同名空壳一起编译。
 */
`timescale 1ns/1ps

module pitch_bend_driver_tb();
    localparam real CLK_HALF_NS = 1.0e9 / (2.0 * 98_304_000.0);
    reg clk_sys;
    reg rst_n;
    reg scan_tick_up;
    reg out_ready;
    wire [15:0] bend_value [0:0];
    wire out_valid;
    wire adc_error;
    wire mapper_ready;
    wire mapper_valid;
    wire [31:0] note_freq;
    reg mapper_out_ready;
    reg regression_passed;
    reg regression_failed;
    reg main_done;
    reg variant_done;
    integer phase;
    integer clock_count;
    integer checked_frames;
    integer checked_frequencies;
    integer main_requests_before_stall;
    integer count_before;
    integer i;
    reg [15:0] held_bend;
    reg was_stalled;
    reg [15:0] stall_bend;
    reg [31:0] frequency_expected [0:8191];
    integer frequency_write;
    integer frequency_read;
    integer frequency_error;
    real expected_hz;
    real cents;
    real previous_request_time;

    pitch_bend_driver dut_u
    (
        .clk_sys(clk_sys), .rst_n(rst_n), .scan_tick_up(scan_tick_up),
        .out_ready(out_ready && mapper_ready), .bend_value(bend_value),
        .out_valid(out_valid), .adc_error(adc_error)
    );

    pitch_bend_frequency_mapper frequency_u
    (
        .clk_sys(clk_sys), .rst_n(rst_n), .base_freq(32'd28835840),
        .bend_value(bend_value[0]), .in_valid(out_valid && out_ready),
        .in_ready(mapper_ready), .note_freq(note_freq),
        .out_valid(mapper_valid), .out_ready(mapper_out_ready)
    );

    reg [1:0] variant_ready;
    wire [15:0] variant_bend [1:0];
    wire variant_valid;
    wire variant_error;
    pitch_bend_driver
    #(
        .BEND_NUM(2), .DEBOUNCE_TICKS(0), .ADC_STARTUP_TICKS(128),
        .FILTER_SHIFT(0), .ADC_MIN_CODE(128), .ADC_CENTER_CODE(1024),
        .ADC_MAX_CODE(1920), .CENTER_DEADBAND(4), .DIRECTION_INVERT(2'b10)
    ) variant_u
    (
        .clk_sys(clk_sys), .rst_n(rst_n), .scan_tick_up(scan_tick_up),
        .out_ready(variant_ready[0]), .bend_value(variant_bend),
        .out_valid(variant_valid), .adc_error(variant_error)
    );

    task automatic fail;
        input [8*180-1:0] reason;
        begin
            regression_failed = 1'b1;
            regression_passed = 1'b0;
            $display("FAIL: %0s (phase=%0d, time=%0t)", reason, phase, $time);
            $fatal(1, "pitch_bend_driver_tb failed");
        end
    endtask

    function automatic [15:0] calibrated_reference;
        input integer raw;
        input integer minimum_code;
        input integer center_code;
        input integer maximum_code;
        input integer deadband;
        input integer inverted;
        real position;
        integer result;
        begin
            if (raw <= minimum_code)
                result = 0;
            else if (raw >= maximum_code)
                result = 65535;
            else if (raw < center_code - deadband)
            begin
                position = (raw - minimum_code) * 32768.0 /
                           (center_code - deadband - minimum_code);
                result = $rtoi(position + 0.5);
            end
            else if (raw > center_code + deadband)
            begin
                position = (raw - center_code - deadband) * 32767.0 /
                           (maximum_code - center_code - deadband);
                result = 32768 + $rtoi(position + 0.5);
            end
            else
                result = 32768;
            if (inverted && result != 32768)
                result = 65535 - result;
            calibrated_reference = result[15:0];
        end
    endfunction

    task automatic wait_main_position;
        input [15:0] expected;
        integer start_completed;
        begin
            start_completed = dut_u.adc_u.completed_count;
            while (!(out_valid && bend_value[0] === expected))
            begin
                @(negedge clk_sys);
                if (dut_u.adc_u.completed_count - start_completed > 64)
                    fail("main position did not settle within 64 ADC conversions");
            end
        end
    endtask

    task automatic wait_variant_positions;
        input [15:0] expected_0;
        input [15:0] expected_1;
        integer start_completed;
        begin
            start_completed = variant_u.adc_u.completed_count;
            while (!(variant_valid && variant_bend[0] === expected_0 &&
                     variant_bend[1] === expected_1))
            begin
                @(negedge clk_sys);
                if (variant_u.adc_u.completed_count - start_completed > 8)
                begin
                    $display("variant expected=%h/%h, actual=%h/%h", expected_0,
                             expected_1, variant_bend[0], variant_bend[1]);
                    fail("dual-channel calibration or direction differs from reference");
                end
            end
        end
    endtask

    initial
    begin
        clk_sys = 1'b0;
        forever #(CLK_HALF_NS) clk_sys = ~clk_sys;
    end

    always @(posedge clk_sys or negedge rst_n)
    begin
        if (!rst_n)
        begin
            clock_count <= 0;
            scan_tick_up <= 1'b0;
        end
        else if (clock_count == 8191)
        begin
            clock_count <= 0;
            scan_tick_up <= 1'b1;
        end
        else
        begin
            clock_count <= clock_count + 1;
            scan_tick_up <= 1'b0;
        end
    end

    always @(posedge dut_u.adc_u.ADCREQI or negedge rst_n)
    begin
        if (!rst_n)
            previous_request_time = 0.0;
        else
        begin
            if (previous_request_time != 0.0 &&
                $realtime - previous_request_time < 999999.9)
                fail("default acquisition requests violated the minimum 1ms interval");
            previous_request_time = $realtime;
        end
    end

    always @(posedge clk_sys or negedge rst_n)
    begin
        if (!rst_n)
        begin
            was_stalled = 1'b0;
            stall_bend = 16'h8000;
            frequency_write = 0;
            frequency_read = 0;
        end
        else
        begin
            if (was_stalled && (!out_valid || bend_value[0] !== stall_bend))
                fail("driver changed valid or bend data under backpressure");
            was_stalled = out_valid && !(out_ready && mapper_ready);
            stall_bend = bend_value[0];
            if (out_valid && out_ready && mapper_ready)
            begin
                if (bend_value[0] <= 16'h8000)
                    cents = (bend_value[0] - 32768.0) * 200.0 / 32768.0;
                else
                    cents = (bend_value[0] - 32768.0) * 200.0 / 32767.0;
                expected_hz = 440.0 * (2.0 ** (cents / 1200.0));
                if (frequency_write >= 8192)
                    fail("frequency reference queue exhausted");
                frequency_expected[frequency_write] = $rtoi(expected_hz * 65536.0 + 0.5);
                frequency_write = frequency_write + 1;
                checked_frames = checked_frames + 1;
            end
            if (mapper_valid && mapper_out_ready)
            begin
                if (frequency_read >= frequency_write)
                    fail("frequency mapper produced an unexpected output");
                if (note_freq >= frequency_expected[frequency_read])
                    frequency_error = note_freq - frequency_expected[frequency_read];
                else
                    frequency_error = frequency_expected[frequency_read] - note_freq;
                // LUT插值允许0.02音分，在440Hz附近小于0.006Hz；留512个UQ16.16码。
                if (frequency_error > 512)
                    fail("ADC-to-single-note frequency exceeds mathematical error limit");
                frequency_read = frequency_read + 1;
                checked_frequencies = checked_frequencies + 1;
            end
            if (variant_valid && variant_u.adc_u.completed_count < 2)
                fail("dual-channel driver published before both ADC channels completed");
            if (variant_error)
                fail("dual-channel nominal test reported ADC timeout");
        end
    end

    initial
    begin
        regression_passed = 1'b0;
        regression_failed = 1'b0;
        rst_n = 1'b0;
        out_ready = 1'b1;
        mapper_out_ready = 1'b1;
        variant_ready = 2'b01;
        phase = 0;
        main_done = 1'b0;
        variant_done = 1'b0;
        checked_frames = 0;
        checked_frequencies = 0;
        repeat (8) @(negedge clk_sys);
        if (out_valid !== 1'b0 || adc_error !== 1'b0 || bend_value[0] !== 16'h8000)
            fail("reset output must be invalid neutral with no error");
        rst_n = 1'b1;

        phase = 1;
        wait_main_position(16'h8000);
        if (adc_error) fail("nominal first conversion timed out");
        if (dut_u.adc_u.completed_count < 1)
            fail("driver published a valid frame before the first ADC result");
        // 中心死区应吸收小范围抖动，不能把回中噪声变成音高改变。
        for (i = 0; i < 4; i = i + 1)
        begin
            @(negedge clk_sys);
            dut_u.adc_u.voltage_code[0] = (i[0] ? 14'd1018 : 14'd1030);
            count_before = dut_u.adc_u.completed_count;
            wait (dut_u.adc_u.completed_count >= count_before + 2);
            wait_main_position(16'h8000);
        end

        phase = 2;
        @(negedge clk_sys); dut_u.adc_u.voltage_code[0] = 14'd0;
        wait_main_position(16'h0000);
        @(negedge clk_sys); dut_u.adc_u.voltage_code[0] = 14'd2048;
        count_before = dut_u.adc_u.completed_count;
        wait (dut_u.adc_u.completed_count >= count_before + 2);
        if (!(bend_value[0] > 16'h0000 && bend_value[0] < 16'hFFFF))
            fail("IIR must smooth a full-range step instead of jumping immediately");
        wait_main_position(16'hFFFF);

        phase = 3;
        // 下游实际停止接收，ADC仍须继续工作，恢复后交付最新电压位置。
        @(negedge clk_sys); mapper_out_ready = 1'b0;
        wait (out_valid && !mapper_ready);
        @(negedge clk_sys);
        held_bend = bend_value[0];
        main_requests_before_stall = dut_u.adc_u.request_count;
        dut_u.adc_u.voltage_code[0] = 14'd0;
        count_before = dut_u.adc_u.completed_count;
        wait (dut_u.adc_u.completed_count >= count_before + 36);
        if (bend_value[0] !== held_bend || !out_valid)
            fail("stalled output snapshot was overwritten by newer ADC data");
        if (dut_u.adc_u.request_count <= main_requests_before_stall + 4)
            fail("ADC acquisition stopped under downstream backpressure");
        @(negedge clk_sys); mapper_out_ready = 1'b1;
        wait_main_position(16'h0000);

        phase = 4;
        // 持续运动不需要保持某个原码达到消抖时间，输出应持续跟随。
        for (i = 1; i <= 12; i = i + 1)
        begin
            @(negedge clk_sys);
            dut_u.adc_u.voltage_code[0] = i * 160;
            count_before = dut_u.adc_u.completed_count;
            wait (dut_u.adc_u.completed_count >= count_before + 1);
        end
        repeat (2) @(negedge clk_sys);
        if (bend_value[0] <= 16'h4000)
            fail("continuously moving wheel became stuck waiting for stable ADC code");
        @(negedge clk_sys); dut_u.adc_u.voltage_code[0] = 14'd1024;
        wait_main_position(16'h8000);

        phase = 5;
        // 让上一帧RDY始终为高；必须超时，不能误收旧结果或新电压。
        wait (!dut_u.adc_u.busy);
        @(negedge clk_sys);
        dut_u.adc_u.hold_old_ready = 1'b1;
        dut_u.adc_u.voltage_code[0] = 14'd2048;
        wait (adc_error);
        if (bend_value[0] !== 16'h8000)
            fail("old RDY high was mistaken for completion of a new conversion");
        @(negedge clk_sys); dut_u.adc_u.hold_old_ready = 1'b0;
        wait_main_position(16'hFFFF);
        if (!adc_error) fail("ADC timeout diagnostic must remain set until reset");

        phase = 6;
        // 已经进入忙碌却始终不完成，也须超时复位ADC，取消迟到的旧转换。
        wait (!dut_u.adc_u.busy);
        @(negedge clk_sys);
        dut_u.adc_u.suppress_ready = 1'b1;
        dut_u.adc_u.voltage_code[0] = 14'd0;
        @(negedge dut_u.adc_u.DRSTN);
        if (!rst_n || bend_value[0] !== 16'hFFFF)
            fail("unfinished conversion must be canceled without replacing the last good position");
        @(negedge clk_sys);
        dut_u.adc_u.suppress_ready = 1'b0;
        dut_u.adc_u.voltage_code[0] = 14'd1024;
        wait_main_position(16'h8000);

        phase = 7;
        // 在下一次转换和输出事务进行中复位；中断旧事务并清除错误。
        wait (dut_u.adc_u.busy);
        @(negedge clk_sys); rst_n = 1'b0;
        dut_u.adc_u.voltage_code[0] = 14'd1024;
        repeat (8) @(negedge clk_sys);
        if (out_valid || adc_error || bend_value[0] !== 16'h8000)
            fail("reset did not cancel pending output and clear timeout");
        rst_n = 1'b1;
        wait_main_position(16'h8000);
        if (adc_error) fail("ADC failed to recover after reset");
        main_done = 1'b1;
    end

    integer variant_index;
    integer raw_0;
    integer raw_1;
    initial
    begin
        wait (rst_n);
        wait_variant_positions(16'h8000, 16'h8000);
        for (variant_index = 0; variant_index < 9; variant_index = variant_index + 1)
        begin
            raw_0 = 128 + variant_index * 224;
            raw_1 = 1920 - variant_index * 224;
            @(negedge clk_sys);
            variant_u.adc_u.voltage_code[0] = raw_0;
            variant_u.adc_u.voltage_code[1] = raw_1;
            wait_variant_positions(calibrated_reference(raw_0,128,1024,1920,4,0),
                                   calibrated_reference(raw_1,128,1024,1920,4,1));
        end
        // 校准范围以外应饱和，并保持两路方向独立。
        @(negedge clk_sys);
        variant_u.adc_u.voltage_code[0] = 14'd0;
        variant_u.adc_u.voltage_code[1] = 14'd2048;
        wait_variant_positions(16'h0000, 16'h0000);
        @(negedge clk_sys);
        variant_u.adc_u.voltage_code[0] = 14'h3FFF;
        variant_u.adc_u.voltage_code[1] = 14'd0;
        wait_variant_positions(16'hFFFF, 16'hFFFF);
        variant_done = 1'b1;
    end

    initial
    begin
        wait (main_done && variant_done);
        repeat (2048) @(negedge clk_sys);
        if (regression_failed || frequency_read != frequency_write)
            fail("previous failure or outstanding frequency transactions remain");
        else
        begin
            regression_passed = 1'b1;
            $display("PASS: pitch_bend_driver_tb checked %0d position frames and %0d single-note frequencies",
                     checked_frames, checked_frequencies);
            $stop;
        end
    end

    initial
    begin
        #300_000_000;
        if (!regression_passed)
            fail("testbench watchdog expired");
    end
endmodule

/**
 * ADCLRC协议模型：外部模拟脚不经过HDL端口，通过voltage_code设置Q3.11电压码。
 * RDY会保持至下次REQ，REQ后4个ADC时钟变低，1024个ADC时钟后重新升高。
 * 仅验证数字交互，不模拟量化噪声、校准误差、模拟建立时间或芯片内部实现。
 */
module ADCLRC
#(
    parameter DYN_BKEN = "FALSE",
    parameter BUF_SERDES_Q1_EN = 3'b000,
    parameter BUF_BK2_EN = 6'b000000,
    parameter BUF_BK3_EN = 6'b000000,
    parameter BUF_BK4_EN = 6'b000000,
    parameter BUF_BK5_EN = 6'b000000,
    parameter BUF_BK10_EN = 5'b00000,
    parameter BUF_BK11_EN = 5'b00000,
    parameter CLK_SEL = 1'b0,
    parameter PIOCLK_SEL = 1'b0,
    parameter VSEN_CTL = 3'b000,
    parameter VSEN_CTL_SEL = 1'b0,
    parameter ADC_MODE = 1'b0,
    parameter DIV_CTL = 2'd0,
    parameter SAMPLE_CNT_SEL = 3'd4,
    parameter RATE_CHANGE_CTRL = 3'd4
)(
    input ADCINBK2A, input ADCINBK2B,
    input ADCINBK3A, input ADCINBK3B,
    input ADCINBK4A, input ADCINBK4B,
    input ADCINBK5A, input ADCINBK5B,
    input [2:0] VSENCTL,
    input [9:0] FSCAL_VALUE,
    input [11:0] OFFSET_VALUE,
    input ADCEN, input CLK, input DRSTN, input ADCREQI,
    output ADCRDY, output [13:0] ADCVALUE
);
    reg [13:0] voltage_code [0:1];
    reg suppress_ready;
    reg hold_old_ready;
    reg ready_r;
    reg [13:0] result_r;
    reg previous_request;
    reg busy;
    reg [13:0] captured_code;
    reg [2:0] captured_channel;
    integer cycles_remaining;
    integer deassert_delay;
    integer request_count;
    integer completed_count;
    integer high_cycles;
    real last_clock_edge;
    assign ADCRDY = ready_r;
    assign ADCVALUE = result_r;

    initial
    begin
        voltage_code[0] = 14'd1024;
        voltage_code[1] = 14'd1024;
        suppress_ready = 1'b0;
        hold_old_ready = 1'b0;
        last_clock_edge = 0.0;
        request_count = 0;
        completed_count = 0;
        if (ADC_MODE != 1'b1 || CLK_SEL != 1'b1 || DIV_CTL != 2'd0 ||
            VSEN_CTL_SEL != 1'b1 || SAMPLE_CNT_SEL != 3'd4 || RATE_CHANGE_CTRL != 3'd5 ||
            BUF_BK2_EN != 0 || BUF_BK3_EN != 0 || BUF_BK4_EN != 0 || BUF_BK5_EN != 0 ||
            BUF_BK10_EN != 0 || BUF_BK11_EN != 0 || BUF_SERDES_Q1_EN != 0)
            pitch_bend_driver_tb.fail("ADCLRC must select dedicated voltage pins and documented conversion configuration");
    end

    always @(posedge CLK or negedge DRSTN)
    begin
        if (!DRSTN)
        begin
            last_clock_edge = 0.0;
            ready_r <= 1'b0;
            result_r <= 14'd0;
            previous_request <= 1'b0;
            busy <= 1'b0;
            captured_code <= 14'd0;
            captured_channel <= 3'd0;
            cycles_remaining <= 0;
            deassert_delay <= 0;
            // ADC恢复复位取消旧转换；统计仅在整个平台复位时清零。
            if (!pitch_bend_driver_tb.rst_n)
            begin
                request_count <= 0;
                completed_count <= 0;
            end
            high_cycles <= 0;
        end
        else
        begin
            if (last_clock_edge != 0.0 && $realtime - last_clock_edge < 500.0)
                pitch_bend_driver_tb.fail("ADC clock exceeds the conservative 2MHz limit");
            last_clock_edge = $realtime;
            previous_request <= ADCREQI;
            if (FSCAL_VALUE !== 10'd653 || OFFSET_VALUE !== 12'd0)
                pitch_bend_driver_tb.fail("ADCLRC voltage calibration constants differ from the documented defaults");
            if (ADCREQI)
                high_cycles <= high_cycles + 1;
            else if (previous_request)
            begin
                if (high_cycles < 2)
                    pitch_bend_driver_tb.fail("ADC request was shorter than two ADC clock cycles");
                high_cycles <= 0;
            end
            if (ADCREQI && !previous_request)
            begin
                if (!ADCEN || VSENCTL > 3'd1)
                    pitch_bend_driver_tb.fail("ADC request used a disabled or unsupported analog channel");
                if (busy && !suppress_ready && !hold_old_ready)
                    pitch_bend_driver_tb.fail("overlapping ADC requests before prior conversion completed");
                busy <= 1'b1;
                request_count <= request_count + 1;
                captured_channel <= VSENCTL;
                captured_code <= voltage_code[VSENCTL];
                deassert_delay <= 4;
                cycles_remaining <= 1024;
            end
            else if (busy && !hold_old_ready)
            begin
                if (deassert_delay > 0)
                    deassert_delay <= deassert_delay - 1;
                else
                    ready_r <= 1'b0;
                if (cycles_remaining > 0)
                    cycles_remaining <= cycles_remaining - 1;
                else if (!suppress_ready)
                begin
                    ready_r <= 1'b1;
                    result_r <= captured_code;
                    completed_count <= completed_count + 1;
                    busy <= 1'b0;
                end
            end
        end
    end
endmodule
