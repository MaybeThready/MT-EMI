/** Scene ownership, sparse defaults, transparent/opaque text, out-of-range words. */
`timescale 1ns/1ps
module lcd_scene_tb;
    GSR GSR (.GSRI(1'b1));
    reg clk=1'b0,rst_n=1'b0,word_valid=1'b0,word_kind=1'b0,present_valid=1'b0,frame_boundary=1'b0;
    reg scan_active=1'b1;
    reg [11:0] word_addr=12'd0;
    reg [31:0] word_data=32'd0;
    reg [9:0] scan_x=10'd1;
    reg [8:0] scan_y=9'd1;
    wire word_ready,present_ready,frame_active,address_error;
    wire [3:0] pixel_index;
    reg test_passed=1'b0;
    lcd_scene #(.H_ACTIVE(16),.V_ACTIVE(16)) lcd_scene_u (
        .clk(clk),.rst_n(rst_n),.word_valid(word_valid),.word_ready(word_ready),
        .word_kind(word_kind),.word_addr(word_addr),.word_data(word_data),
        .present_valid(present_valid),.present_ready(present_ready),.frame_boundary(frame_boundary),
        .frame_active(frame_active),.address_error(address_error),
        .scan_active(scan_active),.scan_x(scan_x),.scan_y(scan_y),.pixel_index(pixel_index)
    );
    always #5 clk=~clk;
    task write_word;
        input k;
        input [11:0] a;
        input [31:0] d;
        begin
            @(negedge clk); word_valid=1'b1;word_kind=k;word_addr=a;word_data=d;
            @(posedge clk);while(!word_ready) @(posedge clk);
            @(negedge clk);word_valid=1'b0;
        end
    endtask
    task commit;
        begin
            @(negedge clk);present_valid=1'b1;
            repeat(5)
            begin
                @(negedge clk);
                if(present_ready || word_ready) $fatal(1,"Pending scene accepted early");
            end
            frame_boundary=1'b1;
            @(negedge clk);present_valid=1'b0;frame_boundary=1'b0;
        end
    endtask
    task check;
        input [9:0] x;
        input [8:0] y;
        input [3:0] expected;
        begin
            @(negedge clk);scan_x=x;scan_y=y;
            repeat(4) @(negedge clk);
            if(pixel_index!==expected) $fatal(1,"Scene pixel %0d,%0d expected=%0d actual=%0d",x,y,expected,pixel_index);
        end
    endtask
    initial
    begin
        #22;rst_n=1'b1;
        check(1,1,0);
        write_word(1,1,(32'd1<<22)|(32'd12<<18)|(32'd3<<9)|32'd1);
        write_word(0,1,(32'd1<<15)|(32'd9<<11)|32'd32);
        check(1,1,0);
        commit;
        check(1,1,12);
        check(1,4,8);
        check(8,1,9);
        write_word(1,16,32'd0);
        if(!address_error) $fatal(1,"Missing address error");
        // Do not change a good front while building its replacement.
        write_word(1,1,(32'd1<<22)|(32'd6<<18)|(32'd3<<9)|32'd1);
        check(1,1,12);
        commit;
        check(1,1,6);
        check(8,1,8);
        // Empty scene after automatic clear must not expose stale char/graph data.
        wait(word_ready);commit;
        check(1,1,8);
        @(negedge clk);scan_active=1'b0;
        repeat(4) @(negedge clk);
        if(pixel_index!==0) $fatal(1,"Blanking not black");
        test_passed=1'b1;$display("LCD_SCENE_PASS ownership=1 sparse_clear=1 layers=1");$finish;
    end
    initial
    begin
        #100000;$fatal(1,"Scene timeout");
    end
endmodule
