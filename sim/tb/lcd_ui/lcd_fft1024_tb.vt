/**
 * Independent generated fixed-point reference plus NumPy FFT accuracy audit.
 * All513 positive bin_count of17 vectors, raw PCM peak, Hann gain, saturation,
 * valid/ready stability, natural order, release count and reset in load/FFT.
 */
`timescale 1ns/1ps
module lcd_fft1024_tb;
    localparam CASES=17;
    GSR GSR (.GSRI(1'b1));
    reg clk_sys=1'b0, rst_n=1'b0, start_valid=1'b0;
    always #5 clk_sys=~clk_sys;
    reg [31:0] window_seq=32'd0;
    reg signed [15:0] pcm_rd_data=16'sd0;
    reg out_ready=1'b0;
    wire start_ready, pcm_rd_en, window_release, busy, done, out_valid;
    wire [9:0] pcm_rd_addr, out_index;
    wire signed [15:0] out_real, out_imag;
    wire [15:0] out_magnitude, pcm_peak;
    wire [31:0] out_seq;
    wire fft_overflow, amplitude_clipped, configuration_error;
    wire invalid_configuration, invalid_ready;
    reg [15:0] samples [0:CASES*1024-1];
    reg [47:0] expected [0:CASES*513-1];
    reg [1:0] flags [0:CASES-1];
    integer vector=0, reads=0, releases=0, bin_count=0, cycles=0, k, magnitude, expected_peak;
    reg checking=1'b0, stalled=1'b0;
    reg [107:0] held;
    wire [107:0] bundle={out_seq,out_index,out_real,out_imag,out_magnitude,pcm_peak,fft_overflow,amplitude_clipped};
    reg test_passed=1'b0;
    lcd_fft1024 lcd_fft1024_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .start_valid(start_valid), .start_ready(start_ready),
        .window_seq(window_seq), .pcm_rd_en(pcm_rd_en), .pcm_rd_addr(pcm_rd_addr), .pcm_rd_data(pcm_rd_data),
        .window_release(window_release), .busy(busy), .done(done), .out_valid(out_valid), .out_ready(out_ready),
        .out_index(out_index), .out_real(out_real), .out_imag(out_imag), .out_magnitude(out_magnitude),
        .out_seq(out_seq), .pcm_peak(pcm_peak), .fft_overflow(fft_overflow),
        .amplitude_clipped(amplitude_clipped), .configuration_error(configuration_error)
    );
    lcd_fft1024 #(.MAX_OUTPUT_BIN(513)) invalid_configuration_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .start_valid(1'b1), .start_ready(invalid_ready),
        .window_seq(32'd0), .pcm_rd_en(), .pcm_rd_addr(), .pcm_rd_data(16'sd0),
        .window_release(), .busy(), .done(), .out_valid(), .out_ready(1'b1),
        .out_index(), .out_real(), .out_imag(), .out_magnitude(), .out_seq(), .pcm_peak(),
        .fft_overflow(), .amplitude_clipped(), .configuration_error(invalid_configuration)
    );
    always @(posedge clk_sys)
    begin
        if (!rst_n)
        begin
            reads=0; releases=0; bin_count=0; cycles=0; stalled=1'b0;
        end
        else
        begin
            cycles=cycles+1;
            if (start_valid && start_ready)
            begin
                reads=0; releases=0; bin_count=0;
            end
            if (pcm_rd_en)
            begin
                if (pcm_rd_addr!==reads[9:0] || reads>=1024) $fatal(1,"FFT PCM read order");
                pcm_rd_data<=samples[vector*1024+pcm_rd_addr];
                reads=reads+1;
            end
            if (window_release)
            begin
                releases=releases+1;
                if (reads!=1024 || releases!=1) $fatal(1,"FFT early/double release");
            end
            if (checking)
            begin
                if (stalled && (!out_valid || bundle!==held)) $fatal(1,"FFT output changed under backpressure");
                stalled=out_valid && !out_ready;
                held=bundle;
                if (out_valid && out_ready)
                begin
                    if (out_index!==bin_count[9:0] || out_seq!==window_seq ||
                        {out_magnitude,out_imag,out_real}!==expected[vector*513+bin_count])
                        $fatal(1,"FFT mismatch vector=%0d bin=%0d got=%h expected=%h",vector,bin_count,{out_magnitude,out_imag,out_real},expected[vector*513+bin_count]);
                    bin_count=bin_count+1;
                end
            end
        end
    end
    always @(negedge clk_sys) out_ready=(cycles%11 < 7);
    task offer;
        begin
            @(negedge clk_sys);
            window_seq=window_seq+32'd1;
            start_valid=1'b1;
            if (!start_ready) $fatal(1,"FFT not ready at job start");
            @(negedge clk_sys);
            start_valid=1'b0;
        end
    endtask
    task reset_fft;
        begin
            @(negedge clk_sys);
            rst_n=1'b0; start_valid=1'b0;
            #1;
            if (out_valid || busy || window_release) $fatal(1,"FFT reset cancel");
            repeat (3) @(negedge clk_sys);
            rst_n=1'b1;
        end
    endtask
    initial
    begin
        $readmemh("../assets/lcd_ui/fft_input.hex",samples);
        $readmemh("../assets/lcd_ui/fft_expected.hex",expected);
        $readmemh("../assets/lcd_ui/fft_flags.hex",flags);
        reset_fft;
        #1;
        if (!invalid_configuration || invalid_ready) $fatal(1,"FFT invalid bin range");
        offer;
        wait (reads==100);
        reset_fft;
        offer;
        wait (window_release);
        repeat (100) @(negedge clk_sys);
        reset_fft;
        checking=1'b1;
        for (vector=0; vector<CASES; vector=vector+1)
        begin
            expected_peak=0;
            for (k=0; k<1024; k=k+1)
            begin
                magnitude=$signed(samples[vector*1024+k]);
                if (magnitude<0) magnitude=-magnitude;
                if (magnitude>expected_peak) expected_peak=magnitude;
            end
            offer;
            wait (done);
            @(negedge clk_sys);
            if (bin_count!=513 || releases!=1 || pcm_peak!==expected_peak[15:0] ||
                {amplitude_clipped,fft_overflow}!==flags[vector] || configuration_error)
                $fatal(1,"FFT metadata vector=%0d bin_count=%0d flags=%b expected=%b peak=%0d",vector,bin_count,{amplitude_clipped,fft_overflow},flags[vector],pcm_peak);
            $display("FFT_VECTOR_PASS vector=%0d bin_count=%0d peak=%0d flags=%b",vector,bin_count,pcm_peak,flags[vector]);
            @(negedge clk_sys);
        end
        test_passed=1'b1;
        $display("LCD_FFT1024_PASS vectors=17 bin_count=8721 Hann scale sqrt stall reset flags real_sdp");
        $finish;
    end
    initial
    begin
        #30000000;
        $fatal(1,"FFT watchdog");
    end
endmodule
