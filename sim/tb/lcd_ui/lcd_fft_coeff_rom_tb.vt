/**
 * 系数ROM自检：覆盖全部1024相位、象限端点、同步读延迟、输出保持及复位。
 */
`timescale 1ns/1ps
module lcd_fft_coeff_rom_tb;
    GSR GSR (.GSRI(1'b1));
    reg clk=1'b0, rst_n=1'b0, en=1'b0;
    always #5 clk=~clk;
    reg [9:0] phase=10'd0;
    wire signed [16:0] coefficient;
    reg [16:0] expected [0:1023];
    reg [16:0] held;
    reg test_passed=1'b0;
    integer k;
    lcd_fft_coeff_rom lcd_fft_coeff_rom_u (
        .clk(clk), .rst_n(rst_n), .en(en), .phase(phase), .coefficient(coefficient)
    );
    initial
    begin
        $readmemh("../assets/lcd_ui/fft_cosine.hex",expected);
        repeat (3) @(negedge clk);
        rst_n=1'b1;
        for (k=0; k<1024; k=k+1)
        begin
            @(negedge clk);
            en=1'b1; phase=k;
            @(posedge clk);
            #1;
            if (coefficient !== expected[k]) $fatal(1,"coefficient phase=%0d got=%0d wanted=%0d",k,coefficient,$signed(expected[k]));
        end
        @(negedge clk);
        en=1'b0; held=coefficient;
        repeat (20)
        begin
            phase=phase+10'd47;
            @(negedge clk);
            if (coefficient!==held) $fatal(1,"coefficient hold");
        end
        test_passed=1'b1;
        $display("LCD_FFT_COEFF_ROM_PASS phases=1024 real_sdp exact_plus_minus_one hold");
        $finish;
    end
endmodule
