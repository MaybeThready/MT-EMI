`timescale 1ns/1ps

/** Check that the LCD scene accepts every AutoPlay tile and rejects the next address. */
module lcd_autoplay_tiles_tb;
    GSR GSR(.GSRI(1'b1));
    reg clk=1'b0, rst_n=1'b0, word_valid=1'b0;
    always #5 clk=~clk;
    reg [11:0] word_addr=12'd0;
    reg [31:0] word_data=32'd0;
    wire word_ready, address_error;
    reg test_passed=1'b0;
    integer tile;

    lcd_scene dut (
        .clk(clk), .rst_n(rst_n),
        .word_valid(word_valid), .word_ready(word_ready),
        .word_kind(1'b0), .word_addr(word_addr), .word_data(word_data),
        .present_valid(1'b0), .present_ready(), .frame_boundary(1'b0),
        .frame_active(), .address_error(address_error),
        .scan_active(1'b0), .scan_x(10'd0), .scan_y(9'd0),
        .pixel_index(), .pixel_phase()
    );

    initial begin
        repeat (4) @(negedge clk);
        rst_n=1'b1;
        wait (word_ready);
        for (tile=1977; tile<=2002; tile=tile+1) begin
            @(negedge clk);
            word_addr=tile-1977;
            word_data={15'd0,4'd15,tile[12:0]};
            word_valid=1'b1;
            @(negedge clk);
            word_valid=1'b0;
            if (address_error) $fatal(1,"AutoPlay tile rejected: %0d",tile);
        end
        @(negedge clk);
        word_addr=12'd26;
        word_data={15'd0,4'd15,13'd2003};
        word_valid=1'b1;
        @(negedge clk);
        word_valid=1'b0;
        if (!address_error) $fatal(1,"Out-of-range tile accepted");
        test_passed=1'b1;
        $display("LCD_AUTOPLAY_TILES_PASS tiles=1977..2002 boundary=2003");
        $stop;
    end
    initial begin
        #100000;
        $fatal(1,"LCD AutoPlay tile watchdog");
    end
endmodule
