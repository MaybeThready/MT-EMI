/**
 * 新旧字库及联合仿真模型核对：32768字节tile、3072文字程序、2048数字映射全址。
 * RAM16x3000/32x2048跨全部块写读、CE保持、异步复位；对照真实GW5A SDPB。
 */
`timescale 1ns/1ps
module lcd_chord_memory_tb;
    GSR GSR(.GSRI(1'b1));
    reg clk=0,rst_n=0,en=0,write=0;
    always #5 clk=~clk;
    reg [14:0] a=0;
    reg [11:0] text_addr=0,ram_addr=0;
    reg [10:0] glyph_addr=0;
    reg [31:0] data=0;
    wire [7:0] tile_actual,tile_expected;
    wire [31:0] text_actual,text_expected,r32_actual,r32_expected;
    wire [12:0] glyph_actual,glyph_expected;
    wire [15:0] r16_actual,r16_expected;
    wire signed [16:0] coeff_actual,coeff_expected;
    reg test_passed=0;
    integer i;
    lcd_tile_rom t0(clk,rst_n,en,{2'd0,a[14:4]},a[3:0],tile_actual);
    lcd_tile_rom_model t1(clk,rst_n,en,{2'd0,a[14:4]},a[3:0],tile_expected);
    lcd_text_rom x0(clk,rst_n,en,text_addr,text_actual);
    lcd_text_rom_model x1(clk,rst_n,en,text_addr,text_expected);
    lcd_glyph_rom g0(clk,rst_n,en,glyph_addr[10:9],glyph_addr[8:4],glyph_addr[3:0],glyph_actual);
    lcd_glyph_rom_model g1(clk,rst_n,en,glyph_addr[10:9],glyph_addr[8:4],glyph_addr[3:0],glyph_expected);
    lcd_fft_coeff_rom c0(clk,rst_n,en,a[9:0],coeff_actual);
    lcd_fft_coeff_rom_model c1(clk,rst_n,en,a[9:0],coeff_expected);
    lcd_sdp_ram r0(clk,rst_n,write,ram_addr,data[15:0],en,ram_addr,r16_actual);
    lcd_sdp_ram_model r1(clk,rst_n,write,ram_addr,data[15:0],en,ram_addr,r16_expected);
    lcd_sdp_ram #(.DATA_WIDTH(32),.DEPTH(2048)) r2(clk,rst_n,write,ram_addr,data,en,ram_addr,r32_actual);
    lcd_sdp_ram_model #(.DATA_WIDTH(32),.DEPTH(2048)) r3(clk,rst_n,write,ram_addr,data,en,ram_addr,r32_expected);
    task compare_roms;
        begin
            if(tile_actual!==tile_expected || text_actual!==text_expected || glyph_actual!==glyph_expected || coeff_actual!==coeff_expected)
                $fatal(1,"ROM model mismatch tile=%0d text=%0d glyph=%0d",a,text_addr,glyph_addr);
        end
    endtask
    initial
    begin
        repeat(4) @(negedge clk);rst_n=1;
        for(i=0;i<3000;i=i+1)
        begin
            @(negedge clk);write=1;ram_addr=i;data=32'h71934a65^(i*32'h1137);
        end
        @(negedge clk);write=0;en=1;
        for(i=0;i<32768;i=i+1)
        begin
            @(negedge clk);a=i;text_addr=i%3072;glyph_addr=i%2048;ram_addr=i%2048;
            @(posedge clk);#1;compare_roms;
            if(r16_actual!==r16_expected || r32_actual!==r32_expected) $fatal(1,"RAM cross-bank mismatch %0d",ram_addr);
        end
        for(i=2048;i<3000;i=i+1)
        begin
            @(negedge clk);ram_addr=i;
            @(posedge clk);#1;if(r16_actual!==r16_expected) $fatal(1,"RAM last bank mismatch");
        end
        @(negedge clk);en=0;
        repeat(9) begin @(posedge clk);#1;compare_roms;end
        @(negedge clk);rst_n=0;#1;
        if(tile_actual || text_actual || glyph_actual || r16_actual || r32_actual) $fatal(1,"ROM/RAM reset output");
        repeat(3) @(negedge clk);rst_n=1;en=1;ram_addr=1777;
        @(posedge clk);#1;
        if(r16_actual!==r16_expected || r32_actual!==r32_expected) $fatal(1,"reset destroyed RAM");
        test_passed=1;$display("LCD_CHORD_MEMORY_PASS tile=32768 text=3072 glyph=2048 FFT_coeff=1024 RAM16=3000 RAM32=2048 CE=9 reset");$finish;
    end
endmodule
