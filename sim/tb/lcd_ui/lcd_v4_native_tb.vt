/**
 * 第四版原生面板扫描自检：正式1192×533光栅、四分频PCLK、800×480有效区。
 * 六份实际RTL指令重放，逐像素核对独立几何/字库参考的RGB666。
 * 检查DE行宽/行数、PCLK周期、复位及HS/VS；存储模型已经原厂全址验证。
 * 帧间复位隔离相位；持续相位/非演奏静态性由v4_scene_tb单独覆盖。
 */
`timescale 1ns/1ps
module lcd_v4_native_tb;
    GSR GSR(.GSRI(1'b1));
    reg clk=0,rst_n=0;
    always #5 clk=~clk;
    reg word_valid=0,word_kind=0,present_valid=0;
    reg [11:0] word_addr=0;
    reg [31:0] word_data=0;
    wire word_ready,present_ready,frame_start,frame_active,error,config_error;
    wire lcd_clk,lcd_en,lcd_bl,lcd_hs_n,lcd_vs_n;
    wire [5:0] lcd_r,lcd_g,lcd_b;
    wire [17:0] rgb={lcd_r,lcd_g,lcd_b};
    reg [44:0] commands[0:1999];
    reg [17:0] expected[0:383999];
    integer i,pixel,fd,line_pixels,line_count,run_index,repeat_index,unpacked_pixels;
    reg [36:0] expected_runs[0:65535];
    reg [4095:0] results_dir;
    integer total_checked=0;
    reg was_de=0,test_passed=0;
    time previous_edge=0,last_fall=0;
    lcd_driver dut(.*,.clk(clk),.rst_n(rst_n),.address_error(error),.configuration_error(config_error));
    always @(negedge lcd_clk) last_fall=$time;
    always @(posedge lcd_clk)
    begin
        if(rst_n && previous_edge!=0 && $time-previous_edge!=40) $fatal(1,"PCLK period");
        if(rst_n && previous_edge!=0 && ($time-last_fall!=20 || !lcd_hs_n || !lcd_vs_n || !lcd_bl || error || config_error)) $fatal(1,"native panel controls");
        previous_edge=rst_n ? $time : 0;
    end
    task capture;
        input integer id,count,run_count;
        begin
            @(negedge clk);
            rst_n=0;
            word_valid=0;
            present_valid=0;
            previous_edge=0;
            repeat(4) @(negedge clk);
            rst_n=1;
            $readmemh($sformatf("../assets/lcd_ui/v4/native_commands_%0d.hex",id),commands,0,count-1);
            $readmemh($sformatf("../assets/lcd_ui/v4/native_pixels_%0d.rle",id),expected_runs,0,run_count-1);
            unpacked_pixels=0;
            for(run_index=0;run_index<run_count;run_index=run_index+1)
            begin
                for(repeat_index=0;repeat_index<expected_runs[run_index][36:18];repeat_index=repeat_index+1)
                begin
                    if(unpacked_pixels>=384000) $fatal(1,"RLE reference overflow");
                    expected[unpacked_pixels]=expected_runs[run_index][17:0];unpacked_pixels=unpacked_pixels+1;
                end
            end
            if(unpacked_pixels!=384000) $fatal(1,"RLE reference incomplete");
            for(i=0;i<count;i=i+1)
            begin
                @(negedge clk);
                word_valid=1;
                word_kind=commands[i][44];
                word_addr=commands[i][43:32];
                word_data=commands[i][31:0];
                @(posedge clk);
                while(!word_ready) @(posedge clk);
            end
            @(negedge clk);
            word_valid=0;
            present_valid=1;
            @(posedge clk);
            while(!present_ready) @(posedge clk);
            @(negedge clk);
            present_valid=0;
            @(posedge frame_start);
            fd=$fopen($sformatf("%0s/native_%0d.hex",results_dir,id),"w");
            pixel=0;
            line_count=0;
            line_pixels=0;
            was_de=0;
            while(pixel<384000)
            begin
                @(posedge lcd_clk);
                if(lcd_en)
                begin
                    if(rgb!==expected[pixel]) $fatal(1,"native RGB id=%0d x=%0d y=%0d got=%h expected=%h",id,pixel%800,pixel/800,rgb,expected[pixel]);
                    $fdisplay(fd,"%05h",rgb);
                    pixel=pixel+1;
                    line_pixels=line_pixels+1;
                end
                if(was_de && !lcd_en)
                begin
                    if(line_pixels!=800) $fatal(1,"DE line width");
                    line_count=line_count+1;
                    line_pixels=0;
                end
                was_de=lcd_en;
            end
            @(posedge lcd_clk);
            if(lcd_en || line_pixels!=800 || line_count!=479) $fatal(1,"DE last line");
            $fclose(fd);
            total_checked=total_checked+pixel;
            $display("V4_NATIVE_FRAME_PASS id=%0d pixels=%0d",id,pixel);
        end
    endtask
    initial
    begin
        if(!$value$plusargs("RESULTS=%s",results_dir)) results_dir="../ai_workspace/sim/lcd_v4/units/results";
        capture(0,1129,13712);
        capture(1,1126,19713);
        capture(44,1129,13712);
        capture(45,1127,13656);
        capture(46,235,3005);
        capture(47,235,3005);
        test_passed=1;
        $display("V4_NATIVE_PASS checked=%0d",total_checked);
        $finish;
    end
    initial
    begin
        #400000000;
        $fatal(1,"native watchdog");
    end
endmodule
