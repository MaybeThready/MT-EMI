/**
 * Spectrum column mapping versus independent bin-range maxima: replication,
 * aggregation, min/max column counts, full Nyquist view, sequence/peak/flags.
 * FFT numerical checks are separate. All cache writes are observed publicly.
 */
`timescale 1ns/1ps
module lcd_spectrum_builder_tb;
    parameter COLUMNS=544;
    parameter QUICK=0;
    parameter SAMPLE_NUM=98245614;
    parameter SAMPLE_DEN=2048;
    parameter VIEW_HZ=4000;
    localparam LAST_BIN=(64'd1024*SAMPLE_DEN*VIEW_HZ)/SAMPLE_NUM;
    GSR GSR (.GSRI(1'b1));
    reg clk_sys=1'b0, rst_n=1'b0, build_enable=1'b1, start_valid=1'b0;
    always #5 clk_sys=~clk_sys;
    reg [31:0] window_seq=32'd0;
    reg signed [15:0] pcm_rd_data=16'sd0;
    wire start_ready, pcm_rd_en, window_release, busy, spectrum_done, spectrum_valid;
    wire [9:0] pcm_rd_addr;
    wire [31:0] spectrum_seq;
    wire [15:0] spectrum_peak;
    wire spectrum_clipped, fft_overflow, column_wr_en, configuration_error;
    wire [10:0] column_wr_addr;
    wire [15:0] column_wr_data;
    reg [15:0] samples [0:17*1024-1];
    reg [47:0] expected [0:17*513-1];
    reg [1:0] flags [0:16];
    reg [15:0] expected_words [0:2*COLUMNS-1];
    integer vector=0, reads=0, releases=0, writes=0, job, i, j, first, last, previous, m, peak, mag;
    reg test_passed=1'b0;
    lcd_spectrum_builder #(.WAVE_COLUMNS(COLUMNS), .SAMPLE_RATE_NUM(SAMPLE_NUM),
        .SAMPLE_RATE_DEN(SAMPLE_DEN), .FREQ_VIEW_MAX_HZ(VIEW_HZ)) lcd_spectrum_builder_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .build_enable(build_enable),
        .start_valid(start_valid), .start_ready(start_ready), .window_seq(window_seq),
        .pcm_rd_en(pcm_rd_en), .pcm_rd_addr(pcm_rd_addr), .pcm_rd_data(pcm_rd_data),
        .window_release(window_release), .busy(busy), .spectrum_done(spectrum_done),
        .spectrum_valid(spectrum_valid), .spectrum_seq(spectrum_seq), .spectrum_peak(spectrum_peak),
        .spectrum_clipped(spectrum_clipped), .fft_overflow(fft_overflow),
        .column_wr_en(column_wr_en), .column_wr_addr(column_wr_addr), .column_wr_data(column_wr_data),
        .configuration_error(configuration_error)
    );
    always @(posedge clk_sys)
    begin
        if (!rst_n)
        begin
            reads=0; releases=0; writes=0;
        end
        else
        begin
            if (start_valid && start_ready)
            begin
                reads=0; releases=0; writes=0;
            end
            if (pcm_rd_en)
            begin
                if (pcm_rd_addr!==reads[9:0] || reads>=1024) $fatal(1,"spectrum input order");
                pcm_rd_data<=samples[vector*1024+pcm_rd_addr];
                reads=reads+1;
            end
            if (window_release)
            begin
                releases=releases+1;
                if (reads!=1024 || releases!=1) $fatal(1,"spectrum window release");
            end
            if (column_wr_en)
            begin
                if (!busy || writes>=2*COLUMNS || column_wr_addr!==writes[10:0] ||
                    column_wr_data!==expected_words[writes])
                    $fatal(1,"spectrum column mapping C=%0d vector=%0d word=%0d got=%0d expected=%0d",COLUMNS,vector,writes,column_wr_data,expected_words[writes]);
                writes=writes+1;
            end
        end
    end
    initial
    begin
        $readmemh("../assets/lcd_ui/fft_input.hex",samples);
        $readmemh("../assets/lcd_ui/fft_expected.hex",expected);
        $readmemh("../assets/lcd_ui/fft_flags.hex",flags);
        repeat (3) @(negedge clk_sys);
        rst_n=1'b1;
        for (job=0; job<(QUICK ? 1 : 4); job=job+1)
        begin
            if (QUICK) vector=13;
            else
            begin
                case (job)
                    0: vector=0;
                    1: vector=11;
                    2: vector=13;
                    default: vector=14;
                endcase
            end
            previous=-1;
            for (j=0; j<COLUMNS; j=j+1)
            begin
                last=((j+1)*(LAST_BIN+1)+COLUMNS-1)/COLUMNS-1;
                first=previous+1;
                if (first>last) first=last;
                m=0;
                for (i=first; i<=last; i=i+1)
                    if (expected[vector*513+i][47:32]>m) m=expected[vector*513+i][47:32];
                expected_words[2*j]=303-((m*207+16384)/32768);
                expected_words[2*j+1]=303;
                previous=last;
            end
            peak=0;
            for (i=0; i<1024; i=i+1)
            begin
                mag=$signed(samples[vector*1024+i]);
                if (mag<0) mag=-mag;
                if (mag>peak) peak=mag;
            end
            @(negedge clk_sys);
            window_seq=window_seq+32'd3;
            start_valid=1'b1;
            if (!start_ready) $fatal(1,"spectrum start readiness");
            @(negedge clk_sys);
            start_valid=1'b0;
            if (spectrum_valid) $fatal(1,"partial spectrum marked valid");
            wait (spectrum_done);
            @(negedge clk_sys);
            if (!spectrum_valid || spectrum_seq!==window_seq || spectrum_peak!==peak[15:0] ||
                releases!=1 || writes!=2*COLUMNS || configuration_error ||
                fft_overflow!==flags[vector][0] || spectrum_clipped!==flags[vector][1])
                $fatal(1,"spectrum metadata/output count");
            build_enable=1'b0; start_valid=1'b1;
            repeat (10) @(negedge clk_sys);
            if (busy || start_ready || !spectrum_valid) $fatal(1,"spectrum rebuilt locked cache");
            start_valid=1'b0; build_enable=1'b1;
        end
        test_passed=1'b1;
        $display("LCD_SPECTRUM_BUILDER_PASS columns=%0d max_bin=%0d jobs=%0d linear_magnitude replication aggregation metadata",COLUMNS,LAST_BIN,(QUICK ? 1 : 4));
        $finish;
    end
    initial
    begin
        #5000000;
        $fatal(1,"spectrum builder watchdog");
    end
endmodule
