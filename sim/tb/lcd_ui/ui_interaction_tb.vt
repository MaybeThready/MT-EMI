`timescale 1ns/1ps
/**
 * LCD接收与调度自检：场景冻结/背压、绘制期间的新事件、长期停顿后的默认提示保留、提示到期重绘及复位/错误。
 */
module ui_interaction_tb;
    GSR GSR (.GSRI(1'b1));
    reg clk_sys=0;
    always #5 clk_sys=~clk_sys;
    reg rst_n=0,display_in_valid=0,out_ready=0,render_done=0;
    reg [527:0] display_in_state=0;
    wire display_in_ready,out_valid,protocol_error,configuration_error;
    wire [527:0] scene_state;
    wire [21:0] highlight_mask,default_mask;
    reg test_passed=0;
    wire invalid_clock, invalid_zero, invalid_large;
    wire invalid_clock_ready, invalid_zero_ready, invalid_large_ready;
    ui_interaction #(.CLK_SYS_HZ(999)) invalid_clock_u (
        .audio_in(16'sd0), .audio_in_valid(1'b0), .audio_in_ready(),
        .scene_wave_valid(), .scene_wave_seq(), .scene_output_peak(), .scene_pcm_valid(),
        .scene_dropped_windows(), .column_rd_en(1'b0), .column_rd_addr(11'd0),
        .column_rd_data(), .dropped_windows(),
        .clk_sys(clk_sys), .rst_n(rst_n), .display_in_state(528'd0),
        .display_in_valid(1'b0), .display_in_ready(invalid_clock_ready),
        .scene_state(), .highlight_mask(), .default_mask(), .out_valid(),
        .out_ready(1'b0), .render_done(1'b0), .protocol_error(),
        .configuration_error(invalid_clock),
        .scene_spectrum_valid(), .scene_spectrum_seq(), .scene_spectrum_clipped(), .scene_fft_overflow()
    );
    ui_interaction #(.HIGHLIGHT_MS(0)) invalid_zero_u (
        .audio_in(16'sd0), .audio_in_valid(1'b0), .audio_in_ready(),
        .scene_wave_valid(), .scene_wave_seq(), .scene_output_peak(), .scene_pcm_valid(),
        .scene_dropped_windows(), .column_rd_en(1'b0), .column_rd_addr(11'd0),
        .column_rd_data(), .dropped_windows(),
        .clk_sys(clk_sys), .rst_n(rst_n), .display_in_state(528'd0),
        .display_in_valid(1'b0), .display_in_ready(invalid_zero_ready),
        .scene_state(), .highlight_mask(), .default_mask(), .out_valid(),
        .out_ready(1'b0), .render_done(1'b0), .protocol_error(),
        .configuration_error(invalid_zero),
        .scene_spectrum_valid(), .scene_spectrum_seq(), .scene_spectrum_clipped(), .scene_fft_overflow()
    );
    ui_interaction #(.HIGHLIGHT_MS(65536)) invalid_large_u (
        .audio_in(16'sd0), .audio_in_valid(1'b0), .audio_in_ready(),
        .scene_wave_valid(), .scene_wave_seq(), .scene_output_peak(), .scene_pcm_valid(),
        .scene_dropped_windows(), .column_rd_en(1'b0), .column_rd_addr(11'd0),
        .column_rd_data(), .dropped_windows(),
        .clk_sys(clk_sys), .rst_n(rst_n), .display_in_state(528'd0),
        .display_in_valid(1'b0), .display_in_ready(invalid_large_ready),
        .scene_state(), .highlight_mask(), .default_mask(), .out_valid(),
        .out_ready(1'b0), .render_done(1'b0), .protocol_error(),
        .configuration_error(invalid_large),
        .scene_spectrum_valid(), .scene_spectrum_seq(), .scene_spectrum_clipped(), .scene_fft_overflow()
    );
    ui_interaction #(.CLK_SYS_HZ(1000),.HIGHLIGHT_MS(3)) ui_interaction_u (
        .audio_in(16'sd0), .audio_in_valid(1'b0), .audio_in_ready(),
        .scene_wave_valid(), .scene_wave_seq(), .scene_output_peak(), .scene_pcm_valid(),
        .scene_dropped_windows(), .column_rd_en(1'b0), .column_rd_addr(11'd0),
        .column_rd_data(), .dropped_windows(),
        .clk_sys(clk_sys),.rst_n(rst_n),.display_in_state(display_in_state),
        .display_in_valid(display_in_valid),.display_in_ready(display_in_ready),
        .scene_state(scene_state),.highlight_mask(highlight_mask),.default_mask(default_mask),
        .out_valid(out_valid),.out_ready(out_ready),.render_done(render_done),
        .protocol_error(protocol_error),.configuration_error(configuration_error),
        .scene_spectrum_valid(), .scene_spectrum_seq(), .scene_spectrum_clipped(), .scene_fft_overflow()
    );
    task offer;
        input [31:0] seq;
        input [21:0] activity,defaults;
        begin
            @(negedge clk_sys); display_in_state=0;
            display_in_state[31:0]=seq;
            display_in_state[477:456]=activity;
            display_in_state[499:478]=defaults;
            display_in_valid=1;
            @(negedge clk_sys); display_in_valid=0;
        end
    endtask
    task complete;
        begin
            @(negedge clk_sys); out_ready=1;
            @(negedge clk_sys); out_ready=0;
            repeat(2) @(negedge clk_sys);
            render_done=1;
            @(negedge clk_sys); render_done=0;
        end
    endtask
    reg [571:0] held;
    initial
    begin
        repeat(3) @(negedge clk_sys); rst_n=1;
        #1;
        if (!invalid_clock || !invalid_zero || !invalid_large ||
            invalid_clock_ready || invalid_zero_ready || invalid_large_ready)
            $fatal(1,"invalid receiver configuration accepted traffic");
        offer(32'hffffffff,22'h1,0);
        wait(out_valid); @(negedge clk_sys);
        held={scene_state,highlight_mask,default_mask};
        offer(0,22'h2,22'h2);
        repeat(20)
        begin
            @(negedge clk_sys);
            if(!display_in_ready || !out_valid || {scene_state,highlight_mask,default_mask}!==held)
                $fatal(1,"render backpressure changed frozen scene or stopped input");
        end
        complete;
        wait(out_valid); @(negedge clk_sys);
        if(scene_state[31:0]!==0 || !highlight_mask[1] || !default_mask[1])
            $fatal(1,"long-stall action expired without ever being shown");
        complete;
        wait(out_valid); @(negedge clk_sys);
        if(highlight_mask!==0 || default_mask!==0) $fatal(1,"expiry did not redraw without highlight");
        complete;
        if(protocol_error || configuration_error) $fatal(1,"unexpected receiver error");
        @(negedge clk_sys); render_done=1;
        @(negedge clk_sys); render_done=0;
        if(!protocol_error) $fatal(1,"stray completion was not detected");
        #1 rst_n=0; #1;
        if(out_valid || display_in_ready) $fatal(1,"reset handoff");
        repeat(3) @(negedge clk_sys); rst_n=1;
        offer(9,0,0);
        wait(out_valid); @(negedge clk_sys);
        if(scene_state[31:0]!==9 || protocol_error) $fatal(1,"reset restart");
        out_ready=1;
        render_done=1;
        @(negedge clk_sys);
        out_ready=0;
        render_done=0;
        if (protocol_error) $fatal(1,"same-edge completion rejected");
        display_in_state[509]=1'b1;
        display_in_valid=1;
        @(negedge clk_sys);
        display_in_valid=0;
        if (!protocol_error) $fatal(1,"nonzero reserved bits accepted silently");
        test_passed=1;
        $display("UI_INTERACTION_PASS frozen latest long_stall_defaults expiry reset errors config reserved same_edge_done");
        $finish;
    end
    initial
    begin
        #100000;
        $fatal(1,"receiver watchdog");
    end
endmodule
