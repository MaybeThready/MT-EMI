/**
 * 接收端压力验证：每拍一份PCM和UI更新，消费者停顿并逐列读缓存。
 * 检查只丢整窗、接收恒ready、冻结元数据、真实SDP数据与窗口编号对应，
 * 连续有新窗时仍能产生渲染任务；全部通过公开端口，不强改内部状态。
 */
`timescale 1ns/1ps
module ui_audio_stress_tb;
    GSR GSR (.GSRI(1'b1));
    reg clk_sys = 1'b0;
    always #5 clk_sys = ~clk_sys;
    reg rst_n = 1'b0;
    reg [31:0] sample_number_r = 32'd0;
    reg out_ready = 1'b0, render_done = 1'b0, column_rd_en = 1'b0;
    reg [10:0] column_rd_addr = 11'd0;
    wire audio_in_ready, display_in_ready, out_valid, scene_wave_valid;
    wire [544:0] scene_state;
    wire [31:0] scene_wave_seq, scene_dropped_windows, dropped_windows;
    wire [15:0] scene_output_peak, column_rd_data;
    wire protocol_error, configuration_error;
    reg test_passed = 1'b0;
    integer wave_scenes = 0, scenes = 0;
    integer i, j, k, first, after_last, minimum, maximum, y, base, magnitude, peak;
    reg [625:0] held_metadata;

    function [15:0] pcm_at;
        input integer index;
        begin
            pcm_at = {index[7:0],index[15:8]} ^ 16'h9183;
        end
    endfunction
    function integer map_y;
        input signed [15:0] sample;
        integer raw;
        begin
            raw = sample;
            map_y = 303 - (((raw+32768)*207+32768)/65536);
        end
    endfunction

    always @(posedge clk_sys or negedge rst_n)
    begin
        if (!rst_n) sample_number_r <= 32'd0;
        else sample_number_r <= sample_number_r + 32'd1;
    end
    always @(posedge clk_sys)
    begin
        if (rst_n && (!audio_in_ready || !display_in_ready || protocol_error || configuration_error))
            $fatal(1, "dense receive stalled or protocol error");
    end

    ui_interaction ui_interaction_u (
        .clk_sys(clk_sys), .rst_n(rst_n), .display_in_state({513'd0,sample_number_r}),
        .display_in_valid(rst_n), .display_in_ready(display_in_ready),
        .audio_in(pcm_at(sample_number_r)), .audio_in_valid(rst_n), .audio_in_ready(audio_in_ready),
        .scene_state(scene_state), .highlight_mask(), .default_mask(),
        .out_valid(out_valid), .out_ready(out_ready), .render_done(render_done),
        .scene_wave_valid(scene_wave_valid), .scene_wave_seq(scene_wave_seq), .scene_output_peak(scene_output_peak),
        .scene_pcm_valid(), .scene_dropped_windows(scene_dropped_windows),
        .column_rd_en(column_rd_en), .column_rd_addr(column_rd_addr), .column_rd_data(column_rd_data),
        .dropped_windows(dropped_windows), .protocol_error(protocol_error), .configuration_error(configuration_error),
        .scene_spectrum_valid(), .scene_spectrum_seq(), .scene_spectrum_clipped(), .scene_fft_overflow()
    );
    wire [625:0] metadata = {scene_state,scene_wave_valid,scene_wave_seq,scene_output_peak,scene_dropped_windows};

    initial
    begin
        repeat (3) @(negedge clk_sys);
        rst_n = 1'b1;
        while (wave_scenes < 3)
        begin
            wait (out_valid);
            @(negedge clk_sys);
            held_metadata = metadata;
            repeat (13)
            begin
                @(negedge clk_sys);
                if (!out_valid || metadata !== held_metadata) $fatal(1, "out_valid backpressure unstable");
            end
            out_ready = 1'b1;
            @(negedge clk_sys);
            out_ready = 1'b0;
            scenes = scenes + 1;
            if (scene_wave_valid)
            begin
                wave_scenes = wave_scenes + 1;
                base = scene_wave_seq * 1024;
                peak = 0;
                for (i = base; i < base+1024; i = i+1)
                begin
                    magnitude = $signed(pcm_at(i));
                    if (magnitude < 0) magnitude = -magnitude;
                    if (magnitude > peak) peak = magnitude;
                end
                if (scene_output_peak !== peak[15:0]) $fatal(1, "dense peak/seq mismatch");
                first = 0;
                for (j = 0; j < 544; j = j+1)
                begin
                    after_last = ((j+1)*1024+543)/544;
                    minimum = 479;
                    maximum = 0;
                    for (k = (first == 0 ? 0 : first-1); k < after_last; k = k+1)
                    begin
                        y = map_y(pcm_at(base+k));
                        if (y < minimum) minimum = y;
                        if (y > maximum) maximum = y;
                    end
                    @(negedge clk_sys);
                    column_rd_en = 1'b1;
                    column_rd_addr = 2*j;
                    @(posedge clk_sys);
                    #1;
                    if (column_rd_data !== minimum[15:0]) $fatal(1, "dense column minimum");
                    @(negedge clk_sys);
                    column_rd_addr = 2*j+1;
                    @(posedge clk_sys);
                    #1;
                    if (column_rd_data !== maximum[15:0]) $fatal(1, "dense column maximum");
                    if (metadata !== held_metadata) $fatal(1, "dense scene changed while reading");
                    first = after_last;
                end
            end
            @(negedge clk_sys);
            column_rd_en = 1'b0;
            render_done = 1'b1;
            @(negedge clk_sys);
            render_done = 1'b0;
        end
        if (dropped_windows == 32'd0) $fatal(1, "dense whole-window drop not exercised");
        test_passed = 1'b1;
        $display("UI_AUDIO_STRESS_PASS one_sample_per_cycle scenes=%0d wave_scenes=%0d drops=%0d",scenes,wave_scenes,dropped_windows);
        $finish;
    end

    initial
    begin
        #1000000;
        $fatal(1, "audio/UI scene starvation");
    end
endmodule
