/**
 * 2026-11-02 增加同页号主/子菜单身份、和弦候选、取消跳转及保存位共存。
 * 场景提交与动画自检：存储体/config所有权、后台清空、六帧自主移动、中途重定向、非法字及复位。
 * 不强制被测模块内部状态。
 */
`timescale 1ns/1ps
module lcd_scene_motion_tb;
    GSR GSR(.GSRI(1'b1));
    reg clk=1'b0,rst_n=1'b0;
    always #5 clk=~clk;
    reg valid=1'b0,kind=1'b0,present=1'b0,boundary=1'b0;
    reg [11:0] addr=12'd0;
    reg [31:0] data=32'd0;
    wire ready,present_ready,active,error;
    wire [3:0] pixel;
    reg test_passed=1'b0;
    integer i;
    integer positions[0:5];
    lcd_scene lcd_scene_u(.clk(clk),.rst_n(rst_n),.word_valid(valid),.word_ready(ready),
        .word_kind(kind),.word_addr(addr),.word_data(data),.present_valid(present),.present_ready(present_ready),
        .frame_boundary(boundary),.frame_active(active),.address_error(error),
        .scan_active(1'b0),.scan_x(10'd0),.scan_y(9'd0),.pixel_index(pixel));
    task frame;
        begin @(negedge clk);boundary=1'b1;@(negedge clk);boundary=1'b0;end
    endtask
    task word;
        input [11:0] a;input [31:0] d;
        begin
            wait(ready);@(negedge clk);addr=a;data=d;valid=1'b1;
            @(negedge clk);valid=1'b0;
        end
    endtask
    task commit;
        input [2:0] page;input [1:0] selection;
        begin
            word(12'd4095,{26'd0,selection,1'b0,page});
            @(negedge clk);present=1'b1;
            #1;if(ready) $fatal(1,"writes allowed while present pending");
            frame();@(negedge clk);present=1'b0;
        end
    endtask
    initial
    begin
        positions[0]=161;positions[1]=173;positions[2]=188;positions[3]=203;positions[4]=215;positions[5]=220;
        repeat(4) @(negedge clk);rst_n=1'b1;
        commit(3'd1,2'd0);
        if(!active || lcd_scene_u.selection_y_r!=156) $fatal(1,"initial selection");
        commit(3'd1,2'd1);
        if(lcd_scene_u.selection_y_r!=156) $fatal(1,"selection jumped before animation");
        for(i=0;i<6;i=i+1)
        begin
            repeat(9) @(negedge clk);
            if(lcd_scene_u.selection_y_r!=(i==0 ? 156 : positions[i-1])) $fatal(1,"selection changed mid-frame");
            frame();if(lcd_scene_u.selection_y_r!=positions[i]) $fatal(1,"ease frame %0d y=%0d",i,lcd_scene_u.selection_y_r);
        end
        // Change direction after two steps: retain current display y, not old row.
        commit(3'd1,2'd2);frame();frame();
        if(lcd_scene_u.selection_y_r!=237) $fatal(1,"forward phase before reverse");
        commit(3'd1,2'd0);
        if(lcd_scene_u.selection_y_r!=237) $fatal(1,"retarget jumped");
        repeat(6) frame();if(lcd_scene_u.selection_y_r!=156) $fatal(1,"retarget endpoint");
        commit(3'd3,2'd0);commit(3'd1,2'd3);
        if(lcd_scene_u.selection_y_r!=348) $fatal(1,"new page should enter without slide");
        // Same page number, different identity: no slide from main row4 to submenu.
        word(12'd4095,32'h01000001);
        @(negedge clk);present=1'b1;frame();@(negedge clk);present=1'b0;
        if(lcd_scene_u.selection_y_r!=156 || lcd_scene_u.motion_phase_r!=6) $fatal(1,"submenu identity did not reset selection");
        word(12'd4095,32'h01800011); // Preserve bit23 save while selecting chord.
        @(negedge clk);present=1'b1;frame();@(negedge clk);present=1'b0;
        repeat(6) frame();
        if(lcd_scene_u.selection_y_r!=220) $fatal(1,"chord candidate row mismatch");
        commit(3'd1,2'd3);
        if(lcd_scene_u.selection_y_r!=348 || lcd_scene_u.motion_phase_r!=6) $fatal(1,"cancel to main retained submenu animation");
        wait(ready);
        if((lcd_scene_u.front_bank_r ? lcd_scene_u.config_r[1][5:4] : lcd_scene_u.config_r[0][5:4])!=3) $fatal(1,"back clear destroyed front config");
        word(12'd3001,32'd0);if(!error) $fatal(1,"invalid tile address accepted");
        @(negedge clk);rst_n=1'b0;#1;if(active || ready || present_ready) $fatal(1,"scene reset");
        repeat(4) @(negedge clk);rst_n=1'b1;wait(ready);if(error) $fatal(1,"sticky error not reset");
        test_passed=1'b1;$display("LCD_SCENE_MOTION_PASS bank_clear config six_frames safe_boundary retarget chord_identity candidate cancel save_context invalid reset");$finish;
    end
    initial begin #1000000;$fatal(1,"motion watchdog");end
endmodule
