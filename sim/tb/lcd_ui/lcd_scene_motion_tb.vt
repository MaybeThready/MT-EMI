/**
 * 第四版场景自检：帧边界原子交换、颜色相位、非演奏页静态、选中条直接定位。
 * 检查峰值列协议、图形两端及轮廓裁剪，非法字拒绝和复位清屏。
 * clk/rst_n同步场景协议，坐标为无符号整数；不加入综合工程。
 */
`timescale 1ns/1ps
module lcd_scene_motion_tb;
    GSR GSR(.GSRI(1'b1));
    reg clk=0,rst_n=0;
    always #5 clk=~clk;
    reg word_valid=0,word_kind=0,present_valid=0,frame_boundary=0,scan_active=1;
    reg [11:0] word_addr=0;
    reg [31:0] word_data=0;
    reg [9:0] scan_x=0;
    reg [8:0] scan_y=0;
    wire word_ready,present_ready,frame_active,address_error;
    wire [3:0] pixel_index,pixel_phase;
    wire [17:0] pixel_rgb;
    reg test_passed=0;
    integer i,page;
    reg [17:0] first_color;
    lcd_scene dut(.*);
    lcd_palette palette_u(.pixel_index(pixel_index),.phase(pixel_phase),.pixel_rgb(pixel_rgb));
    task send;
        input kind;
        input [11:0] addr;
        input [31:0] data;
        begin
            @(negedge clk);
            word_valid=1;
            word_kind=kind;
            word_addr=addr;
            word_data=data;
            @(posedge clk);
            while(!word_ready) @(posedge clk);
            @(negedge clk);
            word_valid=0;
        end
    endtask
    task boundary;
        begin
            @(negedge clk);
            frame_boundary=1;
            @(negedge clk);
            frame_boundary=0;
        end
    endtask
    task commit;
        begin
            @(negedge clk);
            present_valid=1;
            repeat(7) @(negedge clk);
            boundary;
            @(negedge clk);
            present_valid=0;
            wait(word_ready);
            repeat(8) @(negedge clk);
        end
    endtask
    task probe;
        input [9:0] x;
        input [8:0] y;
        input [3:0] color;
        begin
            @(negedge clk);
            scan_x=x;
            scan_y=y;
            repeat(7) @(negedge clk);
            if(pixel_index!==color) $fatal(1,"scene probe x=%0d y=%0d got=%0d expected=%0d",x,y,pixel_index,color);
        end
    endtask
    initial
    begin
        repeat(4) @(negedge clk);
        rst_n=1;
        wait(word_ready);
        send(0,4095,0);
        send(1,40,{9'd511,1'b1,4'd12,9'd90,9'd88});
        send(1,615,{9'd511,1'b1,4'd12,9'd327,9'd325});
        if(frame_active) $fatal(1,"uncommitted page visible");
        commit;
        probe(40,88,12);
        probe(40,92,4);
        probe(40,93,10);
        probe(615,327,3);
        probe(615,323,4);
        probe(615,322,10);
        probe(19,24,12);
        first_color=pixel_rgb;
        repeat(32) boundary;
        repeat(8) @(negedge clk);
        if(pixel_phase==0 || pixel_rgb===first_color) $fatal(1,"perform palette failed to move");
        for(page=1;page<8;page=page+1)
        begin
            send(0,4095,page);
            commit;
            probe(19,24,12);
            first_color=pixel_rgb;
            repeat(32) boundary;
            repeat(8) @(negedge clk);
            if(pixel_phase!==0 || pixel_rgb!==first_color) $fatal(1,"nonperform page animated %0d",page);
        end
        send(0,4095,32'h01000011);
        commit;
        if(dut.selection_y_r!=220) $fatal(1,"submenu selection did not jump directly");
        repeat(9) boundary;
        if(dut.selection_y_r!=220) $fatal(1,"menu continued moving");
        send(1,800,32'h00400000);
        if(!address_error) $fatal(1,"invalid word was accepted silently");
        @(negedge clk);
        rst_n=0;
        #1;
        if(frame_active || address_error || pixel_index) $fatal(1,"scene reset");
        test_passed=1;
        $display("V4_SCENE_PASS phase static_pages=7 direct_menu halo_edges invalid reset");
        $finish;
    end
    initial
    begin
        #2000000;
        $fatal(1,"scene watchdog");
    end
endmodule
