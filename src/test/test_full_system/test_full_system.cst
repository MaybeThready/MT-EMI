// test_full_system：键盘保留旧 J23 奇数脚，旋钮改接 J23.2/4/6。
// P16 是板载 50 MHz 输入，非专用 GCLK；以实际布局布线报告核对路由。
IO_LOC "clk_core" P16;
IO_PORT "clk_core" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
// 与旧测试保持一致：K16 为低有效复位。
IO_LOC "rst_n" K16;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
// 六只板载 LED，低电平点亮。
IO_LOC "status_led[0]" J14;
IO_LOC "status_led[1]" R26;
IO_PORT "status_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "status_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[2]" L20;
IO_PORT "status_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[3]" M25;
IO_PORT "status_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[4]" N21;
IO_PORT "status_led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[5]" N23;
IO_PORT "status_led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;




// Core 4072 Rev1.10 page 7: U7 (QSPI_NAND area, device label 128Mbit NOR).
// U4 / H13 / P18 / R14 / R15 is FPGA boot Flash; DO NOT copy AE350 pins here.
IO_LOC "flash_cs_n" L25;
IO_LOC "flash_clk" P20;
IO_LOC "flash_mosi" R21;
IO_LOC "flash_miso" T22;
IO_LOC "flash_wp_n" R22;
IO_LOC "flash_hold_n" R20;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "flash_wp_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_hold_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// 外接 B1～B4，高电平按下；J23.8/9/10/14 均未被本测试其他端口占用。
IO_LOC "ui_button[0]" U17;
IO_LOC "ui_button[1]" P23;
IO_LOC "ui_button[2]" P24;
IO_LOC "ui_button[3]" R23;
IO_PORT "ui_button[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "ui_button[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "ui_button[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_PORT "ui_button[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

