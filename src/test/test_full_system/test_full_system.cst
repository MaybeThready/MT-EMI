GROUP pll_init_bottom = {"sys_clocker_u/gowin_pll_u/u_pll_init/waitcnt_*" "sys_clocker_u/gowin_pll_u/u_pll_init/locksig_*" "sys_clocker_u/gowin_pll_u/u_pll_init/enable_r_*" "sys_clocker_u/gowin_pll_u/u_pll_init/RomDreg_*" "sys_clocker_u/gowin_pll_u/u_pll_init/RomAddr_*" "sys_clocker_u/gowin_pll_u/u_pll_init/state_*" "sys_clocker_u/gowin_pll_u/u_pll_init/laststep_*" "sys_clocker_u/gowin_pll_u/u_pll_init/Waitlock_*"};
GRP_LOC pll_init_bottom R[85:95]C[150:165];

