IO_LOC "sd_mode_n" A17;
IO_PORT "sd_mode_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_dout" B19;
